</style>

<script>
  // ======================================
  //      GENERADOR DE MENSAJES
  // ======================================

  function initContactPage(): void {
    const page =
      document.querySelector<HTMLElement>(
        "#contact-page"
      );

    if (
      !page ||
      page.dataset.initialized === "true"
    ) {
      return;
    }

    page.dataset.initialized = "true";

    // ======================================
    //       FOTOGRAFÍA CON FALLBACK
    // ======================================

    const portrait =
      page.querySelector<HTMLImageElement>(
        "#contact-portrait"
      );

    const portraitCard =
      page.querySelector<HTMLElement>(
        "#contact-portrait-card"
      );

    if (portrait && portraitCard) {
      const showPhoto = () => {
        if (portrait.naturalWidth > 0) {
          portraitCard.classList.add("is-loaded");
        }
      };

      portrait.addEventListener("load", showPhoto);

      if (portrait.complete) {
        showPhoto();
      }
    }

    // ======================================
    //         FORMULARIO
    // ======================================

    const form =
      page.querySelector<HTMLFormElement>(
        "#contact-form"
      );

    const preview =
      page.querySelector<HTMLElement>(
        "#message-preview"
      );

    const copyButton =
      page.querySelector<HTMLButtonElement>(
        "#copy-message"
      );

    const copyLabel =
      page.querySelector<HTMLElement>(
        "#copy-button-label"
      );

    function createMessage(): string {
      if (!form) {
        return "";
      }

      const data = new FormData(form);

      const name =
        String(data.get("name") ?? "").trim();

      const topic =
        String(
          data.get("topic") ??
          "Consulta general"
        );

      const details =
        String(
          data.get("details") ?? ""
        ).trim();

      const deadline =
        String(
          data.get("deadline") ??
          "Sin plazo definido"
        );

      return [
        `Hola Marco, soy ${name || "[tu nombre]"}.`,
        "",
        `Te contacto por: ${topic}.`,
        "",
        "Mi idea/consulta:",
        details || "[Cuéntame qué necesitas].",
        "",
        `Plazo aproximado: ${deadline}.`,
        "",
        "He llegado desde tu portfolio.",
      ].join("\n");
    }

    function updatePreview(): void {
      if (!preview) {
        return;
      }

      preview.textContent = createMessage();
    }

    if (form) {
      form.addEventListener(
        "input",
        updatePreview
      );

      form.addEventListener(
        "change",
        updatePreview
      );

      form.addEventListener(
        "submit",
        (event) => {
          event.preventDefault();

          if (!form.reportValidity()) {
            return;
          }

          const message = createMessage();

          const url =
            "https://wa.me/34622541527?text=" +
            encodeURIComponent(message);

          window.open(
            url,
            "_blank",
            "noopener,noreferrer"
          );
        }
      );

      updatePreview();
    }

    // ======================================
    //          COPIAR MENSAJE
    // ======================================

    if (copyButton && copyLabel) {
      const button = copyButton;
      const label = copyLabel;

      button.addEventListener(
        "click",
        async () => {
          const message = createMessage();

          try {
            await navigator.clipboard.writeText(
              message
            );

            label.textContent = "¡Mensaje copiado! ✓";

            window.setTimeout(() => {
              label.textContent = "Copiar mensaje";
            }, 2200);
          } catch {
            label.textContent =
              "Selecciona el texto para copiarlo";

            if (preview) {
              const selection = window.getSelection();

              const range =
                document.createRange();

              range.selectNodeContents(preview);

              selection?.removeAllRanges();
              selection?.addRange(range);
            }
          }
        }
      );
    }

    // ======================================
    //       ANIMACIONES AL HACER SCROLL
    // ======================================

    const elements =
      page.querySelectorAll<HTMLElement>(
        "[data-reveal]"
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (
      !reducedMotion &&
      "IntersectionObserver" in window
    ) {
      page.classList.add("effects-enabled");

      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add(
                "is-visible"
              );

              currentObserver.unobserve(
                entry.target
              );
            }
          });
        },
        {
          threshold: 0.04,
          rootMargin: "0px 0px 50px 0px",
        }
      );

      elements.forEach((element) => {
        observer.observe(element);
      });
    } else {
      elements.forEach((element) => {
        element.classList.add(
          "is-visible"
        );
      });
    }

    // ======================================
    //       BARRA DE PROGRESO
    // ======================================

    const progress =
      page.querySelector<HTMLElement>(
        "#contact-progress"
      );

    function updateProgress(): void {
      if (!progress) {
        return;
      }

      const maximum =
        document.documentElement.scrollHeight -
        window.innerHeight;

      const percentage =
        maximum > 0
          ? Math.max(
              0,
              Math.min(
                100,
                (window.scrollY / maximum) * 100
              )
            )
          : 0;

      progress.style.width =
        `${percentage}%`;
    }

    window.addEventListener(
      "scroll",
      updateProgress,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      updateProgress
    );

    updateProgress();
  }

  document.addEventListener(
    "DOMContentLoaded",
    initContactPage
  );

  document.addEventListener(
    "astro:page-load",
    initContactPage
  );

  initContactPage();
</script>
