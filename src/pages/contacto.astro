                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </div>
          </div>

          <div class="location-visual-bottom">
            <span>MI CIUDAD</span>

            <h3>
              Sanlúcar de Barrameda<span>.</span>
            </h3>

            <p>Cádiz · Andalucía · España</p>
          </div>

          <div class="location-grid" aria-hidden="true"></div>

        </div>

      </div>
    </section>

    <!-- ====================================== -->
    <!--           PREGUNTAS FRECUENTES        -->
    <!-- ====================================== -->

    <section
      class="faq-section"
      aria-labelledby="faq-title"
    >
      <div class="container faq-layout">

        <div class="faq-heading" data-reveal>
          <div class="section-label">
            <span></span>
            05 / PREGUNTAS FRECUENTES
          </div>

          <h2 id="faq-title">
            Algunas dudas
            <span>antes de escribir.</span>
          </h2>

          <p>
            Aquí tienes respuestas a algunas
