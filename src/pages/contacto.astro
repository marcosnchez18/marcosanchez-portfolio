
---
import MainLayout from "../layouts/MainLayout.astro";
import Chatbot from "../components/Chatbot.astro";

const whatsappNumber = "34622541527";

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=` +
  encodeURIComponent(
    "Hola Marco, he visitado tu portfolio y me gustaría contactar contigo."
  );

const linkedinUrl =
  "https://www.linkedin.com/in/marcosanchezES";

const githubUrl =
  "https://github.com/marcosnchez18";

const instagramUrl =
  "https://www.instagram.com/marcosnchez18/";

const tiktokUrl =
  "https://www.tiktok.com/@marcosnchez18";

const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Sanl%C3%BAcar%20de%20Barrameda%2C%20C%C3%A1diz";

const topics = [
  {
    id: "web",
    value: "Desarrollo de una página web",
    number: "01",
    title: "Necesito una web",
    description:
      "Landing page, portfolio, web corporativa, tienda online o aplicación a medida.",
    symbol: "</>",
  },
  {
    id: "job",
    value: "Oferta de empleo",
    number: "02",
    title: "Oportunidad laboral",
    description:
      "Una oportunidad profesional relacionada con el desarrollo o la tecnología.",
    symbol: "CV",
  },
  {
    id: "collaboration",
    value: "Colaboración profesional",
    number: "03",
    title: "Colaboración",
    description:
      "Un proyecto conjunto, una idea o una propuesta para colaborar.",
    symbol: "↗",
  },
  {
    id: "art",
    value: "Encargo artístico",
    number: "04",
    title: "Encargo artístico",
    description:
      "Una consulta sobre pinturas al óleo, retratos u obras personalizadas.",
    symbol: "✦",
  },
  {
    id: "other",
    value: "Otra consulta",
    number: "05",
    title: "Otra consulta",
    description:
      "Cualquier otra cuestión de la que te gustaría hablar conmigo.",
    symbol: "...",
  },
];

const contactSteps = [
  {
    number: "01",
    title: "Cuéntame tu idea",
    description:
      "Explícame qué necesitas y qué te gustaría conseguir. No hace falta que tengas todos los detalles resueltos.",
  },
  {
    number: "02",
    title: "Analizamos la propuesta",
    description:
      "Revisamos el alcance, las necesidades y las alternativas para encontrar un planteamiento adecuado.",
  },
  {
    number: "03",
    title: "Definimos el siguiente paso",
    description:
      "Si podemos seguir adelante, acordamos cómo plantear la colaboración, los objetivos y las condiciones.",
  },
];

const questions = [
  {
    question: "¿Realizas páginas web para clientes?",
    answer:
      "Sí. Puedes contactarme para consultar proyectos como páginas corporativas, landing pages, portfolios, blogs, tiendas online o aplicaciones web personalizadas. Cada propuesta se estudia individualmente.",
  },
  {
    question: "¿Puedo contratarte si no vivo en Cádiz?",
    answer:
      "Por supuesto. Podemos hablar y coordinar proyectos a distancia. Mi ubicación está en Sanlúcar de Barrameda, pero no es necesario estar en la misma ciudad para colaborar.",
  },
  {
    question: "¿Tienes una lista de precios?",
    answer:
      "No utilizo una tarifa única para todos los proyectos. Un sitio web sencillo y una aplicación con funcionalidades personalizadas tienen necesidades muy diferentes. Por eso prefiero estudiar cada caso y preparar un presupuesto a medida.",
  },
  {
    question: "¿Puedo escribirte para una oferta de trabajo?",
    answer:
      "Sí. Puedes contactar conmigo para propuestas laborales relacionadas con el desarrollo web, frontend, backend o entornos tecnológicos. También puedes descargar mi currículum desde el menú superior.",
  },
  {
    question: "¿Aceptas encargos de pintura al óleo?",
    answer:
      "Puedes consultar la posibilidad de encargar una obra personalizada. Para valorar el trabajo necesitaré conocer la imagen de referencia, las dimensiones y los detalles de la idea. Es conveniente contactar con varios meses de antelación.",
  },
];
---

<MainLayout
  title="Contacto | Marco Sánchez"
  description="Contacta con Marco Sánchez para proyectos de desarrollo web, oportunidades profesionales, colaboraciones y encargos personalizados. Solicita información directamente por WhatsApp."
>
  <div class="contact-page" id="contact-page">

    <div
      class="reading-progress"
      id="contact-progress"
      aria-hidden="true"
    ></div>

    <!-- ====================================== -->
    <!--              HERO CONTACTO           -->
    <!-- ====================================== -->

    <section class="contact-hero" aria-labelledby="contact-title">

      <div class="hero-grid-pattern" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="container hero-layout">

        <div class="hero-content">

          <div class="hero-badge">
            <span class="badge-dot"></span>
            EL SIGUIENTE PASO EMPIEZA AQUÍ
          </div>

          <p class="hero-eyebrow">
            CONTACTO / MARCO SÁNCHEZ
          </p>

          <h1 id="contact-title">
            Las buenas ideas
            <span>empiezan con una</span>
            <em>conversación.</em>
          </h1>

          <p class="hero-lead">
            ¿Tienes un proyecto en mente, una propuesta
            profesional o simplemente quieres hablar conmigo?
          </p>

          <p class="hero-description">
            Me gusta conocer nuevas ideas, escuchar distintos
            puntos de vista y descubrir oportunidades
            para crear algo interesante.
          </p>

          <p class="hero-description">
            Cuéntame qué necesitas. A veces una buena
            conversación es el comienzo de algo mucho mayor.
          </p>

          <div class="hero-tags">
            <span class="featured-tag">
              <span></span>
              Consultas por WhatsApp
            </span>

            <span>Desarrollo web</span>
            <span>Colaboraciones</span>
            <span>Oportunidades laborales</span>
          </div>

          <div class="hero-buttons">

            <a href="#escribeme" class="button button-primary">
              Cuéntame tu idea
              <span aria-hidden="true">↘</span>
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="button button-secondary"
            >
              WhatsApp directo
              <span aria-hidden="true">↗</span>
            </a>

          </div>

          <div class="hero-signature">
            <span class="signature-line"></span>
            <span>
              MARCO SÁNCHEZ — SANLÚCAR DE BARRAMEDA
            </span>
          </div>

        </div>

        <!-- ================================== -->
        <!--      ESPACIO PARA TU FOTOGRAFÍA    -->
        <!-- ================================== -->

        <div class="hero-visual">

          <div
            class="portrait-card"
            id="contact-portrait-card"
          >

            <div class="portrait-topline">
              <span>PROFILE / 001</span>
              <span>MARCO SÁNCHEZ</span>
            </div>

            <!--
              TU FOTOGRAFÍA

              Guarda la imagen aquí:
              public/images/contacto.jpg

              Si todavía no la has añadido,
              aparecerá el diseño de reserva.
            -->

            <div
              class="portrait-placeholder"
              aria-hidden="true"
            >
              <div class="portrait-circle circle-one"></div>
              <div class="portrait-circle circle-two"></div>

              <div class="portrait-placeholder-center">
                <span class="portrait-monogram">
                  MS<span>.</span>
                </span>

                <span class="portrait-placeholder-label">
                  PERSONAL PORTFOLIO
                </span>
              </div>
            </div>

            <img
              id="contact-portrait"
              class="portrait-image"
              src="/images/contacto.png"
              alt="Fotografía de Marco Sánchez"
              loading="eager"
              decoding="async"
            />
            

            <div
              class="portrait-overlay"
              aria-hidden="true"
            ></div>

            <div class="portrait-bottom">
              <div>
                <span>DETRÁS DEL CÓDIGO</span>
                <strong>Una persona. Muchas ideas.</strong>
              </div>

              <span class="portrait-bottom-icon" aria-hidden="true">
                ↗
              </span>
            </div>

          </div>

          <div class="floating-contact-card">
            <span class="floating-symbol" aria-hidden="true">
              {"</>"}
            </span>

            <div>
              <strong>Marco Sánchez</strong>
              <small>Desarrollo web · Creatividad</small>
            </div>
          </div>

          <div class="visual-caption">
            <span></span>
            <p>MS / LET'S CONNECT</p>
          </div>

        </div>

      </div>

    </section>

    <!-- ====================================== -->
    <!--        FORMAS DE CONTACTAR           -->
    <!-- ====================================== -->

    <section
      class="channels-section"
      aria-labelledby="channels-title"
    >
      <div class="container">

        <div class="section-label" data-reveal>
          <span></span>
          01 / CONECTEMOS
        </div>

        <div class="section-heading" data-reveal>
          <h2 id="channels-title">
            Hay muchas formas
            <span>de empezar a hablar.</span>
          </h2>

          <p>
            Prefiero el contacto directo para
            conocer bien cada propuesta.
            Elige el canal que te resulte más cómodo.
          </p>
        </div>

        <div class="channels-grid">

          <!-- WHATSAPP -->

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card channel-main"
            data-reveal
          >
            <div class="channel-card-top">
              <span>01 / MENSAJERÍA DIRECTA</span>

              <span class="channel-arrow" aria-hidden="true">
                ↗
              </span>
            </div>

            <div class="channel-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3H13a8.48 8.48 0 0 1 8 8v.5Z" />
                <path d="M8.5 9.5c1 3 3 5 6 6" />
              </svg>
            </div>

            <div class="channel-card-copy">
              <span class="channel-kicker">
                MI CANAL PRINCIPAL
              </span>

              <h3>WhatsApp<span>.</span></h3>

              <p>
                La opción más directa para presentarte,
                explicarme tu idea y empezar una conversación.
              </p>

              <strong class="channel-detail">
                +34 622 541 527
              </strong>
            </div>
          </a>

          <!-- LINKEDIN -->

          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card"
            data-reveal
          >
            <div class="channel-card-top">
              <span>02 / NETWORKING</span>

              <span class="channel-arrow" aria-hidden="true">
                ↗
              </span>
            </div>

            <div class="channel-icon">
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
              </svg>
            </div>

            <div class="channel-card-copy">
              <span class="channel-kicker">
                PERFIL PROFESIONAL
              </span>

              <h3>LinkedIn<span>.</span></h3>

              <p>
                Ideal para ofertas laborales,
                contactos profesionales y
                nuevas oportunidades de colaboración.
              </p>

              <strong class="channel-detail">
                Conectar conmigo ↗
              </strong>
            </div>
          </a>

          <!-- GITHUB -->

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card"
            data-reveal
          >
            <div class="channel-card-top">
              <span>03 / DESARROLLO</span>

              <span class="channel-arrow" aria-hidden="true">
                ↗
              </span>
            </div>

            <div class="channel-icon">
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 .297a12 12 0 0 0-3.793 23.386c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.082-.729.082-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.52 11.52 0 0 1 6.008 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297" />
              </svg>
            </div>

            <div class="channel-card-copy">
              <span class="channel-kicker">
                CÓDIGO Y PROYECTOS
              </span>

              <h3>GitHub<span>.</span></h3>

              <p>
                Explora mis repositorios,
                proyectos y parte de mi recorrido
                como desarrollador web.
              </p>

              <strong class="channel-detail">
                Explorar repositorios ↗
              </strong>
            </div>
          </a>

        </div>

        <div class="more-socials" data-reveal>
          <span>TAMBIÉN PUEDES ENCONTRARME EN</span>

          <div class="social-links">
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram <span aria-hidden="true">↗</span>
            </a>

            <a
              href={tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              TikTok <span aria-hidden="true">↗</span>
            </a>

            <a href="/arte">
              Mi faceta artística
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ====================================== -->
    <!--        GENERADOR DE MENSAJES          -->
    <!-- ====================================== -->

    <section
      class="brief-section"
      id="escribeme"
      aria-labelledby="brief-title"
    >
      <div class="container">

        <div class="section-label" data-reveal>
          <span></span>
          02 / CUÉNTAME TU IDEA
        </div>

        <div class="section-heading" data-reveal>
          <h2 id="brief-title">
            Tu idea merece
            <span>una buena conversación.</span>
          </h2>

          <p>
            He preparado este pequeño asistente
            para que puedas contarme qué necesitas
            de forma sencilla y organizada.
          </p>
        </div>

        <div class="brief-layout">

          <!-- FORMULARIO -->

          <div class="brief-form-card" data-reveal>

            <div class="brief-card-header">
              <div>
                <span>CONTACT REQUEST</span>
                <strong>Nuevo mensaje</strong>
              </div>

              <div class="brief-header-symbol" aria-hidden="true">
                {"</>"}
              </div>
            </div>

            <form id="contact-form" class="brief-form">

              <!-- TIPO DE CONSULTA -->

              <fieldset class="topic-fieldset">
                <legend>
                  <span class="form-step">01</span>
                  ¿De qué quieres hablar?
                </legend>

                <p class="field-description">
                  Selecciona la opción que mejor
                  describa tu consulta.
                </p>

                <div class="topic-grid">
                  {topics.map((topic, index) => (
                    <label class="topic-option">
                      <input
                        type="radio"
                        name="topic"
                        value={topic.value}
                        checked={index === 0}
                      />

                      <span class="topic-option-body">
                        <span class="topic-option-top">
                          <span>{topic.number} / 05</span>
                          <span class="topic-symbol">
                            {topic.symbol}
                          </span>
                        </span>

                        <strong>{topic.title}</strong>
                        <small>{topic.description}</small>

                        <span
                          class="topic-check"
                          aria-hidden="true"
                        >
                          ✓
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- DATOS BÁSICOS -->

              <div class="form-section">
                <div class="form-section-heading">
                  <span class="form-step">02</span>
                  <h3>¿Cómo te llamas?</h3>
                </div>

                <label class="field-label" for="contact-name">
                  TU NOMBRE
                </label>

                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  maxlength="80"
                  placeholder="Escribe tu nombre..."
                  required
                />
              </div>

              <!-- MENSAJE -->

              <div class="form-section">
                <div class="form-section-heading">
                  <span class="form-step">03</span>
                  <h3>Cuéntame un poco más</h3>
                </div>

                <label class="field-label" for="contact-details">
                  TU IDEA O PROPUESTA
                </label>

                <textarea
                  id="contact-details"
                  name="details"
                  rows="5"
                  maxlength="1800"
                  placeholder="Por ejemplo: Me gustaría crear una web para mi negocio, con información de mis servicios y una forma de contactar con mis clientes..."
                  required
                ></textarea>

                <p class="input-helper">
                  No hace falta utilizar términos técnicos.
                  Cuéntamelo con tus palabras.
                </p>
              </div>

              <!-- PLAZO -->

              <div class="form-section last-form-section">
                <div class="form-section-heading">
                  <span class="form-step">04</span>
                  <h3>¿Tienes algún plazo en mente?</h3>
                </div>

                <label class="field-label" for="contact-deadline">
                  PLAZO APROXIMADO
                </label>

                <select
                  id="contact-deadline"
                  name="deadline"
                >
                  <option value="Sin plazo definido">
                    Sin plazo definido
                  </option>

                  <option value="Lo antes posible">
                    Lo antes posible
                  </option>

                  <option value="Durante el próximo mes">
                    Durante el próximo mes
                  </option>

                  <option value="En los próximos 2-3 meses">
                    En los próximos 2-3 meses
                  </option>

                  <option value="Solo quiero consultar una idea">
                    Solo quiero consultar una idea
                  </option>
                </select>
              </div>

              <!-- ENVIAR -->

              <div class="form-footer">
                <button
                  type="submit"
                  class="submit-button"
                >
                  Continuar en WhatsApp
                  <span aria-hidden="true">↗</span>
                </button>

                <p>
                  Al pulsar, se abrirá WhatsApp con
                  el mensaje preparado. Podrás revisarlo
                  antes de enviarlo.
                </p>
              </div>

            </form>

          </div>

          <!-- PREVISUALIZACIÓN INTERACTIVA -->

          <aside class="brief-aside" data-reveal>

            <div class="preview-card">

              <div class="preview-header">
                <div class="preview-dots" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <span>message-preview.txt</span>

                <span class="preview-header-status">
                  ● LIVE
                </span>
              </div>

              <div class="preview-content">

                <span class="preview-eyebrow">
                  VISTA PREVIA / MENSAJE
                </span>

                <h3>
                  Así llegará
                  <span>tu mensaje.</span>
                </h3>

                <p class="preview-description">
                  El contenido se actualizará mientras
                  completas los campos.
                </p>

                <div class="preview-message">
                  <div class="message-top">
                    <span class="message-avatar">
                      MS
                    </span>

                    <div>
                      <strong>Marco Sánchez</strong>
                      <span>Conversación de WhatsApp</span>
                    </div>
                  </div>

                  <pre
                    id="message-preview"
                    aria-live="polite"
                    aria-atomic="true"
                  >Hola Marco, soy [tu nombre].

Te contacto por: Desarrollo de una página web.

Mi idea/consulta:
[Cuéntame qué necesitas].

Plazo aproximado: Sin plazo definido.

He llegado desde tu portfolio.</pre>
                </div>

                <button
                  type="button"
                  class="copy-button"
                  id="copy-message"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="8" y="8" width="12" height="12" rx="2" />
                    <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                  </svg>

                  <span id="copy-button-label">
                    Copiar mensaje
                  </span>
                </button>

              </div>

              <div class="preview-footer">
                <span>
                  <span class="preview-status-dot"></span>
                  VISTA PREVIA LOCAL
                </span>

                <span>MS / CONTACT</span>
              </div>

            </div>

            <!-- NOTA DE PRIVACIDAD -->

            <div class="privacy-card">
              <div class="privacy-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="5" y="10" width="14" height="11" rx="2" />
                  <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                  <circle cx="12" cy="15" r="1" />
                </svg>
              </div>

              <div>
                <strong>Sin formularios externos.</strong>

                <p>
                  La información que escribas se
                  prepara en tu navegador. Esta página
                  no la envía a ningún servidor propio:
                  tú decides si finalmente la compartes
                  por WhatsApp.
                </p>
              </div>
            </div>

          </aside>

        </div>

      </div>
    </section>

    <!-- ====================================== -->
    <!--        CÓMO PLANTEAMOS UN PROYECTO     -->
    <!-- ====================================== -->

    <section
      class="process-section"
      aria-labelledby="process-title"
    >
      <div class="container">

        <div class="section-label" data-reveal>
          <span></span>
          03 / DEL PRIMER MENSAJE A LA IDEA
        </div>

        <div class="section-heading" data-reveal>
          <h2 id="process-title">
            Sin complicaciones.
            <span>Empecemos por hablar.</span>
          </h2>

          <p>
            No necesitas llegar con un documento
            perfectamente definido. Podemos empezar
            con una conversación y valorar la propuesta.
          </p>
