    grid-template-columns:
      minmax(0,1.1fr)
      minmax(0,.9fr);

    align-items: start;
    gap: 25px;
  }

  .brief-form-card,
  .preview-card {
    min-width: 0;
    overflow: hidden;

    border: 1px solid #3a404a;
    border-radius: 17px;

    background: #1a1e25;
  }

  .brief-form-card {
    border-color: rgba(215,166,92,.3);
  }

  .brief-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    padding: 23px 27px;
    border-bottom: 1px solid #393f48;

    background: #232730;
  }

  .brief-card-header > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .brief-card-header > div:first-child span {
    color: var(--gold);
    font-family: Consolas,monospace;
    font-size: .68rem;
    letter-spacing: .12em;
  }

  .brief-card-header strong {
    color: #f0f1f3;
    font-size: 1.12rem;
  }

  .brief-header-symbol {
    color: var(--gold);
    font-family: Consolas,monospace;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .brief-form {
    padding: 28px;
  }

  .topic-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .topic-fieldset legend,
  .form-section-heading {
    display: flex;
    align-items: center;
    gap: 12px;

    width: 100%;
    margin-bottom: 12px;

    color: #f0f1f3;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .form-step {
    display: inline-grid;
    place-items: center;
    width: 33px;
    height: 33px;
    flex-shrink: 0;

    border: 1px solid rgba(215,166,92,.38);
    border-radius: 8px;

    background: rgba(215,166,92,.08);
    color: var(--gold);

    font-family: Consolas,monospace;
    font-size: .78rem;
    font-weight: 700;
  }

  .field-description {
    margin: 0 0 20px;
    color: #a7b0bc;
    font-size: .85rem;
    line-height: 1.7;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 10px;
  }

  .topic-option {
    position: relative;
    display: block;
    min-width: 0;
    cursor: pointer;
  }

  .topic-option > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .topic-option-body {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 154px;

    padding: 17px;
    overflow: hidden;

    border: 1px solid #3d434e;
    border-radius: 11px;

    background: #22262e;

    transition:
      background .2s ease,
      border-color .2s ease;
  }

  .topic-option:hover .topic-option-body {
    border-color: rgba(215,166,92,.55);
  }

  .topic-option input:checked + .topic-option-body {
    border-color: var(--gold);
    background: rgba(215,166,92,.08);
  }

  .topic-option input:focus-visible + .topic-option-body {
    outline: 2px solid var(--gold-light);
    outline-offset: 3px;
  }

  .topic-option-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 23px;

    color: #9ca6b4;
    font-family: Consolas,monospace;
    font-size: .66rem;
  }

  .topic-symbol {
    color: var(--gold);
    font-weight: 700;
    font-size: .88rem;
  }

  .topic-option-body > strong {
    display: block;
    margin-bottom: 8px;

    color: #ecedf0;
    font-size: .94rem;
  }

  .topic-option-body > small {
    display: block;
    max-width: 220px;

    color: #aeb6c1;
    font-size: .74rem;
    line-height: 1.65;
  }

  .topic-check {
    position: absolute;
    top: 9px;
    right: 9px;

    display: grid;
    place-items: center;

    width: 18px;
    height: 18px;

    border-radius: 50%;
    background: var(--gold);
    color: #15171b;

    font-size: .67rem;
    font-weight: 800;

    opacity: 0;
    transform: scale(.75);
    transition:
      opacity .2s ease,
      transform .2s ease;
  }

  .topic-option input:checked
  + .topic-option-body .topic-check {
    opacity: 1;
    transform: scale(1);
  }

  /* CAMPOS */

  .form-section {
    margin-top: 34px;
    padding-top: 27px;
    border-top: 1px solid #363c46;
  }

  .form-section-heading {
    margin-bottom: 23px;
  }

  .form-section-heading h3 {
    margin: 0;
    color: #f0f1f3;
    font-size: 1.09rem;
  }

  .field-label {
    display: block;
    margin-bottom: 10px;

    color: var(--gold);
    font-size: .66rem;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .brief-form input[type="text"],
  .brief-form textarea,
  .brief-form select {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 14px 15px;

    border: 1px solid #424954;
    border-radius: 10px;
    outline: none;

    background: #232830;
    color: #f0f1f3;

    font-family: Inter,Arial,Helvetica,sans-serif;
    font-size: .9rem;
    line-height: 1.6;

    transition: border-color .2s ease;
  }

  .brief-form input[type="text"],
  .brief-form select {
    min-height: 49px;
  }

  .brief-form textarea {
    min-height: 145px;
    resize: vertical;
  }

  .brief-form input[type="text"]:focus,
  .brief-form textarea:focus,
  .brief-form select:focus {
    border-color: var(--gold);
  }

  .brief-form input::placeholder,
  .brief-form textarea::placeholder {
    color: #858e9a;
  }

  .brief-form select {
    cursor: pointer;
  }

  .brief-form select option {
    background: #232830;
    color: #f0f1f3;
  }

  .input-helper {
    margin: 10px 0 0;
    color: #919ba7;
    font-size: .75rem;
    line-height: 1.7;
  }

  .form-footer {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid #363c46;
  }

  .submit-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;

    width: 100%;
    min-height: 55px;
    padding: 15px 20px;

    border: 1px solid var(--gold);
    border-radius: 10px;

    background: var(--gold);
    color: #15171b;

    font-family: inherit;
    font-size: .94rem;
    font-weight: 750;

    cursor: pointer;

    transition:
      background .2s ease,
      transform .2s ease;
  }

  .submit-button:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
  }

  .submit-button > span {
    font-size: 1.25rem;
  }

  .form-footer > p {
    margin: 12px 0 0;
    color: #989faa;
    font-size: .77rem;
    line-height: 1.75;
  }

  /* ====================================== */
  /*           VISTA PREVIA EN VIVO         */
  /* ====================================== */

  .brief-aside {
    position: sticky;
    top: 160px;
    min-width: 0;
  }

  .preview-card {
    border-color: rgba(215,166,92,.32);
    box-shadow: 0 25px 60px rgba(0,0,0,.25);
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 13px;

    min-height: 53px;
    padding: 0 17px;

    border-bottom: 1px solid #393f49;
    background: #232730;
  }

  .preview-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .preview-dots > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .preview-dots > span:nth-child(1) {
    background: #ca7472;
  }

  .preview-dots > span:nth-child(2) {
    background: #d9b878;
  }

  .preview-dots > span:nth-child(3) {
    background: #82b799;
  }

  .preview-header > span {
    color: #a5aeba;
    font-family: Consolas,monospace;
    font-size: .7rem;
  }

  .preview-header .preview-header-status {
    color: #a6d0b0;
    font-size: .63rem;
  }

  .preview-content {
    padding: 27px;
  }

  .preview-eyebrow {
    color: var(--gold);
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .preview-content h3 {
    margin: 18px 0 14px;
    color: #f0f1f3;

    font-size: clamp(1.7rem,2.4vw,2.5rem);
    letter-spacing: -.045em;
    line-height: 1.2;
  }

  .preview-content h3 span {
    display: block;
    color: var(--gold);
  }

  .preview-description {
    margin: 0 0 25px;
    color: #acb5c0;
    font-size: .86rem;
    line-height: 1.8;
  }

  .preview-message {
    min-width: 0;
    overflow: hidden;

    border: 1px solid #424953;
    border-radius: 12px;
    background: #222730;
  }

  .message-top {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 15px;
    border-bottom: 1px solid #383f49;
  }

  .message-avatar {
    display: grid;
    place-items: center;

    width: 39px;
    height: 39px;
    flex-shrink: 0;

    border: 1px solid rgba(215,166,92,.45);
    border-radius: 10px;

    background: rgba(215,166,92,.1);
    color: var(--gold);

    font-size: .8rem;
    font-weight: 800;
  }

  .message-top > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .message-top strong {
    color: #ecedf0;
    font-size: .84rem;
  }

  .message-top > div > span {
    color: #a0a9b4;
    font-size: .7rem;
  }

  #message-preview {
    display: block;
    min-height: 200px;
    margin: 0;
    padding: 19px;

    color: #d4dae3;

    font-family: Consolas,"Courier New",monospace;
    font-size: .78rem;
    line-height: 1.9;

    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;

    width: 100%;
    min-height: 47px;
    margin-top: 18px;

    padding: 11px 15px;
    border: 1px solid #484e58;
    border-radius: 9px;

    background: #282d36;
    color: #e8eaee;

    font-family: inherit;
    font-size: .82rem;
    font-weight: 650;

    cursor: pointer;
  }

  .copy-button:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .copy-button svg {
    width: 17px;
    height: 17px;
  }

  .preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding: 15px 18px;
    border-top: 1px solid #383e47;

    background: #232730;
  }

  .preview-footer span {
    color: #a5aeba;
    font-family: Consolas,monospace;
    font-size: .62rem;
  }

  .preview-footer > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .preview-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a5cfb0;
  }

  /* NOTA DE PRIVACIDAD */

  .privacy-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;

    margin-top: 17px;
    padding: 20px;

    border: 1px solid #373e47;
    border-radius: 12px;
    background: #1b1f26;
  }

  .privacy-icon {
    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;
    flex-shrink: 0;

    border: 1px solid rgba(215,166,92,.35);
    border-radius: 9px;

    color: var(--gold);
  }

  .privacy-icon svg {
    width: 20px;
    height: 20px;
  }

  .privacy-card strong {
    color: #edf0f2;
    font-size: .85rem;
  }

  .privacy-card p {
    margin: 8px 0 0;

    color: #a9b2be;
    font-size: .78rem;
    line-height: 1.75;
  }

  /* ====================================== */
  /*              PROCESO                  */
  /* ====================================== */

  .process-section {
    padding: 120px 0;
    border-block: 1px solid #303640;
    background: var(--surface);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
  }

  .process-card {
    display: flex;
    flex-direction: column;
    min-height: 305px;

    padding: 28px;
    border: 1px solid #3a414b;
    border-radius: 14px;

    background: #20242b;

    transition: border-color .2s ease;
  }

  .process-card:hover {
    border-color: rgba(215,166,92,.6);
  }

  .process-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    color: #9ca5b2;
    font-family: Consolas,monospace;
    font-size: .72rem;
  }

  .process-top > span:last-child {
    color: var(--gold);
    font-size: 1.3rem;
  }

  .process-number {
    margin: 35px 0 20px;

    color: rgba(215,166,92,.35);
    font-size: 4.3rem;
    font-weight: 800;
    letter-spacing: -.09em;
    line-height: 1;
  }

  .process-card h3 {
    margin: 0 0 13px;
    color: #f0f1f3;
    font-size: 1.2rem;
  }

  .process-card p {
    margin: 0;
    color: #aeb6c1;
    font-size: .85rem;
    line-height: 1.8;
  }

  /* ====================================== */
  /*              UBICACIÓN                */
  /* ====================================== */

  .location-section {
    padding: 120px 0;
    background: var(--background);
  }

  .location-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(40px,7vw,100px);
  }

  .location-content h2 {
    margin-bottom: 24px;
  }

  .location-content > p {
    margin: 0 0 16px;
    color: #aeb7c2;
    font-size: .96rem;
    line-height: 1.86;
  }

  .location-content > p strong {
    color: #e4e7eb;
  }

  .location-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;

    margin-top: 18px;
    padding-bottom: 8px;

    border-bottom: 1px solid var(--gold);

    color: #e0b173;
    font-size: .89rem;
    font-weight: 650;
    text-decoration: none;
  }

  .location-link:hover {
    color: var(--gold-light);
  }

  .location-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 420px;
    padding: 25px;
    overflow: hidden;

    border: 1px solid rgba(215,166,92,.38);
    border-radius: 17px;

    background:
      radial-gradient(
        circle at 50% 38%,
        rgba(215,166,92,.09),
        transparent 65%
      ),
      #1e222a;
  }

  .location-grid {
    position: absolute;
    inset: 0;
    z-index: -1;

    background-image:
      linear-gradient(
        rgba(255,255,255,.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,.025) 1px,
        transparent 1px
      );

    background-size: 35px 35px;
    pointer-events: none;
  }

  .location-visual-header {
    display: flex;
    justify-content: space-between;
    gap: 15px;

    color: #aab3bf;
    font-family: Consolas,monospace;
    font-size: .65rem;
    letter-spacing: .1em;
  }

  .location-center {
    position: relative;
    display: grid;
    place-items: center;
    height: 215px;
  }

  .radar {
    position: absolute;
    border: 1px solid rgba(215,166,92,.18);
    border-radius: 50%;
  }

  .radar-one {
    width: 210px;
    height: 210px;
  }

  .radar-two {
    width: 155px;
    height: 155px;
  }

  .radar-three {
    width: 105px;
    height: 105px;
    border-color: rgba(215,166,92,.4);
  }

  .location-marker {
    display: grid;
    place-items: center;

    width: 70px;
    height: 70px;

    border: 1px solid rgba(215,166,92,.5);
    border-radius: 50%;

    background: #292c31;
    color: var(--gold);
  }

  .location-marker svg {
    width: 31px;
    height: 31px;
  }

  .location-visual-bottom {
    position: relative;
    z-index: 2;
  }

  .location-visual-bottom > span {
    color: var(--gold);
    font-size: .67rem;
    font-weight: 750;
    letter-spacing: .16em;
  }

  .location-visual-bottom h3 {
    margin: 10px 0;
    color: #f0f1f3;

    font-size: clamp(1.6rem,2.55vw,2.35rem);
    letter-spacing: -.04em;
  }

  .location-visual-bottom h3 span {
    color: var(--gold);
  }

  .location-visual-bottom p {
    margin: 0;
    color: #aeb7c2;
    font-size: .85rem;
  }

  /* ====================================== */
  /*                FAQ                   */
  /* ====================================== */

  .faq-section {
    padding: 120px 0;
    border-block: 1px solid #303640;
    background: var(--surface);
  }

  .faq-layout {
    display: grid;
    grid-template-columns:
      minmax(0,.82fr)
      minmax(0,1.18fr);

    align-items: start;
    gap: clamp(40px,6vw,95px);
  }

  .faq-heading h2 {
    margin-bottom: 23px;
  }

  .faq-heading > p {
    max-width: 420px;
    margin: 0;

    color: #adb6c1;
    font-size: .95rem;
    line-height: 1.85;
  }

  .faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid #3b424b;
    border-radius: 11px;
    background: #22262e;
  }

  .faq-item[open] {
    border-color: rgba(215,166,92,.55);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 15px;

    min-height: 70px;
    padding: 18px 20px;

    color: #ecedf0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-index {
    color: var(--gold);
    font-family: Consolas,monospace;
    font-size: .75rem;
  }

  .faq-question {
    flex: 1;
    font-size: .93rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .faq-icon {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    flex-shrink: 0;

    border: 1px solid #4a4f58;
    border-radius: 7px;

    color: var(--gold);
    font-size: 1.35rem;
    line-height: 1;

    transition: transform .2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 20px 20px 50px;
  }

  .faq-answer p {
    margin: 0;
    color: #afb7c2;
    font-size: .87rem;
    line-height: 1.85;
  }

  /* ====================================== */
  /*                CIERRE                */
  /* ====================================== */

  .closing-section {
    padding: 120px 0 135px;

    background:
      radial-gradient(
        ellipse at 50% 115%,
        rgba(215,166,92,.09),
        transparent 60%
      ),
      #101216;

    text-align: center;
  }

  .closing-inner {
    max-width: 930px;
  }

  .section-label.centered {
    justify-content: center;
  }

  .closing-inner h2 {
    margin-bottom: 26px;
  }

  .closing-inner > p {
    max-width: 665px;
    margin: 0 auto;

    color: #acb6c1;
    font-size: .97rem;
    line-height: 1.88;
  }

  .closing-buttons {
    justify-content: center;
    margin-top: 35px;
  }

  .closing-signature {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 17px;

    margin-top: 63px;

    color: #9aa4b0;
    font-family: Consolas,monospace;
    font-size: .69rem;
    letter-spacing: .13em;
  }

  .signature-separator {
    width: 26px;
    height: 1px;
    background: var(--gold);
  }

  /* ====================================== */
  /*              RESPONSIVE              */
  /* ====================================== */

  @media (max-width: 1150px) {
    .container {
      width: min(calc(100% - 56px),1000px);
    }

    .hero-layout {
      gap: 40px;
    }

    .hero-content h1 {
      font-size: clamp(2.9rem,5.2vw,5.2rem);
    }

    .portrait-card {
      height: 480px;
    }

    .brief-layout {
      grid-template-columns: 1fr .85fr;
      gap: 17px;
    }

    .brief-form,
    .preview-content {
      padding: 21px;
    }

    .channel-card {
      padding: 22px;
    }
  }

  @media (max-width: 900px) {
    .hero-layout,
    .section-heading,
    .brief-layout,
    .location-layout,
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .hero-content {
      max-width: 760px;
    }

    .hero-content h1 {
      font-size: clamp(3.2rem,7.5vw,5.3rem);
    }

    .hero-visual {
      width: min(100%,580px);
      margin-inline: auto;
    }

    .portrait-card {
      height: 555px;
    }

    .section-heading {
      gap: 22px;
    }

    .channels-grid {
      grid-template-columns: repeat(2,minmax(0,1fr));
    }

