    technologies: [
      "PHP",
      "Laravel",
      "Python",
      "Django",
      "FastAPI",
      "Java",
      "C#",
      ".NET",
      "Node.js",
    ],
  },
  {
    number: "03",
    name: "Datos y herramientas",
    description:
      "Persistencia de información, consultas, integración entre sistemas y herramientas de desarrollo.",
    technologies: [
      "PostgreSQL",
      "MySQL",
      "MariaDB",
      "SQL Server",
      "SQL",
      "APIs REST",
      "AJAX",
      "Git",
      "GitHub",
      "Linux",
