  }

  .experience-body {
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    gap: 35px;
    padding: 35px;
  }

  .role-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #d7a65c;
    font-size: .71rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .experience-main h4 {
    max-width: 650px;
    margin: 24px 0;
    color: #f0f1f3;
    font-size: clamp(1.8rem,2.6vw,2.8rem);
    font-weight: 700;
    letter-spacing: -.05em;
    line-height: 1.19;
  }

  .experience-main h4 span {
    display: block;
    color: #d7a65c;
  }

  .experience-main > p {
    max-width: 690px;
    margin: 0 0 16px;
    color: #b0b8c4;
    font-size: .95rem;
    line-height: 1.85;
  }

  .experience-main > p strong {
    color: #e4e8ed;
    font-weight: 650;
  }

  .experience-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 25px;
    color: #979faa;
    font-size: .73rem;
  }

  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid #d7a65c;
    color: #e0b173;
    font-size: .88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .experience-divider {
    width: 1px;
    height: 24px;
    background: #3f444e;
  }

  .experience-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 330px;
    padding: 22px;
    border: 1px solid #44434a;
    border-radius: 12px;
    background:
      radial-gradient(
        ellipse at 50% 35%,
        rgba(215,166,92,.11),
        transparent 68%
      ),
      #23252c;
  }

  .experience-side-top,
  .experience-side-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .experience-side-top > span:first-child {
    color: #8f99a6;
    font-family: Consolas,monospace;
    font-size: .65rem;
    letter-spacing: .1em;
  }

  .gold-arrow {
    color: #d7a65c;
    font-size: 1.35rem;
  }

  .experience-side-center {
    text-align: center;
  }

  .side-code {
    display: inline-block;
    margin-bottom: 10px;
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: 2.5rem;
    font-weight: 700;
  }

  .experience-side-center h5 {
    margin: 0 0 9px;
    color: #edf0f3;
    font-size: 1.55rem;
  }

  .experience-side-center p {
    max-width: 260px;
    margin: 0 auto;
    color: #a9b1bd;
    font-size: .83rem;
    line-height: 1.7;
  }

  .experience-side-bottom {
    justify-content: center;
    flex-wrap: wrap;
  }

  .experience-side-bottom span {
    padding: 6px 9px;
    border-radius: 6px;
    background: #353a43;
    color: #d0d4dd;
    font-size: .69rem;
  }

  .subsection-header,
  .features-intro,
  .video-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 35px;
    margin: 75px 0 32px;
  }

  .subsection-header h3,
  .features-intro h3,
  .video-section-heading h3 {
    margin: 0;
    color: #f1f2f4;
    font-size: clamp(2rem,3vw,3.1rem);
    font-weight: 720;
    letter-spacing: -.045em;
    line-height: 1.16;
  }

  .subsection-header h3 span,
  .features-intro h3 span,
  .video-section-heading h3 span {
    display: block;
    color: #d7a65c;
  }

  .subsection-header > p,
  .features-intro > p,
  .video-section-heading > p {
    max-width: 390px;
    margin: 0;
    color: #a9b2be;
    font-size: .9rem;
    line-height: 1.8;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 15px;
  }

  .practice-card {
    display: flex;
    flex-direction: column;
    min-height: 305px;
    padding: 24px;
    border: 1px solid #323842;
    border-radius: 13px;
    background: #1a1e25;
    transition:
      border-color .25s ease,
      background .25s ease;
  }

  .practice-card:hover {
    border-color: rgba(215,166,92,.55);
    background: #20242b;
  }

  .practice-card-top,
  .feature-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 47px;
    color: #909baa;
    font-family: Consolas,monospace;
    font-size: .73rem;
  }

  .practice-card-icon,
  .feature-card-header > span:last-child {
    color: #d7a65c;
    font-size: 1.2rem;
  }

  .practice-card h4 {
    margin: 0 0 13px;
    color: #f0f1f3;
    font-size: 1.19rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .practice-card p {
    margin: 0;
    color: #aab3bf;
    font-size: .84rem;
    line-height: 1.75;
  }

  .practice-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 22px;
  }

  .practice-tags span {
    padding: 6px 8px;
    border-radius: 5px;
    background: #2d323b;
    color: #cad0d9;
    font-size: .65rem;
  }

  .experience-note,
  .architecture-note {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-top: 32px;
    padding: 19px 23px;
    border: 1px solid rgba(215,166,92,.27);
    border-radius: 12px;
    background: rgba(215,166,92,.055);
  }

  .note-icon,
  .architecture-note > span {
    color: #d7a65c;
    font-size: 1.2rem;
  }

  .experience-note p,
  .architecture-note p {
    margin: 0;
    color: #bdc3ce;
    font-size: .88rem;
    line-height: 1.8;
  }

  .experience-note strong,
  .architecture-note strong {
    color: #e7e8ea;
  }

  /* ====================================== */
  /*              TECNOLOGÍAS              */
  /* ====================================== */

  .skills-section {
    padding: 120px 0 130px;
    border-block: 1px solid #303640;
    background: #171b22;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 18px;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    min-height: 400px;
    padding: 30px;
    border: 1px solid #373c46;
    border-radius: 16px;
    background: #20242c;
    transition:
      border-color .25s ease,
      background .25s ease;
  }

  .skill-card:hover {
    border-color: rgba(215,166,92,.56);
    background: #242932;
  }

  .skill-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 42px;
  }

  .skill-card-top > span:first-child {
    color: #8e98a6;
    font-family: Consolas,monospace;
    font-size: .75rem;
  }

  .skill-symbol {
    display: grid;
    place-items: center;
    min-width: 53px;
    height: 53px;
    padding-inline: 9px;
    border: 1px solid rgba(215,166,92,.35);
    border-radius: 10px;
    background: rgba(215,166,92,.08);
    color: #e0b173;
    font-family: Consolas,monospace;
    font-size: 1rem;
    font-weight: 800;
  }

  .skill-card h3 {
    margin: 0 0 16px;
    color: #edf0f3;
    font-size: 1.5rem;
    letter-spacing: -.035em;
  }

  .skill-card > p {
    margin: 0;
    color: #abb3bf;
    font-size: .88rem;
    line-height: 1.8;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
  }

  .skill-tags span {
    padding: 8px 10px;
    border: 1px solid #3d444e;
    border-radius: 7px;
    background: #2b3039;
    color: #d4d8e0;
    font-size: .73rem;
  }

  .fullstack-banner {
    display: flex;
    align-items: center;
    gap: 36px;
    margin-top: 30px;
    padding: 34px;
    border: 1px solid rgba(215,166,92,.31);
    border-radius: 15px;
    background:
      radial-gradient(
        ellipse at 0% 50%,
        rgba(215,166,92,.09),
        transparent 65%
      ),
      #20242b;
  }

  .fullstack-code {
    flex-shrink: 0;
    color: #838b98;
    font-family: Consolas,monospace;
    font-size: clamp(2.6rem,4.5vw,5rem);
    font-weight: 700;
    letter-spacing: -.1em;
  }

  .fullstack-code span {
    color: #d7a65c;
  }

  .fullstack-text {
    flex: 1;
  }

  .fullstack-text > span {
    color: #d7a65c;
    font-size: .64rem;
    font-weight: 750;
    letter-spacing: .15em;
  }

  .fullstack-text h3 {
    margin: 8px 0 12px;
    color: #f0f1f3;
    font-size: 1.55rem;
  }

  .fullstack-text p {
    max-width: 670px;
    margin: 0;
    color: #aeb6c1;
    font-size: .88rem;
    line-height: 1.8;
  }

  .banner-arrow {
    align-self: flex-start;
    color: #d7a65c;
    font-size: 1.5rem;
  }

  /* ====================================== */
  /*            METODOLOGÍA                */
  /* ====================================== */

  .method-section {
    padding: 125px 0;
    background: #101216;
  }

  .method-layout {
    display: grid;
    grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr);
    align-items: start;
    gap: clamp(35px,5vw,80px);
  }

  .method-sticky {
    position: sticky;
    top: 180px;
  }

  .method-terminal {
    overflow: hidden;
    border: 1px solid #3b414c;
    border-radius: 15px;
    background: #171c24;
    box-shadow: 0 22px 60px rgba(0,0,0,.25);
  }

  .terminal-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 17px 20px;
    border-bottom: 1px solid #353b45;
    background: #222731;
    color: #b3bbc6;
    font-family: Consolas,monospace;
    font-size: .76rem;
  }

  .terminal-top > span:last-child {
    margin-left: auto;
    color: #d7a65c;
  }

  .terminal-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d7a65c;
  }

  .terminal-body {
    padding: 30px 20px;
    overflow-x: auto;
  }

  .terminal-body p {
    margin: 0;
    color: #c4cbd5;
    font-family: Consolas,"Courier New",monospace;
    font-size: clamp(.69rem,1vw,.85rem);
    line-height: 2.3;
    white-space: pre;
  }

  .terminal-body p > span {
    display: inline-block;
    width: 29px;
    margin-right: 14px;
    color: #707e91;
  }

  .terminal-body b {
    color: #c5a2e5;
    font-weight: 500;
  }

  .terminal-body strong {
    color: #a5d8b1;
    font-weight: 500;
  }

  .terminal-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px;
    border-top: 1px solid #373e48;
    background: #20252d;
    color: #949da9;
    font-family: Consolas,monospace;
    font-size: .65rem;
  }

  .terminal-success {
    color: #b1d6b9;
  }

  .method-side-caption {
    margin: 14px 0 0;
    color: #838c99;
    font-size: .72rem;
    line-height: 1.7;
    text-align: center;
  }

  .method-steps {
    display: grid;
    gap: 16px;
  }

  .method-step {
    padding: 25px;
    border: 1px solid #343a44;
    border-radius: 13px;
    background: #1b1f27;
    transition: border-color .25s ease;
  }

  .method-step:hover {
    border-color: rgba(215,166,92,.5);
  }

  .method-number {
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: .83rem;
  }

  .method-step h3 {
    margin: 13px 0 11px;
    color: #f0f1f3;
    font-size: 1.32rem;
    font-weight: 650;
  }

  .method-step p {
    margin: 0;
    color: #adb6c1;
    font-size: .88rem;
    line-height: 1.8;
  }

  .method-tools {
    margin-top: 20px;
  }

  .method-tools span {
    color: #d0b38e;
    font-family: Consolas,monospace;
    font-size: .72rem;
  }

  .method-conclusion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    max-width: 850px;
    margin: 65px auto 0;
  }

  .conclusion-mark {
    color: #d7a65c;
    font-family: Georgia,serif;
    font-size: 5rem;
    line-height: .8;
  }

  .method-conclusion p {
    margin: 0;
    color: #cfd3da;
    font-size: clamp(1.2rem,1.8vw,1.65rem);
    line-height: 1.55;
  }

  /* ====================================== */
  /*             PROYECTO PRINCIPAL         */
  /* ====================================== */

  .project-section {
    position: relative;
    isolation: isolate;
    padding: 120px 0 135px;
    overflow: hidden;
    border-block: 1px solid #383b41;
    background: #171b21;
  }

  .project-bg-grid {
    opacity: .45;
    mask-image: linear-gradient(180deg,#000,transparent 45%);
    -webkit-mask-image: linear-gradient(180deg,#000,transparent 45%);
  }

  .project-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .project-top-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 28px;
  }

  .project-status,
  .project-academic {
    padding: 9px 12px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .project-status {
    border: 1px solid rgba(215,166,92,.4);
    background: rgba(215,166,92,.08);
    color: #e0b173;
  }

  .project-academic {
    border: 1px solid #3d444e;
    background: #262b33;
    color: #b9c1cc;
  }

  .project-heading h2 {
    font-size: clamp(4rem,8vw,9rem);
    line-height: 1;
  }

  .project-heading h2 span {
    color: #d7a65c;
  }

  .project-headline {
    margin: 20px 0 0;
    color: #d4d9e0;
    font-size: clamp(1rem,1.5vw,1.3rem);
    line-height: 1.6;
  }

  .project-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 235px;
    min-height: 215px;
    padding: 22px;
    border: 1px solid rgba(215,166,92,.45);
    border-radius: 16px;
    background:
      radial-gradient(
        circle,
        rgba(215,166,92,.1),
        transparent 75%
      ),
      #23262d;
  }

  .project-score > span,
  .project-score small {
    color: #bda987;
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .project-score strong {
    display: block;
    margin: 9px 0;
    color: #d7a65c;
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: -.08em;
    line-height: 1;
  }

  .project-score strong span {
    color: #818995;
    font-size: .4em;
    letter-spacing: -.03em;
  }

  .project-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    margin-top: 48px;
  }

  .project-intro p {
    margin: 0;
    color: #afb7c2;
    font-size: .98rem;
    line-height: 1.9;
  }

  .project-intro strong {
    color: #e7e9ed;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 31px;
  }

  .project-tech span {
    padding: 9px 13px;
    border: 1px solid #434750;
    border-radius: 8px;
    background: #252a32;
    color: #d7dbe2;
    font-size: .76rem;
  }

  /* VÍDEO */

  .video-section {
    margin-top: 100px;
  }

  .video-section-heading {
    margin: 0 0 32px;
  }

  .video-browser {
    overflow: hidden;
    border: 1px solid rgba(215,166,92,.44);
    border-radius: 17px;
    background: #101216;
    box-shadow: 0 32px 85px rgba(0,0,0,.3);
  }

  .video-browser-header,
  .video-browser-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 52px;
    padding: 0 20px;
    background: #22262e;
  }

  .video-browser-header {
    border-bottom: 1px solid #343944;
  }

  .video-browser-footer {
    min-height: 44px;
    border-top: 1px solid #343944;
  }

  .video-browser-title,
  .video-browser-badge,
  .video-browser-footer span {
    color: #a8b1bd;
    font-family: Consolas,monospace;
    font-size: .68rem;
  }

  .video-browser-badge {
    color: #d7a65c;
  }

  .video-browser-footer > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .video-footer-dot,
  .video-status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d7a65c;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #101216;
  }

  .barbers-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    background: #101216;
    object-fit: contain;
  }

  .video-frame.is-ready .barbers-video {
    opacity: 1;
    pointer-events: auto;
  }

  .video-frame.is-ready .video-placeholder {
    display: none;
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    isolation: isolate;
    padding: clamp(15px,4vw,45px);
    overflow: hidden;
    background: #14181f;
  }

  .video-placeholder-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgba(215,166,92,.17),
      transparent 60%
    );
  }

  .demo-window {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: min(100%,880px);
    height: min(100%,430px);
    min-height: 0;
    padding: clamp(14px,2.5vw,27px);
    border: 1px solid rgba(215,166,92,.25);
    border-radius: 13px;
    background:
      linear-gradient(
        140deg,
        rgba(215,166,92,.08),
        transparent 55%
      ),
      #1c2129;
    box-shadow: 0 25px 75px rgba(0,0,0,.3);
  }

  .demo-top,
  .demo-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: #9ca6b3;
    font-family: Consolas,monospace;
    font-size: .68rem;
    letter-spacing: .1em;
  }

  .demo-logo {
    color: #f2f2f3;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -.05em;
  }

  .demo-logo span {
    color: #d7a65c;
  }

  .demo-center {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    text-align: center;
  }

  .demo-eyebrow {
    color: #c1ad8c;
    font-size: .69rem;
    letter-spacing: .16em;
  }

  .demo-play {
    display: grid;
    place-items: center;
    width: clamp(54px,6vw,80px);
    height: clamp(54px,6vw,80px);
    margin-block: 8px;
    border: 1px solid rgba(215,166,92,.65);
    border-radius: 50%;
    background: rgba(215,166,92,.13);
    color: #d7a65c;
    font-size: 1.5rem;
  }

  .demo-center strong {
    color: #f0f1f3;
    font-size: clamp(1.65rem,4vw,3.8rem);
    font-weight: 800;
    letter-spacing: -.065em;
    line-height: 1;
  }

  .demo-center strong span {
    color: #d7a65c;
  }

  .demo-center small {
    color: #aeb7c4;
    font-size: .78rem;
  }

  .video-overlay-caption {
    position: absolute;
    right: 20px;
    bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #d4bf9c;
    font-size: .63rem;
    letter-spacing: .1em;
  }

  .video-help {
    margin: 15px 0 0;
    color: #949daa;
    font-size: .78rem;
    line-height: 1.7;
    text-align: center;
  }

  .video-help code {
    color: #d7a65c;
    font-family: Consolas,monospace;
  }

  /* FUNCIONALIDADES CLIENTE */

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
  }

  .feature-card {
    min-height: 225px;
    padding: 26px;
    border: 1px solid #393f49;
    border-radius: 13px;
    background: #20252d;
    transition:
      border-color .2s ease,
      background .2s ease;
  }

  .feature-card:hover {
    border-color: rgba(215,166,92,.58);
    background: #262b34;
  }

  .feature-card-header {
    margin-bottom: 31px;
  }

  .feature-card h4 {
    margin: 0 0 11px;
    color: #f0f1f3;
    font-size: 1.17rem;
    font-weight: 650;
  }

  .feature-card p {
    margin: 0;
    color: #adb5c0;
    font-size: .85rem;
    line-height: 1.75;
  }

  /* ADMINISTRACIÓN */

  .admin-section {
    margin-top: 110px;
  }

  .admin-layout {
    display: grid;
    grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr);
    align-items: center;
    gap: 32px;
  }

  .admin-visual {
    padding: 22px;
    border: 1px solid #404550;
    border-radius: 14px;
    background: #1c2129;
  }

  .admin-screen {
    overflow: hidden;
    border: 1px solid #353b45;
    border-radius: 11px;
    background: #141920;
  }

  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px;
    border-bottom: 1px solid #343b44;
    color: #d9dce2;
    font-family: Consolas,monospace;
    font-size: .65rem;
  }

  .admin-topbar > span:first-child {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .admin-logo-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(215,166,92,.4);
    border-radius: 6px;
    color: #d7a65c;
    font-size: .58rem;
    font-weight: 800;
  }

  .admin-topbar > span:last-child {
    color: #8f99a5;
  }

  .admin-screen-content {
    padding: 26px;
  }

  .admin-mock-label {
    color: #d7a65c;
    font-size: .63rem;
    letter-spacing: .12em;
  }

  .admin-screen-content h4 {
    margin: 9px 0 23px;
    color: #f0f1f3;
    font-size: 1.45rem;
  }

  .mock-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .mock-stats div {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 15px;
    border: 1px solid #363d48;
    border-radius: 9px;
    background: #222832;
  }

  .mock-stats span {
    color: #929cab;
    font-size: .72rem;
  }

  .mock-stats strong {
    color: #e0b173;
    font-size: .89rem;
  }

  .mock-chart {
    display: flex;
    align-items: end;
    justify-content: space-around;
    gap: 12px;
    height: 155px;
    margin-top: 18px;
    padding: 18px 12px 0;
    border: 1px solid #353b46;
    border-radius: 9px;
    background: #1b222b;
  }

  .mock-chart span {
    flex: 1;
    max-width: 43px;
    border-radius: 5px 5px 0 0;
    background: linear-gradient(
      180deg,
      #d7a65c,
      #695439
    );
  }

  .mock-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    color: #838f9d;
    font-family: Consolas,monospace;
    font-size: .63rem;
  }

  .mock-footer span:last-child {
    color: #8fc8a0;
  }

  .mockup-caption {
    margin: 15px 0 0;
    color: #87919e;
    font-size: .72rem;
    text-align: center;
    line-height: 1.6;
  }

  .admin-features {
    border-top: 1px solid #3c414b;
  }

  .admin-feature {
    display: grid;
    grid-template-columns: 34px minmax(0,1fr) 20px;
    align-items: start;
    gap: 17px;
    padding: 20px 0;
    border-bottom: 1px solid #3c414b;
  }

  .admin-feature-number {
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: .72rem;
  }

  .admin-feature h4 {
    margin: 0 0 7px;
    color: #ebedf1;
    font-size: 1.04rem;
  }

  .admin-feature p {
    margin: 0;
    color: #aab3be;
    font-size: .83rem;
    line-height: 1.7;
  }

  .admin-feature-arrow {
    color: #d7a65c;
    font-size: 1.2rem;
  }

  /* ARQUITECTURA */

  .architecture-section {
    margin-top: 110px;
  }

  .architecture-flow {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 14px;
  }

  .architecture-item {
    position: relative;
    min-height: 255px;
    padding: 24px;
    border: 1px solid #3e444e;
    border-radius: 13px;
    background: #20252d;
  }

  .architecture-number {
    display: block;
    color: #8994a2;
    font-family: Consolas,monospace;
    font-size: .7rem;
  }

  .architecture-role {
    display: block;
    margin: 34px 0 9px;
    color: #d7a65c;
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .architecture-item h4 {
    margin: 0 0 12px;
    color: #f0f1f3;
    font-size: 1.36rem;
  }

  .architecture-item p {
    margin: 0;
    color: #aab3be;
    font-size: .83rem;
    line-height: 1.7;
  }

  .architecture-arrow {
    position: absolute;
    top: 45%;
    right: -20px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border: 1px solid #d7a65c;
    border-radius: 50%;
    background: #252931;
    color: #d7a65c;
    font-size: 1rem;
  }

  .architecture-note {
    margin-top: 20px;
  }

  /* ESTADO DEL PROYECTO */

  .project-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 75px;
    padding: 29px;
    border: 1px solid rgba(215,166,92,.32);
    border-radius: 14px;
    background: #22262d;
  }

  .project-availability {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }

  .availability-indicator {
    display: inline-block;
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    margin-top: 6px;
    border-radius: 50%;
    background: #d7a65c;
    box-shadow: 0 0 0 5px rgba(215,166,92,.11);
  }

  .project-availability strong {
    color: #f0f1f3;
    font-size: 1rem;
  }

  .project-availability p {
    max-width: 580px;
    margin: 7px 0 0;
    color: #a9b2be;
    font-size: .83rem;
    line-height: 1.7;
  }

  .project-github-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-height: 54px;
    padding: 13px 19px;
    flex-shrink: 0;
    border-radius: 10px;
    background: #d7a65c;
    color: #121419;
    font-size: .85rem;
    font-weight: 750;
    text-decoration: none;
    transition: background .2s ease;
  }

  .project-github-button:hover {
    background: #edbe79;
  }

  .project-github-button svg {
    width: 21px;
    height: 21px;
  }

  /* ====================================== */
  /*               CIERRE                  */
  /* ====================================== */

  .closing-section {
    padding: 125px 0 140px;
    background:
      radial-gradient(
        ellipse at 50% 110%,
        rgba(215,166,92,.085),
        transparent 55%
      ),
      #101216;
    text-align: center;
  }

  .closing-inner {
    max-width: 900px;
  }

  .section-eyebrow.centered {
    justify-content: center;
  }

  .closing-section h2 {
    margin-bottom: 24px;
  }

  .closing-section p {
    max-width: 660px;
    margin: 0 auto;
    color: #aeb6c1;
    font-size: 1rem;
    line-height: 1.85;
  }

  .closing-buttons {
    justify-content: center;
    margin-top: 35px;
  }

  /* ====================================== */
  /*               CHATBOT                 */
  /* ====================================== */

  .chat-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    font-family: Inter,Arial,Helvetica,sans-serif;
  }

  .chat-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 53px;
    padding: 13px 20px;
    border: 1px solid #e3b976;
    border-radius: 999px;
    background: #d7a65c;
    color: #111318;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    box-shadow: 0 10px 32px rgba(0,0,0,.35);
    transition: background .2s ease,transform .2s ease;
  }

  .chat-toggle:hover {
    background: #edbe79;
    transform: translateY(-3px);
  }

  .chat-toggle svg {
    width: 21px;
    height: 21px;
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    display: flex;
    flex-direction: column;
    width: min(385px,calc(100vw - 28px));
    height: min(540px,calc(100dvh - 115px));
    overflow: hidden;
    border: 1px solid #3a3f47;
    border-radius: 17px;
    background: #171a20;
    color: #e8eaee;
    box-shadow: 0 25px 75px rgba(0,0,0,.55);
  }

  .chat-panel[hidden] {
    display: none;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 15px;
    border-bottom: 1px solid #353941;
    background: #20242b;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 41px;
    height: 41px;
    flex-shrink: 0;
    border: 1px solid rgba(215,166,92,.6);
    border-radius: 12px;
    background: rgba(215,166,92,.08);
    color: #d7a65c;
    font-size: .9rem;
    font-weight: 800;
  }

  .chat-heading {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
  }

  .chat-heading strong {
    color: #f0f1f3;
    font-size: 13px;
  }

  .chat-heading > span {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #a8aeb8;
    font-size: 10px;
  }

  .online-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8ab99c;
  }

  .chat-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #aeb4be;
    cursor: pointer;
  }

  .chat-close:hover {
    background: #30353d;
  }

  .chat-close svg {
    width: 19px;
    height: 19px;
  }

  .chat-messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    padding: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  :global(#marco-chat .chat-bubble) {
    width: fit-content;
    max-width: 91%;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(#marco-chat .bot-bubble) {
    align-self: flex-start;
    border: 1px solid #383d47;
    border-top-left-radius: 4px;
    background: #292e37;
    color: #e8eaee;
  }

  :global(#marco-chat .user-bubble) {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: #d7a65c;
    color: #13151a;
  }

  :global(#marco-chat .chat-page-link),
  :global(#marco-chat .chat-whatsapp) {
    display: inline-flex;
    align-self: flex-start;
    max-width: 100%;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 11.5px;
    font-weight: 700;
    text-decoration: none;
  }

  :global(#marco-chat .chat-page-link) {
    border: 1px solid rgba(215,166,92,.4);
    background: rgba(215,166,92,.08);
    color: #e0b173;
  }

  :global(#marco-chat .chat-whatsapp) {
    border: 1px solid #d7a65c;
    background: #d7a65c;
    color: #141619;
  }

  .chat-quick-label {
    padding: 10px 15px 7px;
    border-top: 1px solid #30343c;
    background: #1c2027;
    color: #868d99;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 4px 14px 12px;
    background: #1c2027;
  }

  .chat-suggestions button {
    min-height: 30px;
    padding: 7px 10px;
