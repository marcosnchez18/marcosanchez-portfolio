  {
    number: "01",
    title: "Desarrollo de interfaces",
    description:
      "Trabajo con vistas y componentes para presentar información de forma clara, responsive y coherente con las necesidades de una aplicación.",
    tags: ["Frontend", "JavaScript", "CSS", "React / Angular"],
  },
  {
    number: "02",
    title: "Lógica y funcionalidades",
    description:
      "Participación en tareas de desarrollo backend con PHP y Laravel, trabajando con rutas, controladores, formularios y tratamiento de datos.",
    tags: ["PHP", "Laravel", "Backend"],
  },
  {
    number: "03",
    title: "Bases de datos",
    description:
      "Trabajo con información estructurada, consultas SQL y conexión entre aplicaciones y bases de datos relacionales.",
    tags: ["SQL", "MySQL", "PostgreSQL"],
  },
  {
    number: "04",
    title: "Integración y trabajo técnico",
    description:
      "Contacto con servicios y APIs REST, autenticación, control de versiones con Git y entornos de desarrollo basados en Linux.",
    tags: ["APIs REST", "Git", "Linux"],
  },
];

const problemSteps = [
  {
    number: "01",
    title: "Entender el fallo",
    text:
      "Antes de modificar código, intento reproducir el problema, identificar qué debería ocurrir y localizar dónde empieza a fallar el flujo.",
    tool: "Reproducción · Análisis",
  },
  {
    number: "02",
    title: "Seguir el recorrido",
    text:
      "Reviso la interfaz, las peticiones, las rutas, la lógica del servidor y los datos, según la capa de la aplicación que esté implicada.",
    tool: "DevTools · Logs · SQL",
  },
  {
    number: "03",
    title: "Corregir con criterio",
    text:
      "Busco una solución comprensible y mantenible, evitando cambiar partes de la aplicación que no están relacionadas con el error.",
    tool: "Depuración · Validaciones",
  },
  {
    number: "04",
    title: "Comprobar el resultado",
    text:
      "Verifico el caso inicial y otros escenarios relacionados, como campos vacíos, datos incorrectos o cambios de estado inesperados.",
    tool: "Pruebas · Git",
  },
];

const clientFeatures = [
  {
    icon: "01",
    title: "Reserva de citas",
    description:
      "Selección de barbero, servicio, fecha y hora desde una interfaz pensada para el cliente.",
  },
  {
    icon: "02",
    title: "Pagos flexibles",
    description:
      "Posibilidad de elegir PayPal o pago en efectivo según la reserva.",
  },
  {
    icon: "03",
    title: "Gestión personal",
    description:
      "Modificación y cancelación de citas, consulta del historial y valoraciones.",
  },
  {
    icon: "04",
    title: "Notificaciones",
    description:
      "Confirmaciones mediante correo electrónico e integración con servicios de Google.",
  },
  {
    icon: "05",
    title: "Portal de empleo",
    description:
      "Consulta de vacantes y envío de candidaturas a la barbería.",
  },
  {
    icon: "06",
    title: "Fidelización",
    description:
      "Sistema de recompensas, descuentos y reglas asociadas al comportamiento del cliente.",
  },
];

const adminFeatures = [
  {
    number: "01",
    title: "Panel de administración",
    text:
      "Acceso para el personal de la barbería con un entorno de gestión propio.",
  },
  {
    number: "02",
    title: "Control de citas",
    text:
      "Consulta, edición y cancelación de reservas, con estados como pendiente, completada o ausencia.",
  },
  {
    number: "03",
    title: "Análisis económico",
    text:
      "Información de ganancias y estadísticas mensuales para conocer la evolución del negocio.",
  },
  {
    number: "04",
    title: "Comunicación interna",
    text:
      "Publicación de noticias y avisos para mejorar la organización.",
  },
  {
    number: "05",
    title: "Gestión de candidaturas",
    text:
      "Revisión de solicitudes recibidas desde el portal de empleo.",
  },
  {
    number: "06",
    title: "Gestión del negocio",
    text:
      "Administración de servicios y otros elementos operativos desde una plataforma centralizada.",
  },
];

const architecture = [
  {
    number: "01",
    name: "React",
    role: "INTERFAZ",
    text: "Componentes JSX y experiencia interactiva.",
  },
  {
    number: "02",
    name: "Inertia.js",
    role: "CONEXIÓN",
    text: "Comunicación entre las vistas y Laravel.",
  },
  {
    number: "03",
    name: "Laravel 10",
    role: "SERVIDOR",
    text: "Rutas, controladores y lógica de negocio.",
  },
  {
    number: "04",
    name: "PostgreSQL",
    role: "DATOS",
    text: "Persistencia y relaciones de la aplicación.",
  },
];
---

<MainLayout
  title="Desarrollo web | Marco Sánchez"
  description="Experiencia de Marco Sánchez en desarrollo frontend, backend y bases de datos. Prácticas en Rentel Comunicaciones y proyecto Barber's 18 desarrollado con Laravel, React e Inertia.js."
>

  <!-- BARRA DE PROGRESO DE LECTURA -->

  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <!-- ======================================= -->
  <!--              HERO                     -->
  <!-- ======================================= -->

  <section class="dev-hero" aria-labelledby="dev-title">

    <div class="hero-grid-pattern" aria-hidden="true"></div>
    <div class="hero-ambient-light" aria-hidden="true"></div>

    <div class="container hero-layout">

      <div class="hero-copy">

        <div class="eyebrow-badge">
          <span class="status-pulse"></span>
          MI PERFIL TÉCNICO
        </div>

        <p class="hero-kicker">
          DESARROLLO WEB · FRONTEND · BACKEND
        </p>

        <h1 id="dev-title">
          Del problema
          <span>a la solución.</span>
          <em>Del diseño al código.</em>
        </h1>

        <p class="hero-description">
          Para mí, programar no es solo escribir instrucciones.
          Es comprender una necesidad, plantear una solución
          y construir algo que realmente funcione.
        </p>

        

        <div class="hero-pills">
          <span><i></i> Full Stack</span>
          <span>Frontend</span>
          <span>Backend</span>
          <span>Bases de datos</span>
          <span>Integraciones</span>
        </div>

        <div class="hero-actions">

          <a href="#barbers18" class="button primary-button">
            Descubrir Barber’s 18
            <span aria-hidden="true">↗</span>
          </a>

          <a href="#experiencia" class="button secondary-button">
            Mi experiencia
            <span aria-hidden="true">↓</span>
          </a>

        </div>

      </div>

      <!-- PANEL VISUAL DE DESARROLLO -->

      <div class="hero-editor">

        <div class="editor-window">

          <div class="editor-top">
            <div class="window-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="editor-tab">
              <strong>TS</strong>
              developer.ts
            </div>

            <span class="editor-status">● ACTIVE</span>
          </div>

          <div class="editor-content" aria-label="Ejemplo decorativo de código TypeScript">

            <div class="code-line">
              <span>01</span>
              <code><b>interface</b> Developer <em>{'{'}</em></code>
            </div>

            <div class="code-line">
              <span>02</span>
              <code>  name: <i>string</i>;</code>
            </div>

            <div class="code-line">
              <span>03</span>
              <code>  focus: <i>string[]</i>;</code>
            </div>

            <div class="code-line">
              <span>04</span>
              <code>  learning: <i>boolean</i>;</code>
            </div>

            <div class="code-line">
              <span>05</span>
              <code><em>{'}'}</em></code>
            </div>

            <div class="code-line empty-line">
              <span>06</span>
              <code>&nbsp;</code>
            </div>

            <div class="code-line">
              <span>07</span>
              <code><b>const</b> marco: Developer = <em>{'{'}</em></code>
            </div>

            <div class="code-line">
              <span>08</span>
              <code>  name: <strong>"Marco Sánchez"</strong>,</code>
            </div>

            <div class="code-line">
              <span>09</span>
              <code>  focus: [</code>
            </div>

            <div class="code-line">
              <span>10</span>
              <code>    <strong>"Frontend"</strong>,</code>
            </div>

            <div class="code-line">
              <span>11</span>
              <code>    <strong>"Backend"</strong>,</code>
            </div>

            <div class="code-line">
              <span>12</span>
              <code>    <strong>"Databases"</strong></code>
            </div>

            <div class="code-line">
              <span>13</span>
              <code>  ],</code>
            </div>

            <div class="code-line">
              <span>14</span>
              <code>  learning: <u>true</u></code>
            </div>

            <div class="code-line">
              <span>15</span>
              <code><em>{'}'}</em>;</code>
            </div>

          </div>

          <div class="editor-bottom">
            <span><i></i> Sin errores de compilación</span>
            <span>TypeScript · UTF-8</span>
          </div>

        </div>

        <div class="floating-tag floating-tag-top">
          <span class="floating-tag-icon">{"</>"}</span>

          <div>
            <strong>Desarrollo web</strong>
            <small>De la idea al producto</small>
          </div>
        </div>

        <div class="floating-tag floating-tag-bottom">
          <span class="floating-tag-check">✓</span>

          <div>
            <strong>Aprendizaje continuo</strong>
            <small>Construir · Probar · Mejorar</small>
          </div>
        </div>

      </div>

    </div>

    <a href="#experiencia" class="scroll-hint">
      <span class="scroll-icon" aria-hidden="true">↓</span>
      DESLIZA PARA EXPLORAR
    </a>

  </section>

  <!-- ======================================= -->
  <!--         NAVEGACIÓN DE SECCIONES        -->
  <!-- ======================================= -->

  <nav class="section-navigation" aria-label="Navegación de desarrollo">
    <div class="container section-nav-inner">

      <span class="section-nav-label">EXPLORAR /</span>

      <a href="#experiencia">Experiencia</a>
      <a href="#tecnologias">Tecnologías</a>
      <a href="#metodologia">Cómo trabajo</a>
      <a href="#barbers18" class="section-nav-featured">
        Barber’s 18 <span>↗</span>
      </a>

    </div>
  </nav>

  <!-- ======================================= -->
  <!--            EXPERIENCIA                -->
  <!-- ======================================= -->

  <section
    class="experience-section"
    id="experiencia"
    aria-labelledby="experience-title"
  >
    <div class="container">

      <div class="section-eyebrow" data-reveal>
        <span></span>
        01 / EXPERIENCIA PROFESIONAL
      </div>

      <div class="section-intro" data-reveal>
        <h2 id="experience-title">
          Aprender código
          <span>en un entorno real.</span>
        </h2>

        <p>
          Las prácticas fueron mi primer contacto
          con un entorno profesional de desarrollo web,
          más allá de los ejercicios y proyectos de clase.
        </p>
      </div>

      <!-- TARJETA PRINCIPAL RENTEL -->

      <div class="experience-highlight" data-reveal>

        <div class="experience-header">

          <div class="company-icon" aria-hidden="true">
            R<span>.</span>
          </div>

          <div class="company-heading">
            <span>PRÁCTICAS DE FORMACIÓN</span>
            <h3>Rentel Comunicaciones S. L.</h3>
            <p>Sanlúcar de Barrameda · Cádiz</p>
          </div>

          <span class="experience-date">
            OCT — DIC 2024
          </span>

        </div>

        <div class="experience-body">

          <div class="experience-main">

            <div class="role-label">
              <span class="role-dot"></span>
              DESARROLLO WEB FULL STACK
            </div>

            <h4>
              De la formación
              <span>a la práctica profesional.</span>
            </h4>

            <p>
              Realicé mi período de prácticas en: <br>
              <strong>Rentel Comunicaciones S.L;</strong>,
              una empresa de Sanlúcar de Barrameda
              vinculada a las telecomunicaciones
              y a la digitalización de negocios.
            </p>

            <p>
              La compañía ofrece soluciones digitales
              para empresas, incluyendo desarrollo de
              aplicaciones, automatización de procesos
              e integración de servicios.
            </p>

            <p>
              Durante mis prácticas trabajé en tareas
              relacionadas con el
              <strong>desarrollo frontend y backend</strong>,
              utilizando tecnologías como PHP y Laravel,
              además de herramientas y conocimientos
              relacionados con interfaces web, bases
              de datos y comunicación entre sistemas.
            </p>

            <div class="experience-links">
              <a
                href={rentelWebsite}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-link"
              >
                Conocer Rentel
                <span aria-hidden="true">↗</span>
              </a>

              <span class="experience-divider"></span>

              <span>14 OCT — 20 DIC 2024</span>
            </div>

          </div>

          <!-- RESUMEN LATERAL -->

          <aside class="experience-side">
            <div class="experience-side-top">
              <span>EXPERIENCIA / 001</span>
              <span class="gold-arrow">↗</span>
            </div>

            <div class="experience-side-center">
              <span class="side-code">{"</>"}</span>
              <h5>Full Stack</h5>
              <p>
                Comprender tanto lo que
                ve el usuario como lo
                que ocurre en el servidor.
              </p>
            </div>

            <div class="experience-side-bottom">
              <span>PHP</span>
              <span>Laravel</span>
              <span>SQL</span>
              <span>Git</span>
            </div>
          </aside>

        </div>

      </div>

      <!-- TAREAS DE PRÁCTICAS -->

      <div class="subsection-header" data-reveal>
        <div>
          <span class="small-label">
            MIS ÁREAS DE TRABAJO
          </span>

          <h3>
            Una aplicación tiene
            <span>muchas capas.</span>
          </h3>
        </div>

        <p>
          Durante esta etapa pude acercarme a distintas
          partes del desarrollo de aplicaciones web.
        </p>
      </div>

      <div class="practice-grid">

        {practiceTasks.map((task) => (
          <article class="practice-card" data-reveal>

            <div class="practice-card-top">
              <span>{task.number} / 04</span>
              <span class="practice-card-icon" aria-hidden="true">
                ↗
              </span>
            </div>

            <h4>{task.title}</h4>

            <p>{task.description}</p>

            <div class="practice-tags">
              {task.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

          </article>
        ))}

      </div>

      <div class="experience-note" data-reveal>
        <span class="note-icon">✦</span>

        <p>
          <strong>Lo que me aportaron las prácticas:</strong><br>

          Esta experiencia me permitió comprender que el desarrollo de software va mucho más allá de implementar funcionalidades. Un buen código debe ser limpio, estructurado, mantenible y escalable, siguiendo buenas prácticas que faciliten su comprensión, modificación y evolución. Considero fundamental desarrollar soluciones que no solo respondan a las necesidades actuales, sino que también permitan incorporar nuevas funcionalidades y simplifiquen el trabajo de los futuros desarrolladores que deban mantener o ampliar el proyecto.
        </p>
      </div>

    </div>
  </section>

  <!-- ======================================= -->
  <!--            TECNOLOGÍAS                -->
  <!-- ======================================= -->

  <section
    class="skills-section"
    id="tecnologias"
    aria-labelledby="skills-title"
  >
    <div class="container">

      <div class="section-eyebrow" data-reveal>
        <span></span>
        02 / CONOCIMIENTOS TÉCNICOS
      </div>

      <div class="section-intro" data-reveal>
        <h2 id="skills-title">
          Mis herramientas
          <span>para construir.</span>
        </h2>

        <p>
          Estas son tecnologías que he estudiado,
          utilizado o explorado durante mi formación
          y mis proyectos. No todas representan
          experiencia laboral profesional.
        </p>
      </div>

      <div class="skills-grid">

        {skillGroups.map((group) => (
          <article class="skill-card" data-reveal>

            <div class="skill-card-top">
              <span>{group.number} / 03</span>
              <span class="skill-symbol">
                {group.number === "01"
                  ? "</>"
                  : group.number === "02"
                    ? "{ }"
                    : "DB"}
              </span>
            </div>

            <h3>{group.name}</h3>

            <p>{group.description}</p>

            <div class="skill-tags">
              {group.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>

          </article>
        ))}

      </div>

      <!-- VISIÓN FULL STACK -->

      <div class="fullstack-banner" data-reveal>

        <div class="fullstack-code" aria-hidden="true">
          {"<"}
          <span>fullstack</span>
          {"/>"}
        </div>

        <div class="fullstack-text">
          <span>MI ENFOQUE</span>

          <h3>
            Entender el sistema completo.
          </h3>

          <p>
            Una interfaz puede ser atractiva, pero necesita
            una lógica sólida detrás. Y un backend bien
            construido también necesita una experiencia
            de usuario clara. Me interesa aprender
            cómo se conectan ambas partes.
          </p>
        </div>

        <span class="banner-arrow" aria-hidden="true">
          ↗
        </span>

      </div>

    </div>
  </section>

  <!-- ======================================= -->
  <!--         RESOLUCIÓN DE PROBLEMAS        -->
  <!-- ======================================= -->

  <section
    class="method-section"
    id="metodologia"
    aria-labelledby="method-title"
  >
    <div class="container">

      <div class="section-eyebrow" data-reveal>
        <span></span>
        03 / FORMA DE TRABAJAR
      </div>

      <div class="section-intro" data-reveal>
        <h2 id="method-title">
          Cuando algo falla,
          <span>empieza el aprendizaje.</span>
        </h2>

        <p>
          Resolver errores es parte del desarrollo.
          Más importante que memorizar una solución
          es aprender a investigar por qué se produce.
        </p>
      </div>

      <div class="method-layout">

        <div class="method-sticky" data-reveal>

          <div class="method-terminal">

            <div class="terminal-top">
              <span class="terminal-dot"></span>
              <span>debugging.log</span>
              <span>●</span>
            </div>

            <div class="terminal-body">
              <p><span>01</span> <b>const</b> issue = detect();</p>
              <p><span>02</span> <b>const</b> cause = investigate(issue);</p>
              <p><span>03</span> <b>const</b> fix = implement(cause);</p>
              <p><span>04</span> <b>const</b> result = test(fix);</p>
              <p><span>05</span> <strong>console.log("Solved ✓");</strong></p>
            </div>

            <div class="terminal-bottom">
              <span class="terminal-success">● SISTEMA EN REVISIÓN</span>
              <span>DEBUG / 04</span>
            </div>

          </div>

          <p class="method-side-caption">
            Un esquema de cómo abordo los problemas;
            no es código de una aplicación real.
          </p>

        </div>

        <div class="method-steps">

          {problemSteps.map((step) => (
            <article class="method-step" data-reveal>

              <span class="method-number">{step.number}</span>

              <h3>{step.title}</h3>

              <p>{step.text}</p>

              <div class="method-tools">
                <span>{step.tool}</span>
              </div>

            </article>
          ))}

        </div>

      </div>

      <div class="method-conclusion" data-reveal>
        <span class="conclusion-mark">“</span>

        <p>
          Un error no se resuelve solamente haciendo
          que desaparezca. Hay que comprender
          qué lo provocó para evitar repetirlo.
        </p>
        <span class="conclusion-mark">”</span>
      </div>

    </div>
  </section>

  <!-- ======================================= -->
  <!--       PROYECTO PRINCIPAL BARBER'S 18   -->
  <!-- ======================================= -->

  <section
    class="project-section"
    id="barbers18"
    aria-labelledby="project-title"
  >

    <div class="project-bg-grid" aria-hidden="true"></div>

    <div class="container">

      <div class="section-eyebrow" data-reveal>
        <span></span>
        04 / PROYECTO DESTACADO
      </div>

      <div class="project-heading" data-reveal>

        <div class="project-heading-left">

          <div class="project-top-badges">
            <span class="project-status">
              PROYECTO REAL
            </span>

            <span class="project-academic">
              TRABAJO FIN DE GRADO
            </span>
          </div>

          <h2 id="project-title">
            Barber’s <span>18.</span>
          </h2>

          <p class="project-headline">
            Una barbería. Una plataforma.
            Toda la gestión conectada.
          </p>

        </div>

        <div class="project-score">
          <span>CALIFICACIÓN TFG</span>

          <strong>10<span>/10</span></strong>

          <small>PROYECTO FINAL DE GRADO</small>
        </div>

      </div>

      <div class="project-intro" data-reveal>

        <p>
          <strong>Barber’s 18</strong> es mi proyecto final
          del Grado Superior de Desarrollo de Aplicaciones Web.
          Una aplicación diseñada para gestionar digitalmente
          el funcionamiento de una barbería desde dos perspectivas:
          <strong>los clientes y los administradores.</strong>
        </p>

        <p>
