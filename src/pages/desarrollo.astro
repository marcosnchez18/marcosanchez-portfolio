    background: #80b497;
  }

  .editor-tab {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: 9px;
    padding: 0 15px;
    border-top: 2px solid #d7a65c;
    background: #171b22;
    color: #dfe3e9;
    font-family: Consolas,monospace;
    font-size: .77rem;
  }

  .editor-tab strong {
    color: #83bde8;
  }

  .editor-status {
    margin-left: auto;
    color: #9bc9a8;
    font-family: Consolas,monospace;
    font-size: .64rem;
    white-space: nowrap;
  }

  .editor-content {
    padding: 24px 9px 34px;
    overflow: hidden;
  }

  .code-line {
    display: grid;
    grid-template-columns: 40px minmax(0,1fr);
    gap: 8px;
    font-family: Consolas,"Courier New",monospace;
    font-size: clamp(.68rem,.95vw,.85rem);
    line-height: 2.15;
    white-space: pre;
  }

  .code-line > span {
    color: #6f7d91;
    text-align: center;
    user-select: none;
  }

  .code-line code {
    color: #cbd2df;
    font-family: inherit;
  }

  .code-line b {
    color: #bc9cec;
    font-weight: 500;
  }

  .code-line i {
    color: #82c4df;
    font-style: normal;
  }

  .code-line em {
    color: #dfb570;
    font-style: normal;
  }

  .code-line strong {
    color: #a3d8b1;
    font-weight: 500;
  }

  .code-line u {
    color: #e4ae79;
    text-decoration: none;
  }

  .editor-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 16px;
    border-top: 1px solid #343943;
    background: #20252d;
    color: #959eab;
    font-family: Consolas,monospace;
    font-size: .63rem;
  }

  .editor-bottom i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: #82be97;
  }

  .floating-tag {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid #464953;
    border-radius: 11px;
    background: #232730;
    box-shadow: 0 14px 35px rgba(0,0,0,.35);
  }

  .floating-tag-top {
    top: 0;
    right: -12px;
  }

  .floating-tag-bottom {
    left: -14px;
    bottom: 0;
  }

  .floating-tag-icon,
  .floating-tag-check {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(215,166,92,.1);
    color: #d7a65c;
    font-size: .85rem;
    font-weight: 800;
  }

  .floating-tag-check {
    color: #a0d5b0;
  }

  .floating-tag strong,
  .floating-tag small {
    display: block;
  }

  .floating-tag strong {
    color: #ecedf1;
    font-size: .77rem;
  }

  .floating-tag small {
    margin-top: 5px;
    color: #9da5b1;
    font-size: .65rem;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
    color: #8c95a2;
    font-size: .63rem;
    letter-spacing: .17em;
    text-decoration: none;
    white-space: nowrap;
  }

  .scroll-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 29px;
    border: 1px solid #777065;
    border-radius: 999px;
    color: #d7a65c;
    animation: arrow-bob 2s ease-in-out infinite;
  }

  @keyframes arrow-bob {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ====================================== */
  /*        NAVEGACIÓN DE SECCIONES        */
  /* ====================================== */

  .section-navigation {
    position: sticky;
    top: 84px;
    z-index: 50;
    border-block: 1px solid #30343e;
    background: rgba(24,28,35,.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .section-nav-inner {
    display: flex;
    align-items: center;
    gap: 30px;
    min-height: 65px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .section-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .section-nav-label {
    flex-shrink: 0;
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: .73rem;
    letter-spacing: .1em;
  }

  .section-nav-inner a {
    flex-shrink: 0;
    color: #b4bbc6;
    font-size: .8rem;
    font-weight: 600;
    text-decoration: none;
    transition: color .2s ease;
  }

  .section-nav-inner a:hover,
  .section-nav-inner a.section-nav-featured {
    color: #e0b173;
  }

  .section-nav-featured span {
    margin-left: 4px;
  }

  /* ====================================== */
  /*           CABECERAS COMUNES           */
  /* ====================================== */

  .experience-section,
  .skills-section,
  .method-section,
  .project-section {
    scroll-margin-top: 155px;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 23px;
    color: #d7a65c;
    font-size: .69rem;
    font-weight: 750;
    letter-spacing: .18em;
  }

  .section-eyebrow > span {
    display: inline-block;
    width: 30px;
    height: 1px;
    background: #d7a65c;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: end;
    gap: 55px;
    margin-bottom: 55px;
  }

  .section-intro h2,
  .project-heading h2,
  .closing-section h2 {
    margin: 0;
    color: #f0f1f3;
    font-family: Inter,Arial,Helvetica,sans-serif;
    font-size: clamp(2.65rem,4.4vw,4.9rem);
    font-weight: 760;
    line-height: 1.12;
    letter-spacing: -.058em;
  }

  .section-intro h2 span,
  .closing-section h2 span {
    display: block;
    color: #d7a65c;
  }

  .section-intro > p {
    max-width: 470px;
    margin: 0 0 6px;
    color: #aeb6c2;
    font-size: .98rem;
    line-height: 1.85;
  }

  .small-label {
    display: block;
    margin-bottom: 15px;
    color: #d7a65c;
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .17em;
  }

  /* ====================================== */
  /*             EXPERIENCIA               */
  /* ====================================== */

  .experience-section {
    padding: 120px 0 125px;
    background: #101216;
  }

  .experience-highlight {
    overflow: hidden;
    border: 1px solid rgba(215,166,92,.34);
    border-radius: 17px;
    background: #191d24;
  }

  .experience-header {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px 30px;
    border-bottom: 1px solid #343944;
    background: #20242c;
  }

  .company-icon {
    display: grid;
    place-items: center;
    width: 59px;
    height: 59px;
    flex-shrink: 0;
    border: 1px solid #7a664a;
    border-radius: 12px;
    background: #2b2c2b;
    color: #f2f3f4;
    font-size: 1.6rem;
    font-weight: 800;
  }

  .company-icon span {
    color: #d7a65c;
  }

  .company-heading {
    flex: 1;
    min-width: 0;
  }

  .company-heading > span {
    color: #d7a65c;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .company-heading h3 {
    margin: 6px 0 5px;
    color: #f0f1f3;
    font-size: clamp(1.1rem,1.6vw,1.5rem);
    font-weight: 700;
  }

  .company-heading p {
    margin: 0;
    color: #9fa8b4;
    font-size: .8rem;
  }

  .experience-date {
    flex-shrink: 0;
    padding: 9px 12px;
    border: 1px solid #454952;
