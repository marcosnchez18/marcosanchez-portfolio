---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Marco Sánchez | Desarrollo Web y Arte"
  description="Portfolio de Marco Sánchez, desarrollador web y artista. Descubre sus proyectos de desarrollo web, programación y obras de arte."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-background" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>DESARROLLO WEB CREATIVO</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>
        <h1 id="hero-title" aria-label="Arte y programación en perfecta armonía">
          <span class="title-desktop" aria-hidden="true">Arte y programación<br />en perfecta <em>armonía</em></span>
          <span class="title-mobile" aria-hidden="true">
            <span>Arte y</span><span>programación</span><span>en perfecta</span><em>armonía</em>
          </span>
        </h1>
        <p class="hero-description">
          Soy Marco Sánchez, desarrollador web que combina código limpio,
          diseño cuidado y una profunda sensibilidad artística.
        </p>
        <div class="hero-meta" aria-label="Mis disciplinas">
          <span>Diseño</span><span>Desarrollo</span><span>IA</span><span>Arte</span>
        </div>
        <div class="hero-actions">
          <a href="/proyectos" class="btn btn-primary"><span aria-hidden="true">&lt;/&gt;</span> Ver proyectos</a>
          <a href="/arte" class="btn btn-secondary"><span aria-hidden="true">✦</span> Explorar arte</a>
        </div>
      </div>
    </div>
    <a href="#presentacion" class="scroll-indicator" aria-label="Ir a la presentación"><span aria-hidden="true"></span></a>
  </section>

  <section id="presentacion" class="intro-section">
    <div class="intro-container">
      <span class="intro-label">DOS DISCIPLINAS, UNA VISIÓN</span>
      <h2><span>Donde la creatividad </span><em>encuentra al código.</em></h2>
      <p>Exploro la conexión entre el desarrollo web y el arte, combinando tecnología, estética y atención al detalle.</p>
    </div>
  </section>

  <!-- CHATBOT GRATUITO: no usa API ni envía los mensajes a ningún servidor -->
  <div class="chat-widget" id="marco-chat">
    <section class="chat-panel" id="chat-panel" aria-label="Asistente virtual de Marco" aria-hidden="true" hidden>
      <div class="chat-header">
        <div class="chat-avatar" aria-hidden="true">MS</div>
        <div class="chat-heading">
          <strong>Asistente de Marco</strong>
          <span>Respuestas rápidas · Gratuito</span>
        </div>
        <button type="button" class="chat-close" id="chat-close" aria-label="Cerrar chat">×</button>
      </div>
      <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-relevant="additions text">
        <div class="chat-bubble bot-bubble">¡Hola! 👋 Soy el asistente virtual de Marco. ¿Necesitas una página web, un cuadro realista al óleo o quieres conocer el trabajo de Marco? Puedo orientarte y ayudarte a pedir un presupuesto por WhatsApp.</div>
      </div>
      <div class="chat-suggestions" id="chat-suggestions" aria-label="Preguntas frecuentes">
        <button type="button" data-question="¿Haces páginas web por encargo?">Crear mi web</button>
        <button type="button" data-question="¿Cuánto cuesta una página web?">Presupuesto web</button>
        <button type="button" data-question="¿Haces cuadros al óleo por encargo?">Pintura al óleo</button>
        <button type="button" data-question="¿Qué tipos de páginas web haces?">Tipos de webs</button>
        <button type="button" data-question="¿Qué incluye una web?">Qué incluye</button>
        <button type="button" data-question="¿Trabajas con clientes internacionales?">Clientes internacionales</button>
        <button type="button" data-question="¿Qué tecnologías conoce Marco?">Tecnologías</button>
      </div>
      <form class="chat-form" id="chat-form">
        <label for="chat-input" class="sr-only">Escribe tu pregunta</label>
        <input id="chat-input" name="question" type="text" placeholder="Escribe tu pregunta..." maxlength="280" autocomplete="off" required />
        <button type="submit" aria-label="Enviar mensaje">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </form>
      <p class="chat-disclaimer">Asistente automático con respuestas preparadas. No es IA generativa.</p>
    </section>
    <button type="button" class="chat-toggle" id="chat-toggle" aria-label="Abrir asistente virtual" aria-expanded="false" aria-controls="chat-panel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
      <span>¿Hablamos?</span>
    </button>
  </div>
</MainLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .hero, .hero * { box-sizing: border-box; }
  .hero { position: relative; display: flex; align-items: center; min-height: calc(100svh - 95px); overflow: hidden; isolation: isolate; background: #100d0b; }
  .hero-background { position: absolute; inset: 0; z-index: -2; background-image: url('/images/hero-desktop.png'); background-size: cover; background-position: center; background-repeat: no-repeat; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12,10,9,.76) 0%, rgba(12,10,9,.40) 37%, rgba(12,10,9,0) 68%); pointer-events: none; }
  .hero-container { width: min(calc(100% - 80px),1450px); margin-inline: auto; padding-block: 100px 130px; }
  .hero-content { max-width: 740px; }
  .hero-eyebrow { display:flex; align-items:center; gap:20px; margin-bottom:32px; color:#d8c7b5; font-size:.78rem; font-weight:500; letter-spacing:.25em; }
  .hero-eyebrow > span:nth-child(2) { white-space:nowrap; }
  .eyebrow-line { width:55px; height:1px; flex-shrink:0; background:#d7a65c; }
  h1 { margin:0; color:#e9ddd1; font-family:Georgia,'Times New Roman',serif; font-size:clamp(3.2rem,5vw,5.6rem); line-height:1.12; font-weight:400; letter-spacing:-.045em; text-wrap:balance; }
  h1 em { color:#dfa85e; font-weight:400; }
  .title-desktop { display:block; }
  .title-mobile { display:none; }
  .hero-description { max-width:580px; margin-top:32px; color:#d7cbc0; font-size:clamp(1rem,1.5vw,1.3rem); line-height:1.7; }
  .hero-meta { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
  .hero-meta span { padding:8px 14px; border:1px solid rgba(224,177,115,.28); border-radius:999px; background:rgba(224,177,115,.08); color:#d8c7b5; font-size:.82rem; letter-spacing:.04em; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:22px; margin-top:40px; }
  .btn { min-height:60px; display:inline-flex; align-items:center; justify-content:center; gap:14px; padding:15px 30px; border:1px solid transparent; border-radius:10px; font-size:1rem; font-weight:500; text-decoration:none; transition:background 250ms ease,border-color 250ms ease,transform 250ms ease,box-shadow 250ms ease; }
  .btn:hover { transform:translateY(-3px); }
  .btn:focus-visible { outline:2px solid #f0c58c; outline-offset:4px; }
  .btn-primary { background:#e0b173; color:#17110b; }
  .btn-primary:hover { background:#f0c58c; box-shadow:0 8px 28px rgba(224,177,115,.18); }
  .btn-secondary { border-color:#cbb69c; color:#f0e4d6; background:rgba(15,12,10,.45); }
  .btn-secondary:hover { border-color:#e0b173; background:rgba(224,177,115,.1); }
  .scroll-indicator { position:absolute; bottom:32px; left:50%; transform:translateX(-50%); padding:12px; }
  .scroll-indicator span { display:block; width:15px; height:15px; border-right:2px solid #e4d1b8; border-bottom:2px solid #e4d1b8; transform:rotate(45deg); }
  .intro-section { padding:120px 24px; background:#120e0c; text-align:center; scroll-margin-top:95px; }
  .intro-container { max-width:850px; margin-inline:auto; }
  .intro-label { color:#d9a965; font-size:.75rem; letter-spacing:.28em; }
  .intro-section h2 { margin:30px 0; color:#e9ddd1; font-family:Georgia,'Times New Roman',serif; font-size:clamp(2.4rem,5vw,4.5rem); font-weight:400; line-height:1.2; text-wrap:balance; }
  .intro-section h2 em { display:block; margin-top:6px; color:#d9a965; font-weight:400; }
  .intro-section p { max-width:650px; margin-inline:auto; color:#b9aaa0; font-size:1.1rem; line-height:1.8; }
  /* CHAT */
  .chat-widget, .chat-widget * { box-sizing:border-box; }
  .chat-widget { position:fixed; right:24px; bottom:24px; z-index:1000; font-family:Arial,Helvetica,sans-serif; }
  .chat-toggle { display:flex; align-items:center; gap:10px; padding:14px 18px; border:1px solid #efc791; border-radius:999px; background:#e0b173; color:#17110b; font-size:14px; font-weight:700; cursor:pointer; box-shadow:0 8px 28px rgba(0,0,0,.38); transition:transform .2s ease,background .2s ease; }
  .chat-toggle:hover { background:#f0c58c; transform:translateY(-2px); }
  .chat-toggle svg { width:22px; height:22px; }
  .chat-panel { position:absolute; right:0; bottom:calc(100% + 14px); width:min(370px,calc(100vw - 28px)); height:min(520px,calc(100dvh - 115px)); display:flex; flex-direction:column; overflow:hidden; background:#130f0c; color:#efe1d3; border:1px solid rgba(215,166,92,.5); border-radius:18px; box-shadow:0 22px 65px rgba(0,0,0,.55); }
  .chat-panel[hidden] { display:none; }
  .chat-header { display:flex; align-items:center; gap:11px; padding:16px; background:#211810; border-bottom:1px solid rgba(215,166,92,.22); }
  .chat-avatar { display:grid; place-items:center; width:38px; height:38px; flex-shrink:0; border:1px solid #d7a65c; border-radius:50%; color:#e0b173; font-family:Georgia,serif; font-weight:700; }
  .chat-heading { display:flex; flex:1; flex-direction:column; gap:4px; }
  .chat-heading strong { color:#edc48e; font-size:14px; }
  .chat-heading span { color:#b4a79a; font-size:11px; }
  .chat-close { display:grid; place-items:center; width:32px; height:32px; background:transparent; color:#e0b173; border:0; font-size:28px; cursor:pointer; }
  .chat-messages { display:flex; flex:1; flex-direction:column; gap:12px; padding:16px; overflow:auto; overscroll-behavior:contain; }
  :global(.chat-bubble) { max-width:92%; padding:11px 13px; border-radius:13px; font-size:13px; line-height:1.55; overflow-wrap:anywhere; white-space:pre-wrap; }
  :global(.bot-bubble) { align-self:flex-start; background:#2a211a; color:#eee1d5; border:1px solid rgba(215,166,92,.12); }
  :global(.user-bubble) { align-self:flex-end; background:#e0b173; color:#17110b; }
  :global(.chat-page-link) { display:inline-block; align-self:flex-start; padding:9px 12px; border:1px solid rgba(215,166,92,.5); border-radius:10px; color:#edc48e; background:#271c13; font-size:13px; text-decoration:none; }
  :global(.chat-whatsapp) { display:inline-block; align-self:flex-start; padding:10px 12px; border:1px solid #6fb488; border-radius:10px; color:#c7f2d5; background:#17402b; font-size:13px; text-decoration:none; }
  .chat-suggestions { display:flex; flex-wrap:wrap; gap:7px; padding:0 13px 12px; }
  .chat-suggestions button { border:1px solid rgba(215,166,92,.42); border-radius:999px; padding:7px 10px; color:#e0b173; background:transparent; font-size:11px; cursor:pointer; }
  .chat-suggestions button:hover { background:rgba(215,166,92,.12); }
  .chat-form { display:flex; align-items:center; gap:8px; margin:0 12px; padding:6px; border:1px solid rgba(215,166,92,.4); border-radius:11px; background:#211a15; }
  .chat-form input { min-width:0; flex:1; padding:8px; border:0; outline:0; background:transparent; color:#fff; font-size:13px; }
  .chat-form input::placeholder { color:#9d9083; }
  .chat-form button { display:grid; place-items:center; width:34px; height:34px; border:0; border-radius:8px; background:#e0b173; color:#17110b; cursor:pointer; }
  .chat-form button svg { width:18px; height:18px; }
  .chat-disclaimer { margin:8px 10px 10px; text-align:center; color:#a89b8e; font-size:10px; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .chat-widget button:focus-visible, .chat-widget a:focus-visible, .chat-form:focus-within { outline:2px solid #f0c58c; outline-offset:2px; }
  @media (min-width:601px) and (max-width:1100px) {
    .hero { min-height:auto; display:flex; flex-direction:column; align-items:stretch; overflow:visible; }
    .hero-background { position:relative; inset:auto; z-index:auto; width:100%; height:370px; flex-shrink:0; background-size:cover; background-position:72% center; }
    .hero::before { display:none; }
    .hero-container { position:relative; z-index:2; width:100%; margin-top:-290px; margin-inline:auto; padding:0 24px 30px; background:transparent; }
    .hero-content { width:100%; max-width:720px; margin-inline:auto; padding:36px 32px; background:rgba(16,13,11,.94); border:1px solid rgba(215,166,92,.24); border-radius:24px; box-shadow:0 24px 60px rgba(0,0,0,.32); backdrop-filter:blur(5px); -webkit-backdrop-filter:blur(5px); }
    h1 { font-size:clamp(2.7rem,5.3vw,4rem); line-height:1.12; }
    .hero-eyebrow { gap:14px; font-size:.68rem; letter-spacing:.18em; }
    .eyebrow-line { width:36px; }
    .hero-description { max-width:620px; font-size:1.05rem; }
    .hero-actions { margin-top:28px; }
    .scroll-indicator { display:none; }
    .intro-section { padding:70px 28px; scroll-margin-top:78px; }
  }
  @media (max-width:600px) {
    .hero { min-height:auto; display:flex; flex-direction:column; align-items:stretch; overflow:visible; }
    .hero-background { position:relative; inset:auto; z-index:auto; width:100%; height:300px; flex-shrink:0; background-size:cover; background-position:74% center; }
    .hero::before { display:none; }
    .hero-container { position:relative; z-index:2; width:100%; margin-top:-282px; margin-inline:auto; padding:0 16px 8px; background:transparent; }
    .hero-content { position:relative; width:100%; max-width:100%; margin-inline:auto; padding:25px 20px 23px; background:rgba(16,13,11,.94); border:1px solid rgba(215,166,92,.24); border-radius:24px; box-shadow:0 24px 65px rgba(0,0,0,.4),0 0 30px rgba(215,166,92,.035); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px); }
    .hero-content::before { content:''; position:absolute; top:-1px; left:50%; transform:translateX(-50%); width:55%; height:1px; background:linear-gradient(90deg,transparent,rgba(224,177,115,.65),transparent); pointer-events:none; }
    .hero-eyebrow { justify-content:flex-start; gap:8px; margin-bottom:23px; font-size:.58rem; letter-spacing:.1em; }
    .eyebrow-line { width:18px; }
    h1 { font-size:clamp(2.2rem,9vw,2.65rem); line-height:1.12; letter-spacing:-.04em; text-wrap:initial; }
    .title-desktop { display:none; }
    .title-mobile { display:block; }
    .title-mobile > span, .title-mobile > em { display:block; }
    .title-mobile > em { color:#e0b173; font-style:italic; }
    .hero-description { max-width:100%; margin-top:24px; margin-bottom:0; color:#e0d4c7; font-size:.94rem; line-height:1.75; }
    .hero-meta { margin-top:23px; gap:9px; }
    .hero-meta span { padding:7px 12px; font-size:.72rem; border-color:rgba(224,177,115,.32); background:rgba(224,177,115,.09); }
    .hero-actions { flex-direction:column; gap:12px; margin-top:27px; }
    .btn { width:100%; min-height:54px; padding:14px 18px; font-size:.94rem; border-radius:10px; }
    .intro-section { padding:45px 22px 55px; scroll-margin-top:72px; }
    .intro-label { font-size:.65rem; letter-spacing:.22em; }
    .intro-section h2 { margin:24px 0; font-size:clamp(2.1rem,8vw,3rem); line-height:1.25; }
    .intro-section p { font-size:1rem; line-height:1.7; }
    .scroll-indicator { display:none; }
    .chat-widget { right:12px; bottom:12px; }
    .chat-toggle { padding:12px 15px; }
    .chat-panel { width:calc(100vw - 24px); height:min(520px,calc(100dvh - 100px)); }
  }
  @media (max-width:360px) {
    .hero-container { padding-inline:12px; }
    .hero-content { padding:22px 16px; }
    h1 { font-size:2rem; }
    .hero-eyebrow { gap:6px; font-size:.54rem; letter-spacing:.06em; }
    .eyebrow-line { width:12px; }
  }
  @media (prefers-reduced-motion:reduce) {
    :global(html) { scroll-behavior:auto; }
    .btn, .chat-toggle { transition:none; }
  }
</style>

<script>
  const widget = document.querySelector<HTMLElement>('#marco-chat');
  if (widget) {
    const toggle = widget.querySelector<HTMLButtonElement>('#chat-toggle');
    const close = widget.querySelector<HTMLButtonElement>('#chat-close');
    const panel = widget.querySelector<HTMLElement>('#chat-panel');
    const form = widget.querySelector<HTMLFormElement>('#chat-form');
    const input = widget.querySelector<HTMLInputElement>('#chat-input');
    const messages = widget.querySelector<HTMLElement>('#chat-messages');
    const suggestions = widget.querySelector<HTMLElement>('#chat-suggestions');
    const whatsAppBase = 'https://wa.me/34622541527?text=';
    const whatsappWeb = whatsAppBase + encodeURIComponent('Hola Marco, he visto tu portfolio y me gustaría pedirte un presupuesto de desarrollo web. Mi proyecto consiste en: ');
    const whatsappArte = whatsAppBase + encodeURIComponent('Hola Marco, he visto tu portfolio y me gustaría consultar un presupuesto para un cuadro realista al óleo. Puedo enviarte la foto de referencia, las medidas y los detalles.');
    const whatsappGeneral = whatsAppBase + encodeURIComponent('Hola Marco, he visitado tu portfolio y me gustaría hacerte una consulta.');

    function setOpen(open: boolean) {
      if (!panel || !toggle) return;
      panel.hidden = !open;
      panel.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar asistente virtual' : 'Abrir asistente virtual');
      if (open) input?.focus();
      else toggle.focus();
    }

    function addMessage(message: string, type: 'user' | 'bot') {
      if (!messages) return;
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble ${type === 'user' ? 'user-bubble' : 'bot-bubble'}`;
      bubble.textContent = message;
      messages.appendChild(bubble);
      messages.scrollTop = messages.scrollHeight;
    }

    function normalise(value: string) {
      return value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    }

    // Chat local: respuestas preparadas, sin servicios externos.
    // Prioriza intenciones comerciales específicas y mantiene separados web y pintura.
    function respond(question: string) {
      const q = normalise(question).replace(/[¿?¡!.,;:()]/g, ' ').replace(/\s+/g, ' ').trim();
      const has = (pattern: RegExp) => pattern.test(q);

      const webTopic = has(/\b(web|webs|pagina|paginas|sitio|sitios|landing|tienda|ecommerce|e commerce|comercio electronico|blog|blogs|portfolio|portafolio|aplicacion|aplicaciones|app|apps|software|frontend|backend|fullstack|full stack|diseno web|desarrollo web|programacion|programador|desarrollador|seo|dominio|hosting|mantenimiento|responsive|wordpress|negocio online|presencia online|web corporativa|reservas online)\b/);
      const artTopic = has(/\b(cuadro|cuadros|oleo|pintura|pinturas|pintar|pintas|pinta|lienzo|lienzos|retrato|retratos|paisaje|paisajes|obra de arte|obras de arte|arte|artista|realismo|realista|dibuj|ilustracion|pincel)\b/);
      const money = has(/\b(precio|precios|cuanto cuesta|cuanto vale|cuanto cobras|cuanto cobra|coste|costo|presupuesto|presupuestos|tarifa|tarifas|pagar|pago|euros|economico|barato|cotizacion|cotizar)\b/);
      const schedule = has(/\b(plazo|plazos|cuando|tardas|tarda|tiempo|disponibilidad|disponible|urgente|prisa|antelacion|meses|semanas|entrega|fecha|cuanto tard|para manana|para la semana)\b/);
      const contact = has(/\b(whatsapp|telefono|numero|contactar|contacto|hablar|escribir|llamar|contratar|contratacion|mensaje|reunir|reunion|consulta|consultar)\b/);
      const samples = has(/\b(ejemplos|muestras|trabajos|proyectos|galeria|ver cuadros|ver webs|ver ejemplos|portafolio|portfolio)\b/);
      const webService = has(/\b(hace|haces|realiza|realizas|crea|creas|disena|disenas|encargo|encargar|contratar|servicio|servicios|necesito|quiero|busco|montar|crear|hacer|ofreces|ofrece|puedes|puede|desarrollas|desarrolla)\b/);
      const artService = has(/\b(encargo|encargar|personalizado|personalizada|acepta|hace|pinta|puedes|puede|quiero|necesito|regalo|foto|fotografia|retrato|paisaje|copia|medidas|tamano|dimensiones|enviar|mandar)\b/);

      type Channel = 'web' | 'arte' | 'general' | null;
      let channel: Channel = null;
      let answer = '';
      let linkLabel = 'Hablar con Marco por WhatsApp ↗';
      let pageLink: { href: string; label: string } | null = null;

      // Dos servicios en la misma pregunta.
      if (webTopic && artTopic && (money || webService || artService || contact)) {
        answer = '¡Sí! Marco realiza páginas web por encargo y pinturas realistas al óleo. En ambos casos prepara presupuestos personalizados después de conocer los detalles, siempre por WhatsApp. Para pintura, solicita el encargo con varios meses de antelación.';
        channel = 'general';
      }
      // Encargos de pintura: prioridades específicas.
      else if (artTopic && money) {
        answer = 'El precio de un cuadro realista al óleo se consulta directamente con Marco por WhatsApp. Para elaborar un presupuesto adecuado, envíale una fotografía de referencia, las medidas deseadas y cualquier detalle importante. Los encargos deben plantearse con varios meses de antelación.';
        channel = 'arte';
        linkLabel = 'Consultar presupuesto de pintura ↗';
      } else if (artTopic && schedule) {
