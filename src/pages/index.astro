        channel = 'general';
      } else if (artTopic) {
        answer = 'Marco pinta obras realistas al óleo y acepta encargos. Para presupuestar pide una fotografía de referencia, medidas y características. Necesita varios meses de antelación; puedes ver obras en Arte o contactarlo por WhatsApp.';
        pageLink = { href: '/arte', label: 'Explorar arte ↗' };
        channel = 'arte';
      } else if (webTopic) {
        answer = 'Marco realiza páginas web por encargo para clientes de España y del extranjero. Puedes solicitar webs corporativas, portfolios, tiendas online, landing pages, blogs y aplicaciones a medida. Todos los presupuestos se consultan directamente por WhatsApp.';
        channel = 'web';
        pageLink = { href: '/proyectos', label: 'Ver proyectos ↗' };
      } else if (money) {
        answer = 'Los presupuestos se consultan únicamente por WhatsApp y se preparan según los detalles de cada servicio. ¿Te interesa una página web o un cuadro al óleo? Cuéntaselo a Marco para que pueda darte un presupuesto adecuado.';
        channel = 'general';
      } else if (contact) {
        answer = 'Para pedir información o un presupuesto de cualquier servicio, contacta directamente con Marco por WhatsApp: +34 622 541 527. Cuéntale qué necesitas y podrá valorar una propuesta adecuada.';
        channel = 'general';
      } else if (has(/\b(hola|buenas|buenos dias|buenas tardes|hey|saludos|hello)\b/)) {
        answer = '¡Hola! 😊 Puedo orientarte sobre desarrollo web por encargo, presupuestos, pintura realista al óleo, formación y experiencia de Marco. ¿Sobre qué te gustaría preguntar?';
      } else if (has(/\b(gracias|muchas gracias|adios|hasta luego|chao|bye)\b/)) {
        answer = '¡Gracias por visitar el portfolio! Si necesitas una web o una pintura realista al óleo, puedes escribirle a Marco por WhatsApp para pedir más información.';
      } else {
        answer = 'No tengo una respuesta confirmada a esa pregunta. Para información sobre cualquier servicio y conseguir un presupuesto adecuado a lo que necesitas, contacta directamente con Marco por WhatsApp. También puedo ayudarte con webs, pintura realista al óleo, experiencia y tecnologías.';
        channel = 'general';
      }

      addMessage(answer, 'bot');
      if (pageLink && messages) {
        const link = document.createElement('a');
        link.href = pageLink.href;
        link.className = 'chat-page-link';
        link.textContent = pageLink.label;
        messages.appendChild(link);
      }
      if (channel && messages) {
        const link = document.createElement('a');
        link.href = channel === 'web' ? whatsappWeb : channel === 'arte' ? whatsappArte : whatsappGeneral;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'chat-whatsapp';
        link.textContent = linkLabel;
        messages.appendChild(link);
      }
      if (messages) messages.scrollTop = messages.scrollHeight;
    }

    function submitQuestion(value: string) {
      const question = value.trim();
      if (!question) return;
      addMessage(question, 'user');
      respond(question);
      if (input) input.value = '';
      input?.focus();
    }

    toggle?.addEventListener('click', () => setOpen(Boolean(panel?.hidden)));
    close?.addEventListener('click', () => setOpen(false));
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      submitQuestion(input?.value ?? '');
    });
    suggestions?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-question]');
      if (button) submitQuestion(button.dataset.question ?? '');
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
    });
  }
</script>
