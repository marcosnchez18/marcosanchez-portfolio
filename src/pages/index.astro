
---
import MainLayout from "../layouts/MainLayout.astro";

const technologies = [
  "JavaScript",
  "TypeScript",
  "Astro",
  "React",
  "Angular",
  "PHP",
  "Laravel",
  "Python",
  "Java",
  "SQL",
  "Tailwind CSS",
];

const specialties = [
  {
    number: "01",
    icon: "</>",
    title: "Desarrollo frontend",
    description:
      "Creación de interfaces modernas, intuitivas y adaptadas a diferentes dispositivos. Me interesa que cada aplicación sea funcional y agradable de utilizar.",
    technologies: ["JavaScript", "TypeScript", "React", "Angular"],
  },
  {
    number: "02",
    icon: "{ }",
    title: "Desarrollo backend",
    description:
      "Desarrollo de la lógica de las aplicaciones, conexión con bases de datos, autenticación e integración de servicios mediante APIs.",
    technologies: ["Java", "PHP", "Laravel", "Python"],
  },
  {
    number: "03",
    icon: "↗",
    title: "Aprendizaje continuo",
    description:
      "La programación está en constante evolución. Mi objetivo es seguir aprendiendo, afrontar nuevos retos y mejorar con cada proyecto.",
    technologies: ["Git", "Astro", "APIs REST", "SEO"],
  },
];

const editorLines = [
  'const developer = {',
  '  name: "Marco Sánchez",',
  '  role: "Web Developer",',
  '  focus: [',
  '    "Frontend",',
  '    "Backend",',
  '    "Databases"',
  '  ],',
  '  mindset: "Keep learning",',
  '  passion: "Building ideas"',
  '};',
  '',
  'export default developer;',
];
---

<MainLayout
  title="Marco Sánchez | Desarrollador Web"
  description="Web personal de Marco Sánchez, Técnico Superior en Desarrollo de Aplicaciones Web. Descubre mis conocimientos, proyectos y trayectoria como desarrollador."
>

  <!-- ================================= -->
  <!--              HERO                 -->
  <!-- ================================= -->

  <section class="hero" aria-labelledby="hero-title">

    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-layout">

      <div class="hero-content">

        <div class="hero-label">
          <span class="hero-label-dot"></span>
          DESARROLLADOR WEB · MI ESPACIO PERSONAL
        </div>

        <p class="hero-eyebrow">
          HOLA, SOY MARCO SÁNCHEZ
        </p>

        <h1 id="hero-title">
          Construyendo
          <span>ideas a través</span>
          del código<span class="title-dot">.</span>
        </h1>

        <p class="hero-description">
          Soy Técnico Superior en Desarrollo de Aplicaciones Web.
          Me apasiona crear soluciones digitales, comprender
          cómo funciona la tecnología y seguir creciendo
          profesionalmente como desarrollador.
        </p>

        <!-- ETIQUETAS -->

        <div class="hero-tags" aria-label="Mis especialidades">

          <span class="tag tag-highlight">
            <span class="tag-dot"></span>
            Desarrollo web
          </span>

          <span class="tag">Frontend</span>
          <span class="tag">Backend</span>
          <span class="tag">APIs REST</span>
          <span class="tag">Bases de datos</span>

        </div>

        <div class="hero-actions">

          <a href="/proyectos" class="btn btn-primary">
            <span class="code-symbol" aria-hidden="true">
              &lt;/&gt;
            </span>
            Explorar mis proyectos
            <span aria-hidden="true">↗</span>
          </a>

          <a href="/sobre-mi" class="btn btn-secondary">
            Conocer mi trayectoria
            <span aria-hidden="true">→</span>
          </a>

        </div>

        <div class="hero-footnote">
          <span></span>
          DISEÑO · LÓGICA · APRENDIZAJE
        </div>

      </div>

      <!-- EDITOR DE CÓDIGO -->

      <div class="code-visual">

        <div class="code-glow" aria-hidden="true"></div>

        <div class="code-window">

          <div class="code-window-header">

            <div class="window-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="window-tab">
              <span>TS</span>
              marco.ts
            </div>

            <span class="window-folder">
              PERSONAL / DEV
            </span>

          </div>

          <div class="code-body" aria-hidden="true">

            {editorLines.map((line, index) => (
              <div class="editor-line">

                <span class="line-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span
                  class:list={[
                    "line-content",
                    {
                      "line-highlight": index === 0 || index === 12,
                      "line-string": [1, 2, 4, 5, 6, 8, 9].includes(index),
                    },
                  ]}
                >
                  {line || "\u00A0"}
                </span>

              </div>
            ))}

          </div>

          <div class="code-footer">

            <span class="code-status">
              <span>✓</span> TypeScript
            </span>

            <span>UTF-8</span>
            <span>Web Development</span>

          </div>

        </div>

        <div class="floating-card floating-top">

          <div class="floating-icon">✦</div>

          <div>
            <strong>Desarrollo web</strong>
            <small>Frontend &amp; Backend</small>
          </div>

        </div>

        <div class="floating-card floating-bottom">

          <div class="floating-icon floating-code">
            &lt;/&gt;
          </div>

          <div>
            <strong>Siempre aprendiendo</strong>
            <small>Una línea de código cada vez.</small>
          </div>

        </div>

      </div>

    </div>

    <a
      href="#especialidades"
      class="scroll-indicator"
      aria-label="Descubrir especialidades"
    >
      <span class="scroll-mouse" aria-hidden="true"></span>
      DESLIZA PARA EXPLORAR
    </a>

  </section>

  <!-- ================================= -->
  <!--           TECNOLOGÍAS             -->
  <!-- ================================= -->

  <section class="technology-section" aria-label="Tecnologías que conozco">

    <div class="container technologies-content">

      <span class="technology-label">
        MI STACK
      </span>

      <div class="technology-list">

        {technologies.map((technology) => (
          <span class="technology-item">
            {technology}
          </span>
        ))}

      </div>

    </div>

  </section>

  <!-- ================================= -->
  <!--          ESPECIALIDADES           -->
  <!-- ================================= -->

  <section
    class="specialties-section"
    id="especialidades"
    aria-labelledby="specialties-title"
  >

    <div class="container">

      <div class="section-label">
        <span></span>
        LO QUE ME INTERESA CONSTRUIR
      </div>

      <div class="section-heading">

        <h2 id="specialties-title">
          Del concepto
          <span>al código.</span>
        </h2>

        <p>
          Me gusta comprender las aplicaciones por dentro
          y por fuera: desde una interfaz hasta toda
          la lógica que hay detrás.
        </p>

      </div>

      <div class="specialties-grid">

        {specialties.map((specialty) => (

          <article class="specialty-card">

            <div class="specialty-card-top">

              <span class="specialty-number">
                {specialty.number} / 03
              </span>

              <div class="specialty-icon" aria-hidden="true">
                {specialty.icon}
              </div>

            </div>

            <div class="specialty-info">

              <h3>{specialty.title}</h3>

              <p>{specialty.description}</p>

            </div>

            <div class="specialty-technologies">

              {specialty.technologies.map((technology) => (
                <span>{technology}</span>
              ))}

            </div>

          </article>

        ))}

      </div>

    </div>

  </section>

  <!-- ================================= -->
  <!--           SOBRE MÍ                -->
  <!-- ================================= -->

  <section class="about-section" aria-labelledby="about-title">

    <div class="container about-layout">

      <div class="about-heading">

        <div class="section-label">
          <span></span>
          DETRÁS DEL DESARROLLADOR
        </div>

        <h2 id="about-title">
          Más que escribir código,
          <span>quiero entender y crear.</span>
        </h2>

      </div>

      <div class="about-content">

        <p>
          Mi formación en Desarrollo de Aplicaciones Web
          y mi experiencia profesional me han permitido
          conocer distintas formas de trabajar,
          resolver problemas y colaborar con otras personas.
        </p>

        <p>
          Actualmente continúo desarrollando mis
          conocimientos técnicos y explorando proyectos
          que me ayuden a crecer como desarrollador.
        </p>

        

      </div>

    </div>

  </section>

  <!-- ================================= -->
  <!--           PROYECTOS Y CV          -->
  <!-- ================================= -->

  <section class="projects-cta" aria-labelledby="projects-title">

    <div class="container projects-content">

      <div class="section-label section-label-center">
        <span></span>
        SIGUIENTE PASO
        <span></span>
      </div>

      <h2 id="projects-title">
        Las ideas se demuestran
        <span>con proyectos.</span>
      </h2>

      <p>
        Explora mis trabajos de desarrollo,
        descubre las tecnologías que utilizo
        y conoce el camino que sigo construyendo
        como profesional.
      </p>

      <div class="projects-buttons">

        <a href="/proyectos" class="btn btn-primary">
          Ver proyectos
          <span aria-hidden="true">↗</span>
        </a>

        <a
          href="/cv/Marco-Sanchez-CV.pdf"
          class="btn btn-secondary"
          download="Marco-Sanchez-CV.pdf"
        >
          Descargar mi CV
          <span aria-hidden="true">↓</span>
        </a>

      </div>

      <!-- ICONO GITHUB -->

      <div class="github-footer">

        <span class="github-line"></span>

        <a
          href="https://github.com/marcosnchez18"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visitar mi GitHub"
          title="Mi GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="34"
            height="34"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297a12 12 0 0 0-3.793 23.386c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.333-1.333-1.757-1.09-.745.082-.729.082-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.52 11.52 0 0 1 6.008 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297"/>
          </svg>
        </a>

        <span class="github-line"></span>

      </div>

    </div>

  </section>

  <!-- ================================= -->
  <!--      CHATBOT REDISEÑADO           -->
  <!-- ================================= -->

  <div class="chat-widget" id="marco-chat">

    <section
      class="chat-panel"
      id="chat-panel"
      aria-label="Asistente virtual de Marco"
      aria-hidden="true"
      hidden
    >

      <!-- CABECERA -->

      <header class="chat-header">

        <div class="chat-avatar" aria-hidden="true">
          MS
        </div>

        <div class="chat-heading">

          <strong>Asistente de Marco</strong>

          <span class="chat-online">
            <span class="online-dot"></span>
            Asistente virtual · Disponible
          </span>

        </div>

        <button
          type="button"
          class="chat-close"
          id="chat-close"
          aria-label="Cerrar chat"
          title="Cerrar"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>

      </header>

      <!-- CUERPO DEL CHAT -->

      <div
        class="chat-messages"
        id="chat-messages"
        role="log"
        aria-live="polite"
        aria-relevant="additions"
      >

        <div class="chat-bubble bot-bubble">
          ¡Hola! 👋 Soy el asistente virtual de Marco.

          Puedo ayudarte con sus proyectos de desarrollo web,
          tecnologías, experiencia profesional, servicios
          y encargos de pintura al óleo.

          ¿Qué te gustaría saber?
        </div>

      </div>

      <!-- PREGUNTAS RÁPIDAS -->

      <div class="chat-quick-label">
        PREGUNTAS FRECUENTES
      </div>

      <div
        class="chat-suggestions"
        id="chat-suggestions"
        aria-label="Preguntas frecuentes"
      >

        <button
          type="button"
          data-question="¿Haces páginas web por encargo?"
        >
          Crear mi web
        </button>

        <button
          type="button"
          data-question="¿Cuánto cuesta una página web?"
        >
          Presupuesto web
        </button>

        <button
          type="button"
          data-question="¿Qué tecnologías conoce Marco?"
        >
          Tecnologías
        </button>

        <button
          type="button"
          data-question="¿Qué experiencia profesional tiene Marco?"
        >
          Experiencia
        </button>

        <button
          type="button"
          data-question="¿Dónde puedo ver los proyectos?"
        >
          Proyectos
        </button>

        <button
          type="button"
          data-question="¿Haces cuadros al óleo por encargo?"
        >
          Pintura al óleo
        </button>

      </div>

      <!-- ENVIAR MENSAJE -->

      <form class="chat-form" id="chat-form">

        <label for="chat-input" class="sr-only">
          Escribe tu pregunta
        </label>

        <input
          id="chat-input"
          name="question"
          type="text"
          placeholder="Escribe tu pregunta..."
          maxlength="280"
          autocomplete="off"
          required
        />

        <button
          type="submit"
          aria-label="Enviar mensaje"
          title="Enviar mensaje"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </button>

      </form>

      <p class="chat-disclaimer">
        Respuestas automáticas · Sin IA generativa
      </p>

    </section>

    <!-- BOTÓN FLOTANTE -->

    <button
      type="button"
      class="chat-toggle"
      id="chat-toggle"
      aria-label="Abrir asistente virtual"
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3H13a8.48 8.48 0 0 1 8 8v.5Z"/>
      </svg>

      <span>¿Hablamos?</span>
    </button>

  </div>

</MainLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #101216;
  }

  .hero,
  .hero *,
  .technology-section,
  .technology-section *,
  .specialties-section,
  .specialties-section *,
  .about-section,
  .about-section *,
  .projects-cta,
  .projects-cta *,
  .chat-widget,
  .chat-widget * {
    box-sizing: border-box;
  }

  .container {
    width: min(calc(100% - 96px), 1360px);
    margin-inline: auto;
  }

  /* ================================= */
  /*             HERO                  */
  /* ================================= */

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(860px, calc(100svh - 84px));
    padding: 95px 0 110px;
    overflow: hidden;
    isolation: isolate;
    background: #101216;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(
        rgba(255,255,255,.026) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,.026) 1px,
        transparent 1px
      );
    background-size: 62px 62px;
    mask-image: linear-gradient(90deg, transparent, #000 50%);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 50%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: -110px;
    right: -180px;
    width: 800px;
    height: 800px;
    z-index: -1;
    background: radial-gradient(
      circle,
      rgba(215,166,92,.13),
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr);
    align-items: center;
    gap: clamp(40px,5vw,90px);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border: 1px solid rgba(215,166,92,.28);
    border-radius: 999px;
    background: rgba(215,166,92,.055);
    color: #d3bea2;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .12em;
  }

  .hero-label-dot,
  .tag-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #e0b173;
  }

  .hero-label-dot {
    box-shadow: 0 0 0 4px rgba(224,177,115,.12);
  }

  .hero-eyebrow {
    margin: 40px 0 18px;
    color: #b7a083;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .22em;
  }

  .hero h1 {
    margin: 0 0 28px;
    color: #f0f1f3;
    font-family: Inter, Arial, Helvetica, sans-serif;
    font-size: clamp(3.4rem,5.3vw,6.1rem);
    font-weight: 750;
    letter-spacing: -.065em;
    line-height: 1.06;
  }

  .hero h1 > span:not(.title-dot) {
    display: block;
    color: #d7a65c;
  }

  .title-dot {
    color: #d7a65c;
  }

  .hero-description {
    max-width: 570px;
    margin: 0;
    color: #b0b5be;
    font-size: clamp(1rem,1.25vw,1.12rem);
    line-height: 1.9;
  }

  /* ETIQUETAS */

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 30px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px;
    border: 1px solid #353840;
    border-radius: 999px;
    background: #1a1d23;
    color: #c1c5ce;
    font-size: .77rem;
    white-space: nowrap;
    transition:
      transform .2s ease,
      border-color .2s ease;
  }

  .tag:hover {
    transform: translateY(-2px);
    border-color: rgba(215,166,92,.65);
  }

  .tag-highlight {
    border-color: rgba(215,166,92,.4);
    background: rgba(215,166,92,.08);
    color: #e0b173;
  }

  /* BOTONES */

  .hero-actions,
  .projects-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 15px 23px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: .92rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform .2s ease,
      background .2s ease,
      border-color .2s ease;
  }

  .btn:hover {
    transform: translateY(-3px);
  }

  .btn-primary {
    background: #d7a65c;
    color: #13151a;
  }

  .btn-primary:hover {
    background: #ecc080;
  }

  .btn-secondary {
    border-color: #44464e;
    background: #1a1c21;
    color: #e4e5e8;
  }

  .btn-secondary:hover {
    border-color: #d7a65c;
    background: #24262c;
  }

  .code-symbol {
    font-family: Consolas, monospace;
    font-weight: 700;
  }

  .hero-footnote {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 50px;
    color: #808791;
    font-size: .66rem;
    font-weight: 600;
    letter-spacing: .18em;
  }

  .hero-footnote span {
    width: 30px;
    height: 1px;
    background: #b0844c;
  }

  /* ================================= */
  /*          EDITOR VISUAL            */
  /* ================================= */

  .code-visual {
    position: relative;
    padding: 40px 12px;
  }

  .code-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(215,166,92,.12),
      transparent 70%
    );
    filter: blur(25px);
    pointer-events: none;
  }

  .code-window {
    position: relative;
    overflow: hidden;
    border: 1px solid #44444c;
    border-radius: 16px;
    background: #171a20;
    box-shadow:
      0 35px 90px rgba(0,0,0,.5),
      0 0 0 8px rgba(255,255,255,.018);
    transform: rotate(-2deg);
    transition: transform .3s ease;
  }

  .code-window:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .code-window-header {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 53px;
    padding: 0 16px;
    border-bottom: 1px solid #32353d;
    background: #22252c;
  }

  .window-dots {
    display: flex;
    gap: 7px;
  }

  .window-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .window-dots span:nth-child(1) {
    background: #d27874;
  }

  .window-dots span:nth-child(2) {
    background: #d8b970;
  }

  .window-dots span:nth-child(3) {
    background: #7faf90;
  }

  .window-tab {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: 8px;
    padding: 0 15px;
    border-top: 2px solid #d7a65c;
    border-inline: 1px solid #343741;
    background: #171a20;
    color: #dce0e6;
    font-family: Consolas, monospace;
    font-size: .75rem;
  }

  .window-tab span {
    color: #83bce7;
    font-weight: 700;
  }

  .window-folder {
    margin-left: auto;
    color: #797f8a;
    font-family: Consolas, monospace;
    font-size: .64rem;
  }

  .code-body {
    padding: 28px 12px 35px;
    overflow: hidden;
  }

  .editor-line {
    display: grid;
    grid-template-columns: 38px minmax(0,1fr);
    color: #c7ccd5;
    font-family: Consolas, "Courier New", monospace;
    font-size: clamp(.65rem,.98vw,.86rem);
    line-height: 2.15;
    white-space: pre;
  }

  .line-number {
    color: #747b87;
    text-align: center;
    user-select: none;
  }

  .line-content {
    display: block;
    padding-left: 5px;
  }

  .line-highlight {
    color: #c5a2e5;
  }

  .line-string {
    color: #a6d4ac;
  }

  .code-footer {
    display: flex;
    justify-content: flex-end;
    gap: 16px;
    padding: 11px 17px;
    border-top: 1px solid #333741;
    background: #20232a;
    color: #9299a4;
    font-family: Consolas, monospace;
    font-size: .65rem;
  }

  .code-status {
    margin-right: auto;
  }

  .code-status span {
    color: #89c99e;
  }

  .floating-card {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid #414046;
    border-radius: 11px;
    background: #222329;
    box-shadow: 0 15px 40px rgba(0,0,0,.4);
  }

  .floating-card strong {
    display: block;
    color: #f0e7dc;
    font-size: .77rem;
  }

  .floating-card small {
    display: block;
    margin-top: 5px;
    color: #9ca2ae;
    font-size: .65rem;
  }

  .floating-top {
    top: 4px;
    right: -16px;
  }

  .floating-bottom {
    left: -15px;
    bottom: 4px;
  }

  .floating-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(215,166,92,.12);
    color: #e0b173;
    font-size: 1.1rem;
  }

  .floating-code {
    font-family: Consolas, monospace;
    font-size: .8rem;
    font-weight: 700;
  }

  .scroll-indicator {
    position: absolute;
    left: 50%;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
    color: #8d929c;
    font-size: .62rem;
    letter-spacing: .18em;
    text-decoration: none;
    white-space: nowrap;
  }

  .scroll-mouse {
    position: relative;
    display: block;
    width: 17px;
    height: 27px;
    border: 1px solid #79716b;
    border-radius: 12px;
  }

  .scroll-mouse::after {
    content: "";
    position: absolute;
    top: 6px;
    left: 7px;
    width: 1px;
    height: 7px;
    background: #d7a65c;
    animation: scrollmove 1.8s infinite;
  }

  @keyframes scrollmove {
    0%, 100% {
      transform: translateY(0);
      opacity: 1;
    }

    65% {
      transform: translateY(6px);
      opacity: .35;
    }
  }

  /* ================================= */
  /*          TECNOLOGÍAS              */
  /* ================================= */

  .technology-section {
    border-block: 1px solid #2c3037;
    background: #171a20;
  }

  .technologies-content {
    display: flex;
    align-items: center;
    gap: 30px;
    padding-block: 25px;
  }

  .technology-label {
    flex-shrink: 0;
    color: #d7a65c;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .technology-item {
    padding: 8px 12px;
    border: 1px solid #393d45;
    border-radius: 7px;
    color: #c2c7d0;
    font-size: .75rem;
  }

  /* ================================= */
  /*          ESPECIALIDADES           */
  /* ================================= */

  .specialties-section {
    padding: 125px 0;
    background: #101216;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    color: #d7a65c;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .section-label > span {
    width: 27px;
    height: 1px;
    background: #d7a65c;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: end;
    gap: 50px;
  }

  .section-heading h2,
  .about-heading h2,
  .projects-cta h2 {
    margin: 0;
    color: #f0f1f3;
    font-family: Inter, Arial, Helvetica, sans-serif;
    font-size: clamp(2.7rem,4.3vw,4.8rem);
    font-weight: 740;
    letter-spacing: -.055em;
    line-height: 1.13;
  }

  .section-heading h2 span,
  .about-heading h2 span,
  .projects-cta h2 span {
    display: block;
    color: #d7a65c;
  }

  .section-heading p {
    max-width: 430px;
    margin: 0 0 8px;
    color: #aab0bb;
    font-size: 1rem;
    line-height: 1.85;
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 18px;
    margin-top: 55px;
  }

  .specialty-card {
    display: flex;
    flex-direction: column;
    min-height: 365px;
    padding: 30px;
    border: 1px solid #313640;
    border-radius: 15px;
    background: #191d24;
    transition:
      transform .25s ease,
      border-color .25s ease;
  }

  .specialty-card:hover {
    transform: translateY(-5px);
    border-color: rgba(215,166,92,.5);
  }

  .specialty-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 60px;
  }

  .specialty-number {
    color: #89919d;
    font-family: Consolas, monospace;
    font-size: .75rem;
  }

  .specialty-icon {
    display: grid;
    place-items: center;
    min-width: 50px;
    height: 50px;
    padding-inline: 9px;
    border: 1px solid rgba(215,166,92,.3);
    border-radius: 10px;
    background: rgba(215,166,92,.07);
    color: #e0b173;
    font-family: Consolas, monospace;
    font-size: 1rem;
    font-weight: 700;
  }

  .specialty-info h3 {
    margin: 0 0 15px;
    color: #edf0f5;
    font-size: 1.37rem;
    letter-spacing: -.03em;
  }

  .specialty-info p {
    margin: 0;
    color: #a9b0bb;
    font-size: .9rem;
    line-height: 1.8;
  }

  .specialty-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding-top: 24px;
  }

  .specialty-technologies span {
    padding: 7px 9px;
    border-radius: 5px;
    background: #2b3038;
    color: #c9ced7;
    font-size: .69rem;
  }

  /* ================================= */
  /*            SOBRE MÍ               */
  /* ================================= */

  .about-section {
    padding: 125px 0;
    border-block: 1px solid #2c3037;
    background: #181b21;
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 90px;
  }

  .about-heading h2 {
    max-width: 650px;
  }

  .about-content p {
    margin: 0 0 18px;
    color: #aeb5c0;
    font-size: 1rem;
    line-height: 1.9;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid #d7a65c;
    color: #e0b173;
    font-size: .95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .text-link:hover {
    gap: 22px;
  }

  /* ================================= */
  /*           PROYECTOS / CV          */
  /* ================================= */

  .projects-cta {
    padding: 125px 0;
    background: #101216;
    text-align: center;
  }

  .projects-content {
    max-width: 850px;
  }

  .section-label-center {
    justify-content: center;
  }

  .projects-cta h2 {
    margin-bottom: 25px;
  }

  .projects-cta p {
    max-width: 640px;
    margin: 0 auto;
    color: #aeb5c0;
    font-size: 1rem;
    line-height: 1.85;
  }

  .projects-buttons {
    justify-content: center;
  }

  .github-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 65px;
  }

  .github-line {
    width: 38px;
    height: 1px;
    background: #454952;
  }

  .github-footer a {
    display: inline-flex;
    color: #d7a65c;
    transition:
      color .2s ease,
      transform .2s ease;
  }

  .github-footer a:hover {
    color: #edbe79;
    transform: translateY(-3px);
  }

  /* ================================= */
  /*    CHATBOT - ESTILO MODERNIZADO    */
  /* ================================= */

  .chat-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    font-family: Inter, Arial, Helvetica, sans-serif;
  }

  /* BOTÓN FLOTANTE */

  .chat-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 53px;
    padding: 13px 20px;
    border: 1px solid #e3b976;
    border-radius: 999px;
    background: #d7a65c;
    color: #111318;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    box-shadow:
      0 10px 32px rgba(0,0,0,.35),
      0 0 0 4px rgba(215,166,92,.04);
    transition:
      background .2s ease,
      transform .2s ease,
      box-shadow .2s ease;
  }

  .chat-toggle:hover {
    transform: translateY(-3px);
    background: #edbe79;
    box-shadow: 0 15px 35px rgba(0,0,0,.4);
  }

  .chat-toggle svg {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
  }

  /* VENTANA PRINCIPAL */

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    display: flex;
    flex-direction: column;
    width: min(385px,calc(100vw - 28px));
    height: min(540px,calc(100dvh - 115px));
    overflow: hidden;
    border: 1px solid #3a3f47;
    border-radius: 17px;
    background: #171a20;
    color: #e8eaee;
    box-shadow:
      0 25px 75px rgba(0,0,0,.55),
      0 0 0 1px rgba(255,255,255,.018);
  }

  .chat-panel[hidden] {
    display: none;
  }

  /* CABECERA ANTRACITA */

  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    min-height: 72px;
    padding: 14px 16px;
    border-bottom: 1px solid #353941;
    background: #20242b;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 41px;
    height: 41px;
    flex-shrink: 0;
    border: 1px solid rgba(215,166,92,.6);
    border-radius: 12px;
    background: rgba(215,166,92,.09);
    color: #e0b173;
    font-family: Inter, Arial, sans-serif;
    font-size: .9rem;
    font-weight: 800;
    letter-spacing: -.04em;
  }

  .chat-heading {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .chat-heading strong {
    color: #f0f1f3;
    font-size: 13px;
    font-weight: 750;
    letter-spacing: -.015em;
  }

  .chat-online {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #a8aeb8;
    font-size: 10px;
    font-weight: 500;
  }

  .online-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #8ab99c;
  }

  .chat-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #aeb4be;
    cursor: pointer;
    transition:
      background .2s ease,
      color .2s ease;
  }

  .chat-close:hover {
    background: #30353d;
    color: #f0f1f3;
  }

  .chat-close svg {
    width: 19px;
    height: 19px;
  }

  /* MENSAJES */

  .chat-messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 13px;
    min-height: 0;
    padding: 18px 15px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #464b55 transparent;
    background: #171a20;
  }

  :global(.chat-bubble) {
    max-width: 91%;
    width: fit-content;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 12.5px;
    line-height: 1.65;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  :global(.bot-bubble) {
    align-self: flex-start;
    border: 1px solid #383d47;
    border-top-left-radius: 4px;
    background: #292e37;
    color: #e8eaee;
  }

  :global(.user-bubble) {
    align-self: flex-end;
    border: 1px solid #d7a65c;
    border-bottom-right-radius: 4px;
    background: #d7a65c;
    color: #13151a;
    font-weight: 500;
  }

  /* ENLACES EN EL CHAT */

  :global(.chat-page-link),
  :global(.chat-whatsapp) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 8px;
    max-width: 100%;
    min-height: 36px;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background .2s ease,
      border-color .2s ease;
  }

  :global(.chat-page-link) {
    border: 1px solid rgba(215,166,92,.4);
    background: rgba(215,166,92,.07);
    color: #e0b173;
  }

  :global(.chat-page-link:hover) {
    border-color: #d7a65c;
    background: rgba(215,166,92,.14);
  }

  :global(.chat-whatsapp) {
    border: 1px solid #d7a65c;
    background: #d7a65c;
    color: #141619;
  }

  :global(.chat-whatsapp:hover) {
    border-color: #edbe79;
    background: #edbe79;
  }

  /* PREGUNTAS RÁPIDAS */

  .chat-quick-label {
    flex-shrink: 0;
    padding: 10px 15px 7px;
    border-top: 1px solid #30343c;
    color: #868d99;
    background: #1c2027;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 7px;
    flex-shrink: 0;
    padding: 4px 14px 12px;
    background: #1c2027;
  }

  .chat-suggestions button {
    min-height: 30px;
    padding: 7px 10px;
    border: 1px solid #414650;
    border-radius: 999px;
    background: #252a32;
    color: #d8ba8c;
    font-size: 10px;
    font-weight: 550;
    cursor: pointer;
    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease;
  }

  .chat-suggestions button:hover {
    border-color: rgba(215,166,92,.7);
    background: #303037;
    color: #f0c58c;
  }

  /* CAMPO DE TEXTO */

  .chat-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    min-height: 53px;
    margin: 0;
    padding: 9px 13px;
    border-top: 1px solid #353941;
    background: #20242b;
  }

  .chat-form input {
    flex: 1;
    min-width: 0;
    min-height: 39px;
    padding: 10px 12px;
    border: 1px solid #414650;
    border-radius: 9px;
    outline: none;
    background: #171a20;
    color: #f0f1f3;
    font-family: inherit;
    font-size: 12px;
    transition: border-color .2s ease;
  }

  .chat-form input:focus {
    border-color: #d7a65c;
  }

  .chat-form input::placeholder {
    color: #858c98;
  }

  .chat-form button {
    display: grid;
    place-items: center;
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    border: 1px solid #d7a65c;
    border-radius: 9px;
    background: #d7a65c;
    color: #15171b;
    cursor: pointer;
    transition: background .2s ease;
  }

  .chat-form button:hover {
    background: #edbe79;
  }

  .chat-form button svg {
    width: 18px;
    height: 18px;
  }

  .chat-disclaimer {
    flex-shrink: 0;
    margin: 0;
    padding: 0 12px 12px;
    background: #20242b;
    color: #858c98;
    font-size: 9px;
    line-height: 1.4;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* FOCUS */

  .chat-widget button:focus-visible,
  .chat-widget a:focus-visible,
  .chat-widget input:focus-visible,
  .btn:focus-visible,
  .text-link:focus-visible,
  .github-footer a:focus-visible {
    outline: 2px solid #edbe79;
    outline-offset: 3px;
  }

  /* ================================= */
  /*             TABLET                */
  /* ================================= */

  @media (max-width: 1150px) {
    .container {
      width: min(calc(100% - 56px),1000px);
    }

    .hero {
      min-height: auto;
      padding: 100px 0;
    }

    .hero-layout {
      gap: 35px;
    }

    .hero h1 {
      font-size: clamp(3rem,5.7vw,4.7rem);
    }

    .editor-line {
      font-size: .68rem;
    }

    .floating-top {
      right: 0;
    }

    .floating-bottom {
      left: 0;
    }

    .specialties-section,
    .about-section,
    .projects-cta {
      padding-block: 95px;
    }

    .about-layout {
      gap: 50px;
    }
  }

  @media (max-width: 850px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .hero-content {
      max-width: 720px;
    }

    .hero h1 {
      font-size: clamp(3.2rem,8vw,5.2rem);
    }

    .code-visual {
      width: min(100%,610px);
      margin-inline: auto;
    }

    .editor-line {
      font-size: .83rem;
    }

    .section-heading,
    .about-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .specialties-grid {
      grid-template-columns: 1fr 1fr;
    }

    .specialty-card:last-child {
      grid-column: 1 / -1;
      min-height: 280px;
    }

    .specialty-card-top {
      margin-bottom: 30px;
    }

    .scroll-indicator {
      display: none;
    }
  }

  /* ================================= */
  /*             MÓVILES               */
  /* ================================= */

  @media (max-width: 600px) {
    .container {
      width: calc(100% - 36px);
    }

    .hero {
      padding: 58px 0 65px;
    }

    .hero-label {
      max-width: 100%;
      padding: 9px 12px;
      font-size: .57rem;
      letter-spacing: .065em;
    }

    .hero-eyebrow {
      margin-top: 35px;
      font-size: .7rem;
      letter-spacing: .15em;
    }

    .hero h1 {
      font-size: clamp(2.65rem,10.3vw,4.1rem);
      letter-spacing: -.06em;
    }

    .hero-description {
      font-size: .96rem;
      line-height: 1.8;
    }

    .hero-tags {
      gap: 8px;
      margin-top: 26px;
    }

    .tag {
      padding: 7px 11px;
      font-size: .7rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 11px;
    }

    .btn {
      width: 100%;
      min-height: 54px;
    }

    .hero-footnote {
      margin-top: 33px;
      font-size: .56rem;
      letter-spacing: .1em;
    }

    .code-visual {
      padding: 20px 3px 35px;
    }

    .code-window {
      transform: none;
      border-radius: 11px;
    }

    .code-window:hover {
      transform: none;
    }

    .code-window-header {
      height: 47px;
      padding-inline: 11px;
    }

    .window-tab {
      padding-inline: 10px;
      font-size: .69rem;
    }

    .window-folder {
      display: none;
    }

    .code-body {
      padding: 20px 5px 23px;
    }

    .editor-line {
      grid-template-columns: 30px minmax(0,1fr);
      font-size: clamp(.54rem,2.35vw,.75rem);
      line-height: 2.1;
    }

    .line-content {
      padding-left: 2px;
    }

    .code-footer {
      gap: 9px;
