      // Perfil profesional y preguntas generales.
      else if (has(/\b(tecnologias|tecnologia|lenguajes|framework|frameworks|stack|astro|typescript|javascript|react|angular|laravel|python|php|java|c#|next|tailwind|postgresql|mysql|base de datos|codigo|git|github|css|html)\b/)) {
        answer = 'Marco es Técnico Superior en Desarrollo de Aplicaciones Web. En su perfil figuran JavaScript, PHP, Python, Java, C#, Laravel, React, Angular, Next.js, Tailwind CSS, PostgreSQL y MySQL, entre otras tecnologías. Utiliza además Astro y TypeScript en este portfolio.';
