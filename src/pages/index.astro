        channel = 'web';
      } else if (webTopic && webService) {
        answer = '¡Sí! Marco desarrolla webs por encargo: webs para negocios, portfolios, tiendas online, landing pages, blogs y aplicaciones a medida. El diseño y las funcionalidades se adaptan a cada proyecto. Para cualquier consulta o presupuesto, escríbele por WhatsApp; no hay precios fijos publicados.';
