
---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Marco Sánchez | Desarrollo Web y Arte"
  description="Portfolio de Marco Sánchez, desarrollador web y artista. Descubre proyectos de desarrollo web, creatividad digital y obras de arte."
>
  <!-- PORTADA PRINCIPAL -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-background" aria-hidden="true"></div>

    <div class="hero-container">
      <div class="hero-content">

        <div class="hero-eyebrow">
          <span>DESARROLLO WEB CREATIVO</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 id="hero-title">
          <span class="title-desktop">
            Arte y programación
            <br />
            en perfecta <em>armonía</em>
          </span>

          <span class="title-mobile" aria-hidden="true">
            <span>Arte y</span>
            <span>programación</span>
            <span>en perfecta</span>
            <em>armonía</em>
          </span>
        </h1>

        <p class="hero-description">
          Soy Marco Sánchez, desarrollador web que combina
          código limpio, diseño cuidado y una profunda
          sensibilidad artística.
        </p>

        <!-- DISCIPLINAS -->
        <div class="hero-meta" aria-label="Mis disciplinas">
          <span>Diseño</span>
          <span>Desarrollo</span>
          <span>Arte</span>
        </div>

        <!-- BOTONES -->
        <div class="hero-actions">
          <a href="/proyectos" class="btn btn-primary">
            <span aria-hidden="true">&lt;/&gt;</span>
            Ver proyectos
          </a>

          <a href="/arte" class="btn btn-secondary">
            <span aria-hidden="true">✦</span>
            Explorar arte
          </a>
        </div>
      </div>
    </div>

    <a
      href="#presentacion"
      class="scroll-indicator"
      aria-label="Desplazarse a la presentación"
    >
      <span aria-hidden="true"></span>
    </a>
  </section>

  <!-- SEGUNDA SECCIÓN -->
  <section id="presentacion" class="intro-section">
    <div class="intro-container">

      <span class="intro-label">
        DOS DISCIPLINAS, UNA VISIÓN
      </span>

      <h2>
        <span>Donde la creatividad</span>
        <em> encuentra al código.</em>
      </h2>

      <p>
        Exploro la conexión entre el desarrollo web y el arte,
        combinando tecnología, estética y atención al detalle.
      </p>

    </div>
  </section>
</MainLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  /* ==============================
     PORTADA ESCRITORIO
  ============================== */

  .hero {
    position: relative;
    min-height: calc(100svh - 95px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #100d0b;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url("/images/hero-desktop.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgba(12, 10, 9, 0.76) 0%,
      rgba(12, 10, 9, 0.40) 37%,
      rgba(12, 10, 9, 0) 68%
    );
    pointer-events: none;
  }

  .hero-container {
    width: min(calc(100% - 80px), 1450px);
    margin-inline: auto;
    padding-block: 100px 130px;
  }

  .hero-content {
    max-width: 740px;
  }

  /* ETIQUETA SUPERIOR */

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-bottom: 32px;
    color: #d8c7b5;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.34em;
  }

  .eyebrow-line {
    width: 90px;
    height: 1px;
    flex-shrink: 0;
    background: #d7a65c;
  }

  /* TÍTULO PRINCIPAL */

  h1 {
    margin: 0;
    color: #e9ddd1;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    line-height: 1.12;
    font-weight: 400;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  h1 em {
    color: #dfa85e;
    font-weight: 400;
  }

  .title-desktop {
    display: block;
  }

  .title-mobile {
    display: none;
  }

  /* DESCRIPCIÓN */

  .hero-description {
    max-width: 580px;
    margin-top: 32px;
    color: #d7cbc0;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    line-height: 1.7;
  }

  /* DISCIPLINAS */

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-meta span {
    padding: 8px 14px;
    border: 1px solid rgba(224, 177, 115, 0.28);
    border-radius: 999px;
    background: rgba(224, 177, 115, 0.08);
    color: #d8c7b5;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  /* BOTONES */

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 40px;
  }

  .btn {
    min-height: 60px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 15px 30px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 250ms ease,
      border-color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .btn:hover {
    transform: translateY(-3px);
  }

  .btn:focus-visible {
    outline: 2px solid #f0c58c;
    outline-offset: 4px;
  }

  .btn-primary {
    background: #e0b173;
    color: #17110b;
  }

  .btn-primary:hover {
    background: #f0c58c;
    box-shadow: 0 8px 28px rgba(224, 177, 115, 0.18);
  }

  .btn-secondary {
    border-color: #cbb69c;
    color: #f0e4d6;
    background: rgba(15, 12, 10, 0.45);
  }

  .btn-secondary:hover {
    border-color: #e0b173;
    background: rgba(224, 177, 115, 0.1);
  }

  /* FLECHA INFERIOR */

  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px;
  }

  .scroll-indicator span {
    display: block;
    width: 15px;
    height: 15px;
    border-right: 2px solid #e4d1b8;
    border-bottom: 2px solid #e4d1b8;
    transform: rotate(45deg);
  }

  /* ==============================
     SEGUNDA SECCIÓN
  ============================== */

  .intro-section {
    padding: 120px 24px;
    background: #120e0c;
    text-align: center;
  }

  .intro-container {
    max-width: 850px;
    margin-inline: auto;
  }

  .intro-label {
    color: #d9a965;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
  }

  .intro-section h2 {
    margin: 30px 0;
    color: #e9ddd1;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }

  .intro-section h2 em {
    color: #d9a965;
    font-weight: 400;
  }

  .intro-section p {
    max-width: 650px;
    margin-inline: auto;
    color: #b9aaa0;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  /* ==============================
     TABLETS
  ============================== */

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      overflow: visible;
    }

    .hero-background {
      position: relative;
      inset: auto;
      z-index: auto;
      width: 100%;
      height: clamp(320px, 58vw, 460px);
      flex-shrink: 0;
      background-size: cover;
      background-position: 72% center;
    }

    .hero::before {
      display: none;
    }

    .hero-container {
      width: 100%;
      padding: 0 28px 54px;
      margin-top: -54px;
      position: relative;
      z-index: 2;
      background: transparent;
    }

    .hero-content {
      max-width: 680px;
      margin-inline: auto;
      background: rgba(16, 13, 11, 0.94);
      border: 1px solid rgba(215, 166, 92, 0.12);
      border-radius: 24px;
      padding: 30px 26px 26px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .scroll-indicator {
      display: none;
    }
  }

  /* ==============================
     MÓVILES
  ============================== */

  @media (max-width: 600px) {
    .hero-background {
      height: 300px;
      background-position: 74% center;
    }

    /* TARJETA CASI DEBAJO DE NAV */

    .hero-container {
      width: 100%;
      padding: 0 16px 8px;
      margin-top: -282px;
      position: relative;
      z-index: 2;
      background: transparent;
    }

    .hero-content {
      position: relative;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;

      background: rgba(16, 13, 11, 0.94);
      border: 1px solid rgba(215, 166, 92, 0.24);
      border-radius: 24px;

      padding: 25px 20px 23px;

      box-shadow:
        0 24px 65px rgba(0, 0, 0, 0.40),
        0 0 30px rgba(215, 166, 92, 0.035);

      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }

    /* BRILLO DORADO */

    .hero-content::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 50%;
      transform: translateX(-50%);
      width: 55%;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(224, 177, 115, 0.65),
        transparent
      );
      pointer-events: none;
    }

    .hero-eyebrow {
      margin-bottom: 23px;
      gap: 12px;
      font-size: 0.60rem;
      letter-spacing: 0.16em;
    }

    .eyebrow-line {
      width: 32px;
    }

    /* TÍTULO MÓVIL */

    h1 {
      font-size: clamp(2.2rem, 9vw, 2.65rem);
      line-height: 1.12;
      letter-spacing: -0.04em;
      text-wrap: initial;
    }

    .title-desktop {
      display: none;
    }

    .title-mobile {
      display: block;
    }

    .title-mobile > span,
    .title-mobile > em {
      display: block;
    }

    .title-mobile > em {
      color: #e0b173;
      font-style: italic;
    }

    /* DESCRIPCIÓN */

    .hero-description {
      margin-top: 24px;
      margin-bottom: 0;
      max-width: 100%;
      font-size: 0.94rem;
      line-height: 1.75;
      color: #e0d4c7;
    }

    /* ETIQUETAS */

    .hero-meta {
      margin-top: 23px;
      gap: 9px;
    }

    .hero-meta span {
      padding: 7px 12px;
      font-size: 0.72rem;
      border-color: rgba(224, 177, 115, 0.32);
      background: rgba(224, 177, 115, 0.09);
    }

    /* BOTONES */

    .hero-actions {
      flex-direction: column;
      gap: 12px;
      margin-top: 27px;
    }

    .btn {
      width: 100%;
      min-height: 54px;
      padding: 14px 18px;
      font-size: 0.94rem;
      border-radius: 10px;
    }

    /* SEGUNDA SECCIÓN MÁS COMPACTA */

    .intro-section {
      padding: 45px 22px 55px;
    }

    .intro-label {
      font-size: 0.65rem;
      letter-spacing: 0.22em;
    }

    .intro-section h2 {
      font-size: clamp(2.1rem, 8vw, 3rem);
      line-height: 1.25;
      margin: 24px 0;
    }

    .intro-section h2 em {
      display: block;
      margin-top: 6px;
    }

    .intro-section p {
      font-size: 1rem;
      line-height: 1.7;
    }
  }

  /* MÓVILES PEQUEÑOS */

  @media (max-width: 360px) {
    .hero-container {
      padding-inline: 12px;
    }

    .hero-content {
      padding: 22px 16px;
    }

    h1 {
      font-size: 2rem;
    }

    .hero-eyebrow {
      font-size: 0.56rem;
    }
  }

  /* ACCESIBILIDAD */

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .btn {
      transition: none;
    }
  }
</style>
