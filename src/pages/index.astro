  // ====================================
  // INICIALIZAR CHATBOT
  // ====================================

  function initMarcoChat(): void {
    const widget =
      document.querySelector<HTMLElement>("#marco-chat");

    if (!widget || widget.dataset.initialized === "true") {
      return;
    }

    const toggle =
      widget.querySelector<HTMLButtonElement>("#chat-toggle");

    const close =
      widget.querySelector<HTMLButtonElement>("#chat-close");

    const panel =
      widget.querySelector<HTMLElement>("#chat-panel");

    const form =
      widget.querySelector<HTMLFormElement>("#chat-form");

    const input =
      widget.querySelector<HTMLInputElement>("#chat-input");

    const messages =
      widget.querySelector<HTMLElement>("#chat-messages");

    const suggestions =
      widget.querySelector<HTMLElement>("#chat-suggestions");

    if (
      !toggle ||
      !close ||
      !panel ||
      !form ||
      !input ||
      !messages ||
      !suggestions
    ) {
      return;
    }

    const ui = {
      toggle,
      close,
      panel,
      form,
      input,
      messages,
      suggestions,
    };

    widget.dataset.initialized = "true";

    // ABRIR / CERRAR

    function setOpen(open: boolean): void {
      ui.panel.toggleAttribute("hidden", !open);

      ui.panel.setAttribute(
        "aria-hidden",
        String(!open)
      );

      ui.toggle.setAttribute(
        "aria-expanded",
        String(open)
      );

      ui.toggle.setAttribute(
        "aria-label",
        open
          ? "Cerrar asistente virtual"
          : "Abrir asistente virtual"
      );

      if (open) {
        ui.input.focus();
      } else {
        ui.toggle.focus();
      }
    }

    // AÑADIR MENSAJE

    function addMessage(
      content: string,
      sender: "user" | "bot"
    ): void {
      const bubble = document.createElement("div");

      bubble.className =
        sender === "user"
          ? "chat-bubble user-bubble"
          : "chat-bubble bot-bubble";

      bubble.textContent = content;

      ui.messages.appendChild(bubble);

      ui.messages.scrollTop =
        ui.messages.scrollHeight;
    }

    // AÑADIR ENLACE

    function addLink(
      url: string,
      label: string,
      whatsapp: boolean = false
    ): void {
      const link = document.createElement("a");

      link.href = url;
      link.textContent = label;

      link.className = whatsapp
        ? "chat-whatsapp"
        : "chat-page-link";

      if (url.startsWith("https://")) {
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }

      ui.messages.appendChild(link);
    }

    // ENVIAR PREGUNTA

    function sendQuestion(value: string): void {
      const question = value.trim();

      if (!question) {
        return;
      }

      addMessage(question, "user");

      const reply = getReply(question);

      addMessage(reply.text, "bot");

      if (reply.link) {
        addLink(
          reply.link.url,
          reply.link.label
        );
      }

      if (reply.channel) {
        const url =
          reply.channel === "web"
            ? whatsappWeb
            : reply.channel === "arte"
              ? whatsappArte
              : whatsappGeneral;

        addLink(
          url,
          "Hablar con Marco por WhatsApp ↗",
          true
        );
      }

      ui.messages.scrollTop =
        ui.messages.scrollHeight;
    }

    // BOTÓN FLOTANTE

    ui.toggle.addEventListener("click", () => {
      setOpen(ui.panel.hasAttribute("hidden"));
    });

    // BOTÓN CERRAR

    ui.close.addEventListener("click", () => {
      setOpen(false);
    });

    // FORMULARIO

    ui.form.addEventListener("submit", (event) => {
      event.preventDefault();

      sendQuestion(ui.input.value);

      ui.input.value = "";
      ui.input.focus();
    });

    // PREGUNTAS RÁPIDAS

    ui.suggestions.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button =
        target.closest<HTMLButtonElement>(
          "button[data-question]"
        );

      if (!button) {
        return;
      }

      sendQuestion(button.dataset.question ?? "");
    });

    // CERRAR CON ESCAPE

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !ui.panel.hasAttribute("hidden")
      ) {
        setOpen(false);
      }
    });
  }

  document.addEventListener(
    "DOMContentLoaded",
    initMarcoChat
  );

  document.addEventListener(
    "astro:page-load",
    initMarcoChat
  );

  initMarcoChat();
</script>
