    font-weight: 800;
    letter-spacing: -.12em;
  }

  .placeholder-mark span {
    color: #e9ebee;
  }

  .placeholder-mark i {
    color: var(--gold);
    font-style: normal;
  }

  .hero-photo-shade {
    position: absolute;
    inset: 0;
    z-index: 3;

    background: linear-gradient(
      180deg,
      rgba(10,12,16,.15),
      transparent 48%,
      rgba(10,12,16,.9)
    );

    pointer-events: none;
  }

  .photo-heading {
    position: absolute;
    right: 26px;
    bottom: 30px;
    left: 26px;
    z-index: 4;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .photo-heading span {
    color: #e0b884;
    font-family: Consolas,monospace;
    font-size: .66rem;
    letter-spacing: .13em;
  }

  .photo-heading strong {
    color: #fff;
    font-family: Georgia,"Times New Roman",serif;
    font-size: clamp(1.8rem,2.7vw,3rem);
    font-weight: 400;
    font-style: italic;
  }

  .floating-note {
    position: absolute;
    right: -20px;
    bottom: 20px;
    z-index: 5;

    display: flex;
    align-items: center;
    gap: 12px;

    max-width: 280px;
    padding: 15px 18px;

    border: 1px solid #4a4d54;
    border-radius: 11px;

    background: #252932;
    box-shadow: 0 13px 30px rgba(0,0,0,.37);
  }

  .floating-note-icon {
    display: grid;
    place-items: center;

    width: 43px;
    height: 43px;
    flex-shrink: 0;

    border: 1px solid rgba(215,166,92,.45);
    border-radius: 9px;

    color: var(--gold);
    font-size: 1.4rem;
  }

  .floating-note strong,
  .floating-note small {
    display: block;
  }

  .floating-note strong {
    font-size: .88rem;
  }

  .floating-note small {
    margin-top: 6px;
    color: #aeb7c1;
    font-size: .69rem;
  }

  .visual-side-label {
    position: absolute;
    right: 10px;
    top: 0;

    color: #a59b8b;
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .hero-scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;

    margin-top: 55px;

    color: #9da6b2;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-decoration: none;
  }

  .hero-scroll > span {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;

    border: 1px solid rgba(215,166,92,.4);
    border-radius: 50%;

    color: var(--gold);
    font-size: 1rem;
  }

  /* ======================================== */
  /*               MANIFIESTO                */
  /* ======================================== */

  .manifesto-section {
    padding: 105px 0 112px;
    border-block: 1px solid #31363f;
    background: #171b21;
  }

  .manifesto-inner {
    max-width: 1000px;
    text-align: center;
  }

  .manifesto-quote {
    display: block;
    height: 70px;
    color: var(--gold);

    font-family: Georgia,serif;
    font-size: 7rem;
    line-height: 1;
  }

  .manifesto-inner > p {
    margin: 22px auto 35px;

    color: #e7e8eb;
    font-family: Georgia,"Times New Roman",serif;
    font-size: clamp(1.55rem,3.2vw,3rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -.03em;
  }

  .manifesto-inner > p strong {
    color: var(--gold);
    font-weight: 400;
    font-style: italic;
  }

  .manifesto-signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .manifesto-signature span {
    width: 38px;
    height: 1px;
    background: var(--gold);
  }

  .manifesto-signature small {
    color: #9da6b1;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  /* ======================================== */
  /*                 HISTORIA                */
  /* ======================================== */

  .history-section {
    padding: 125px 0;
    background: #101216;
  }

  .history-layout {
    display: grid;
    grid-template-columns:
      minmax(0,.84fr)
      minmax(0,1.16fr);

    align-items: start;
    gap: clamp(50px,7vw,110px);
  }

  .history-intro {
    position: sticky;
    top: 140px;
  }

  .history-intro h2,
  .mentor-copy h2,
  .exhibition-copy h2,
  .gallery-heading h2,
  .process-heading h2,
  .art-closing h2 {
    margin: 0;

    color: #f0f1f3;
    font-size: clamp(2.7rem,4.5vw,5rem);
    font-weight: 770;
    line-height: 1.12;
    letter-spacing: -.058em;
  }

  .history-intro h2 span,
  .history-intro h2 em {
    display: block;
  }

  .history-intro h2 span {
    color: var(--gold);
  }

  .history-intro h2 em {
    color: #f0f1f3;
    font-family: Georgia,serif;
    font-size: .85em;
    font-weight: 400;
  }

  .history-intro > p {
    margin: 25px 0 0;

    color: #aeb6c1;
    font-size: .96rem;
    line-height: 1.9;
  }

  .history-mini-card {
    display: flex;
    flex-direction: column;
    gap: 13px;

    margin-top: 40px;
    padding: 23px;

    border: 1px solid rgba(215,166,92,.36);
    border-radius: 12px;

    background: #1d2128;
  }

  .history-mini-card > span,
  .history-mini-card > small {
    color: #c4a57b;
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .history-mini-card strong {
    color: #f0f1f3;
    font-family: Georgia,serif;
    font-size: 1.42rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .history-mini-card small {
    color: #949da8;
  }

  /* LÍNEA TEMPORAL */

  .timeline {
    position: relative;
    display: grid;
    gap: 14px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 35px;
    bottom: 35px;
    left: 22px;

    width: 1px;

    background: linear-gradient(
      to bottom,
      var(--gold),
      #444a53,
      rgba(215,166,92,.3)
    );
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 45px minmax(0,1fr);
    gap: 20px;
  }

  .timeline-marker {
    position: relative;
    z-index: 2;

    display: grid;
    place-items: start center;

    padding-top: 25px;
  }

  .timeline-marker > span {
    display: grid;
    place-items: center;

    width: 44px;
    height: 44px;

    border: 1px solid rgba(215,166,92,.5);
    border-radius: 50%;

    background: #20242b;
    color: var(--gold);

    font-family: Consolas,monospace;
    font-size: .79rem;
    font-weight: 700;
  }

  .timeline-content {
    padding: 26px 28px 29px;
    border: 1px solid #353b45;
    border-radius: 13px;

    background: #1a1e25;
  }

  .timeline-item:hover .timeline-content {
    border-color: rgba(215,166,92,.45);
  }

  .timeline-year {
    color: var(--gold);
    font-size: .69rem;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .timeline-content h3 {
    margin: 15px 0 13px;

    color: #eff0f2;
    font-family: Georgia,serif;
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .timeline-content p {
    margin: 0;

    color: #aeb6c1;
    font-size: .88rem;
    line-height: 1.85;
  }

  /* ======================================== */
  /*                 ANITA                   */
  /* ======================================== */

  .mentor-section {
    padding: 125px 0;
    border-block: 1px solid #303640;
    background: #171b21;
  }

  .mentor-layout {
    display: grid;
    grid-template-columns:
      minmax(0,.9fr)
      minmax(0,1.1fr);

    align-items: center;
    gap: clamp(45px,7vw,105px);
  }

  .mentor-visual,
  .mentor-copy {
    min-width: 0;
  }

  .mentor-photo-frame {
    height: 600px;

    border: 1px solid rgba(215,166,92,.5);
    border-radius: 13px;

    box-shadow: 0 30px 70px rgba(0,0,0,.28);
  }

  .mentor-frame-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;

    margin-top: 18px;

    color: #9fa7b2;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .mentor-copy h2 {
    margin-bottom: 30px;
    font-size: clamp(2.5rem,4vw,4.4rem);
  }

  .mentor-copy h2 span,
  .mentor-copy h2 em {
    display: block;
  }

  .mentor-copy h2 span {
    color: var(--gold);
  }

  .mentor-copy h2 em {
    margin-top: 5px;

    font-family: Georgia,serif;
    font-size: .7em;
    font-weight: 400;
    font-style: italic;
    line-height: 1.4;
  }

  .mentor-copy > p {
    margin: 0 0 19px;

    color: #afb7c2;
    font-size: .94rem;
    line-height: 1.9;
  }

  .mentor-copy > p strong {
    color: #e8c394;
  }

  .mentor-quote {
    display: flex;
    gap: 13px;

    margin: 28px 0;
    padding: 23px;

    border-left: 2px solid var(--gold);
    background: rgba(215,166,92,.055);
  }

  .mentor-quote > span {
    color: var(--gold);
    font-family: Georgia,serif;
    font-size: 3rem;
    line-height: .9;
  }

  .mentor-quote p {
    margin: 0;

    color: #dedfe3;
    font-family: Georgia,serif;
    font-size: 1.13rem;
    font-style: italic;
    line-height: 1.7;
  }

  /* ======================================== */
  /*             EL INCENSARIO               */
  /* ======================================== */

  .incensario-section {
    position: relative;
    isolation: isolate;

    padding: 130px 0;
    overflow: hidden;

    background: #101216;
  }

  .incensario-background {
    position: absolute;
    top: -150px;
    right: -250px;
    z-index: -1;

    width: 800px;
    height: 800px;

    background: radial-gradient(
      circle,
      rgba(215,166,92,.09),
      transparent 70%
    );

    pointer-events: none;
  }

  .incensario-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 57px;
  }

  .incensario-pretitle,
  .gallery-pretitle {
    color: #bbab91;
    font-size: .71rem;
    font-weight: 750;
    letter-spacing: .19em;
  }

  .incensario-heading h2 {
    margin: 12px 0 15px;

    color: #f0f1f3;
    font-size: clamp(4rem,7vw,8.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.075em;
  }

  .incensario-heading h2 em {
    color: var(--gold);
    font-family: Georgia,serif;
    font-weight: 400;
  }

  .incensario-heading p {
    max-width: 570px;
    margin: 0;

    color: #adb6c1;
    font-size: 1rem;
    line-height: 1.85;
  }

  .incensario-year {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }

  .incensario-year span {
    color: #b6a17d;
    font-size: .65rem;
    font-weight: 750;
    letter-spacing: .15em;
  }

  .incensario-year strong {
    color: rgba(215,166,92,.5);
    font-size: 4.7rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.07em;
  }

  .incensario-layout {
    display: grid;
    grid-template-columns:
      minmax(0,.93fr)
      minmax(0,1.07fr);

    align-items: center;
    gap: clamp(45px,7vw,115px);
  }

  .incensario-artwork,
  .incensario-story {
    min-width: 0;
  }

  .incensario-gold-frame {
    padding: 13px;

    border: 1px solid #a88855;
    border-radius: 4px;

    background: #242322;
    box-shadow:
      0 27px 70px rgba(0,0,0,.35),
      0 0 0 7px rgba(215,166,92,.025);
  }

  .incensario-photo {
    height: 690px;

    border: 1px solid rgba(215,166,92,.25);
  }

  .incensario-photo .optional-photo {
    object-fit: contain;
    background: #191a1c;
  }

  .incensario-placeholder {
    background:
      radial-gradient(
        circle at center,
        rgba(215,166,92,.12),
        transparent 65%
      ),
      #1e2127;
  }

  .incensario-placeholder strong {
    display: flex;
    flex-direction: column;

    color: #e8e4dc;
    font-family: Georgia,serif;
    font-size: clamp(2rem,4vw,3.8rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -.04em;
  }

  .incensario-placeholder strong em {
    color: var(--gold);
    font-size: 1.6em;
    font-weight: 400;
  }

  .artwork-caption {
    display: flex;
    justify-content: space-between;
    gap: 15px;

    margin-top: 19px;

    color: #a0a8b3;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .story-number {
    color: var(--gold);
    font-family: Consolas,monospace;
    font-size: .74rem;
    letter-spacing: .15em;
  }

  .incensario-story h3 {
    margin: 16px 0 25px;

    color: #f0f1f3;
    font-size: clamp(2.3rem,3.4vw,4rem);
    font-weight: 750;
    letter-spacing: -.06em;
    line-height: 1.15;
  }

  .incensario-story h3 em {
    display: block;

    color: var(--gold);
    font-family: Georgia,serif;
    font-weight: 400;
    font-style: italic;
  }

  .incensario-story > p {
    margin: 0 0 19px;

    color: #aeb7c2;
    font-size: .95rem;
    line-height: 1.9;
  }

  .incensario-story > p strong {
    color: #e6c290;
  }

  .incensario-details {
    display: grid;
    gap: 0;

    margin: 31px 0;
    border-block: 1px solid #3b4049;
  }

  .incensario-details > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    padding: 16px 0;
    border-bottom: 1px solid #343942;
  }

  .incensario-details > div:last-child {
    border-bottom: 0;
  }

  .incensario-details span {
    color: #aa936e;
    font-size: .66rem;
    font-weight: 750;
    letter-spacing: .12em;
  }

  .incensario-details strong {
    color: #e1e4e8;
    font-size: .83rem;
    font-weight: 600;
    text-align: right;
  }

  .incensario-thanks {
    margin-bottom: 29px;
    padding: 21px 23px;

    border: 1px solid rgba(215,166,92,.28);
    border-radius: 11px;

    background: #1c2026;
  }

  .incensario-thanks > span {
    color: var(--gold);
    font-size: .67rem;
    font-weight: 750;
    letter-spacing: .14em;
  }

  .incensario-thanks p {
    margin: 14px 0 0;

    color: #b0b7c1;
    font-size: .86rem;
    line-height: 1.85;
  }

  .incensario-thanks strong {
    color: #e4c18e;
  }

  /* ======================================== */
  /*            EXPOSICIÓN CHIPIONA          */
  /* ======================================== */

  .exhibition-section {
    padding: 125px 0;
    border-block: 1px solid #303640;
    background: #171b21;
  }

  .exhibition-layout {
    display: grid;
    grid-template-columns:
      minmax(0,1fr)
      minmax(0,1fr);

    align-items: center;
    gap: clamp(40px,6vw,90px);
  }

  .exhibition-copy,
  .exhibition-gallery {
    min-width: 0;
  }

  .exhibition-year-badge {
    display: inline-flex;
    align-items: center;
    gap: 13px;

    margin-bottom: 24px;
    padding: 10px 14px;

    border: 1px solid rgba(215,166,92,.42);
    border-radius: 8px;

    background: rgba(215,166,92,.07);
    color: var(--gold);
  }

  .exhibition-year-badge span {
    font-size: .67rem;
    letter-spacing: .13em;
  }

  .exhibition-year-badge strong {
    font-family: Consolas,monospace;
    font-size: 1rem;
  }

  .exhibition-copy h2 {
    margin-bottom: 25px;
  }

  .exhibition-copy h2 span {
    display: block;
    color: var(--gold);
  }

  .exhibition-copy > p {
    margin: 0 0 17px;

    color: #b1b9c3;
    font-size: .95rem;
    line-height: 1.9;
  }

  .exhibition-copy > p strong {
    color: #e6c18e;
  }

  .exhibition-copy .exhibition-lead {
    color: #e2e5e9;
    font-size: 1.05rem;
  }

  .exhibition-info {
    display: grid;
    gap: 13px;

    margin: 28px 0 32px;
    padding: 22px;

    border: 1px solid #3d434c;
    border-radius: 11px;

    background: #20242b;
  }

  .exhibition-info-item {
    display: grid;
    grid-template-columns: 105px minmax(0,1fr);
    gap: 16px;
    align-items: start;
  }

  .exhibition-info-item > span {
    color: var(--gold);
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .exhibition-info-item > strong {
    color: #e1e4e8;
    font-size: .84rem;
    font-weight: 600;
    line-height: 1.65;
  }

  .exhibition-gallery {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 12px;
  }

  .exhibition-picture {
    min-width: 0;
    border: 1px solid rgba(215,166,92,.3);
    border-radius: 10px;
  }

  .picture-large {
    grid-column: 1 / -1;
    height: 370px;
  }

  .picture-small {
    height: 195px;
  }

  .exhibition-photo-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;

    grid-column: 1 / -1;
    margin-top: 6px;
  }

  .exhibition-photo-label span,
  .exhibition-photo-label strong {
    color: #9aa3af;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .exhibition-photo-label strong {
    color: var(--gold);
  }

  /* ======================================== */
  /*                 GALERÍA                 */
  /* ======================================== */

  .gallery-section {
    position: relative;
    isolation: isolate;

    padding: 130px 0;
    background: #101216;
  }

  .gallery-grid-pattern {
    z-index: -1;

    mask-image: linear-gradient(
      180deg,
      #000,
      transparent 700px
    );

    -webkit-mask-image: linear-gradient(
      180deg,
      #000,
      transparent 700px
    );
  }

  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
  }

  .gallery-heading h2 {
    margin-top: 15px;
  }

  .gallery-heading h2 span {
    display: block;
    color: var(--gold);
  }

  .gallery-heading-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }

  .gallery-heading-side strong {
    color: rgba(215,166,92,.6);
    font-size: 5.6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.075em;
  }

  .gallery-heading-side span {
    color: #9da6b2;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .gallery-description {
    max-width: 730px;
    margin: 24px 0 30px;

    color: #adb6c1;
    font-size: .96rem;
    line-height: 1.9;
  }

  .gallery-instructions {
    display: inline-flex;
    align-items: center;
    gap: 13px;

    margin-bottom: 35px;
    padding: 12px 16px;

    border: 1px solid #3d434c;
    border-radius: 9px;

    background: #1b1f26;
    color: #b8c0ca;

    font-size: .79rem;
    line-height: 1.5;
  }

  .instructions-icon {
    color: var(--gold);
    font-size: 1.6rem;
    line-height: 1;
  }

  .artworks-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 26px 18px;
  }

  .artwork-card {
    display: flex;
    flex-direction: column;
    gap: 0;

    min-width: 0;
    padding: 0;

    border: 0;
    background: transparent;

    text-align: left;
    font-family: inherit;
    cursor: pointer;
  }

  .artwork-visual {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;

    border: 1px solid #44454a;
    border-radius: 10px;

    transition:
      border-color .25s ease,
      transform .25s ease,
      box-shadow .25s ease;
  }

  .artwork-card:hover .artwork-visual {
    transform: translateY(-4px);
    border-color: rgba(215,166,92,.7);

    box-shadow: 0 19px 40px rgba(0,0,0,.25);
  }

  .artwork-visual .optional-photo {
    object-fit: contain;
    background: #1b1e22;
  }

  .artwork-placeholder {
    position: absolute;
    inset: 0;
    z-index: 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 24px;

    background:
      radial-gradient(
        circle at 50% 43%,
        rgba(215,166,92,.11),
        transparent 63%
      ),
      #20242b;

    text-align: center;
  }

  .artwork-placeholder-number {
    position: absolute;
    top: 20px;
    left: 21px;

    color: #a8aeb7;
    font-family: Consolas,monospace;
    font-size: .72rem;
  }

  .artwork-placeholder-symbol {
    color: rgba(215,166,92,.6);
    font-size: 4rem;
    line-height: 1;
  }

  .artwork-placeholder-text {
    color: #e9e9e9;
    font-family: Georgia,serif;
    font-size: clamp(1.3rem,2vw,2rem);
    line-height: 1.3;
  }

  .artwork-placeholder small {
    color: #929ba6;
    font-size: .59rem;
    letter-spacing: .12em;
  }

  .artwork-zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    min-height: 44px;
    padding: 9px 15px;

    border: 1px solid rgba(215,166,92,.42);
    border-radius: 8px;

    background: rgba(22,25,30,.9);
    color: #e5c08f;

    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .12em;

    opacity: 0;
    transform: translateY(10px);

    transition:
      opacity .22s ease,
      transform .22s ease;
  }

  .artwork-card:hover .artwork-zoom,
  .artwork-card:focus-visible .artwork-zoom {
    opacity: 1;
    transform: translateY(0);
  }

  .artwork-zoom > span {
    font-size: 1.2rem;
  }

  .artwork-overlay-number {
    position: absolute;
    z-index: 3;
    top: 14px;
    right: 14px;

    padding: 8px 10px;
    border-radius: 5px;

    background: rgba(16,18,22,.75);
    color: #e8d1b0;

    font-family: Consolas,monospace;
    font-size: .66rem;
  }

  .artwork-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;

    padding: 19px 2px;
  }

  .artwork-info > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .artwork-info strong {
    color: #edf0f2;
    font-size: 1.04rem;
    font-weight: 700;
  }

  .artwork-info small {
    color: #abb3bd;
    font-size: .76rem;
  }

  .artwork-info-arrow {
    color: var(--gold);
    font-size: 1.27rem;
  }

  .gallery-bottom-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    margin-top: 45px;
    padding: 26px 0;

    border-top: 1px solid #3b404a;
  }

  .gallery-bottom-note > div {
    display: flex;
    align-items: flex-start;
    gap: 17px;

    max-width: 630px;
  }

  .gallery-bottom-icon {
    color: var(--gold);
    font-size: 1.5rem;
  }

  .gallery-bottom-note p {
    margin: 0;

    color: #aeb7c1;
    font-size: .85rem;
    line-height: 1.8;
  }

  .gallery-bottom-note p strong {
    display: block;
    color: #edf0f2;
  }

  .gallery-bottom-note > a {
    flex-shrink: 0;
  }

  /* ======================================== */
  /*            EN PROCESO                  */
  /* ======================================== */

  .process-section {
    padding: 125px 0;
    border-block: 1px solid #303640;
    background: #171b21;
  }

  .process-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 50px;

    margin-bottom: 49px;
  }

  .process-heading h2 {
    max-width: 650px;
  }

  .process-heading h2 span {
    display: block;
    color: var(--gold);
  }

  .process-heading > p {
    max-width: 435px;
    margin: 0;

    color: #aeb6c1;
    font-size: .91rem;
    line-height: 1.85;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 17px;
  }

  .process-card {
    min-width: 0;
    overflow: hidden;

    border: 1px solid #3c424b;
    border-radius: 13px;

    background: #20242b;

    transition: border-color .2s ease;
  }

  .process-card:hover {
    border-color: rgba(215,166,92,.55);
  }

  .process-image {
    height: 245px;
    border-bottom: 1px solid #3c424b;
  }

  .process-image-label {
    position: absolute;
    z-index: 3;
    top: 16px;
    left: 16px;

    padding: 8px 11px;

    border: 1px solid rgba(215,166,92,.42);
    border-radius: 5px;

    background: rgba(21,24,29,.8);
    color: #e4ba81;

    font-size: .62rem;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .process-card-content {
    display: flex;
    flex-direction: column;

    min-height: 246px;
    padding: 23px;
  }

  .process-card-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;

    margin-bottom: 20px;

    color: #a5adb8;
    font-family: Consolas,monospace;
    font-size: .66rem;
  }

  .process-card-top > span:last-child {
    color: var(--gold);
    font-size: 1.3rem;
  }

  .process-card h3 {
    margin: 0 0 14px;

    color: #f0f1f3;
    font-family: Georgia,serif;
    font-size: 1.56rem;
    font-weight: 400;
  }

  .process-card p {
    margin: 0 0 21px;

    color: #aeb6c1;
    font-size: .84rem;
    line-height: 1.8;
  }

  .process-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    margin-top: auto;

    color: #d5ae78;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .process-status > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ======================================== */
  /*                REFLEXIÓN               */
  /* ======================================== */

  .reflection-section {
    padding: 135px 0;
    background:
      radial-gradient(
        ellipse at 50% 80%,
        rgba(215,166,92,.075),
        transparent 65%
      ),
      #101216;
  }

  .reflection-inner {
    max-width: 1000px;
    text-align: center;
  }

  .reflection-symbol {
    display: block;

    color: var(--gold);
    font-family: Georgia,serif;
    font-size: 3.1rem;
  }

  .reflection-eyebrow {
    margin: 20px 0 24px;

    color: #c1a57f;
    font-size: .69rem;
    font-weight: 750;
    letter-spacing: .18em;
  }

  .reflection-inner h2 {
    margin: 0 auto 27px;

    color: #f0f1f3;
    font-size: clamp(2.3rem,4.6vw,5.4rem);
    font-weight: 780;
    line-height: 1.13;
    letter-spacing: -.058em;
  }

  .reflection-inner h2 em {
    display: block;
    margin-top: 10px;

    color: var(--gold);
    font-family: Georgia,serif;
    font-size: .82em;
    font-weight: 400;
    font-style: italic;
    line-height: 1.36;
  }

  .reflection-description {
    max-width: 680px;
    margin: 0 auto;

    color: #aeb7c1;
    font-size: .98rem;
    line-height: 1.9;
  }

  .reflection-line {
    display: block;
    width: 50px;
    height: 1px;
    margin: 33px auto 17px;
    background: var(--gold);
  }

  .reflection-inner > strong {
    color: #d8dbe0;
    font-size: .75rem;
    letter-spacing: .16em;
  }

  /* ======================================== */
  /*                CIERRE                 */
  /* ======================================== */

  .art-closing {
    padding: 115px 0;
    border-top: 1px solid #303640;
    background: #171b21;
  }

  .closing-layout {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 65px;
  }

  .art-closing h2 {
    margin-bottom: 25px;
  }

  .art-closing h2 span {
    display: block;
    color: var(--gold);
  }

  .art-closing p {
    max-width: 665px;
    margin: 0;

    color: #b2bac4;
    font-size: .96rem;
    line-height: 1.9;
  }

  .closing-monogram {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 13px;

    min-height: 335px;

    border: 1px solid rgba(215,166,92,.34);
    border-radius: 15px;

    background:
      radial-gradient(
        circle,
        rgba(215,166,92,.085),
        transparent 65%
      ),
      #20242b;
  }

  .closing-monogram > span {
    color: #e5e5e5;
    font-size: clamp(6rem,10vw,10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.12em;
  }

  .closing-monogram > small {
    color: var(--gold);
    font-family: Georgia,serif;
    font-size: 1.17rem;
    font-style: italic;
    letter-spacing: .07em;
  }

  /* ======================================== */
  /*       VISOR DE GALERÍA INMERSIVO         */
  /* ======================================== */

  .art-lightbox[hidden] {
    display: none !important;
  }

  .art-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #0b0d10;
    color: #f0f1f3;
  }

  .lightbox-stage {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #0b0d10;
  }

  .lightbox-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    flex: 0 0 auto;
    min-height: 62px;
    padding: 10px clamp(17px,4vw,55px);
    background: #101216;
    border-bottom: 1px solid rgba(215,166,92,.15);
  }

  .lightbox-top-left {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #d7a65c;
    font-size: .7rem;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .lightbox-indicator {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #d7a65c;
    box-shadow: 0 0 0 5px rgba(215,166,92,.1);
  }

  .lightbox-top-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lightbox-top-hint {
    color: #8c95a2;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .lightbox-close {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    padding: 0;
    border: 1px solid #454a52;
    border-radius: 50%;
    background: #242831;
    color: #f0f1f3;
    font-family: inherit;
    font-size: 1.85rem;
    line-height: 1;
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease;
  }

  .lightbox-close:hover {
    background: #35333a;
    border-color: #d7a65c;
    color: #d7a65c;
  }

  .lightbox-canvas {
    display: grid;
    grid-template-columns: clamp(44px,7vw,100px) minmax(0,1fr) clamp(44px,7vw,100px);
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
    width: 100%;
    padding: 12px 0;
    background: #0b0d10;
  }

  .lightbox-image-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    background: transparent;
  }

  #lightbox-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 15px 45px rgba(0,0,0,.3);
  }

  #lightbox-image[hidden],
  .lightbox-empty[hidden] {
    display: none !important;
  }

  .lightbox-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: min(100%,350px);
    text-align: center;
  }

  .lightbox-empty > span {
    color: #d7a65c;
    font-size: 3.8rem;
  }

  .lightbox-empty > strong {
    color: #f1f2f3;
    font-family: Georgia,serif;
    font-size: 1.65rem;
    font-weight: 400;
  }

  .lightbox-empty > p {
    margin: 0;
    color: #aeb7c2;
    font-size: .84rem;
    line-height: 1.75;
  }

  .lightbox-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
    justify-self: center;
    width: clamp(34px,4vw,50px);
    height: clamp(50px,7vw,75px);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: #e5bc7b;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  .lightbox-nav > span {
    display: block;
    font-size: clamp(2.3rem,4vw,3.6rem);
    font-weight: 300;
    line-height: 1;
  }

  .lightbox-nav:hover {
    background: rgba(215,166,92,.12);
    color: #f3d1a0;
  }

  .lightbox-bottom {
    display: grid;
    grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr);
    align-items: center;
    gap: clamp(22px,5vw,70px);
    flex: 0 0 auto;
    width: 100%;
    min-height: 110px;
    max-height: 165px;
    padding: 13px clamp(23px,7vw,120px);
    border-top: 1px solid rgba(215,166,92,.2);
    background: #101216;
  }

  .lightbox-caption-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    min-width: 0;
  }

  .lightbox-count {
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: .7rem;
    letter-spacing: .12em;
  }

  .lightbox-caption-main h3 {
    margin: 0;
    color: #f0f1f3;
    font-family: Georgia,serif;
    font-size: clamp(1.2rem,2vw,2.1rem);
    font-weight: 400;
    line-height: 1.25;
  }

  .lightbox-medium {
    color: #c8a377;
    font-size: .78rem;
  }

  .lightbox-caption-side {
    min-width: 0;
  }

  .lightbox-caption-side > p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    margin: 0 0 10px;
    color: #aeb7c2;
    font-size: .8rem;
    line-height: 1.55;
  }

  .lightbox-metadata {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lightbox-metadata > span {
    color: #b59b78;
    font-size: .63rem;
    font-weight: 750;
    letter-spacing: .1em;
  }

  .lightbox-metadata > strong {
    color: #f0f1f3;
    font-size: .75rem;
  }

  .lightbox-help {
    flex: 0 0 auto;
    margin: 0;
    padding: 7px 12px 9px;
    background: #101216;
    color: #747e8b;
    font-size: .63rem;
    text-align: center;
    letter-spacing: .04em;
  }

  /* ======================================== */
  /*             TABLETS                   */
  /* ======================================== */

  @media (max-width: 1150px) {
    .container {
      width: min(calc(100% - 60px),1060px);
    }

    .hero-layout {
      gap: 42px;
    }

    .hero-copy h1 {
      font-size: clamp(3rem,5.3vw,5.2rem);
    }

    .hero-art-frame {
      height: 510px;
    }

    .mentor-photo-frame {
      height: 550px;
    }

    .incensario-photo {
      height: 590px;
    }

    .incensario-layout {
      gap: 45px;
    }

    .artworks-grid {
      gap: 22px 14px;
    }
  }

  @media (max-width: 900px) {
    .hero-layout,
    .history-layout,
    .mentor-layout,
    .incensario-layout,
    .exhibition-layout,
    .closing-layout {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: 760px;
    }

    .hero-copy h1 {
      font-size: clamp(3.2rem,7.5vw,5.5rem);
    }

    .hero-visual {
      width: min(100%,600px);
      margin-inline: auto;
    }

    .hero-art-frame {
      height: 570px;
    }

    .history-intro {
      position: static;
      top: auto;
    }

    .timeline {
      margin-top: 10px;
    }

    .mentor-layout {
      gap: 45px;
    }

    .mentor-visual {
      width: min(100%,630px);
    }

    .mentor-photo-frame {
      height: 500px;
    }

    .incensario-photo {
      height: 620px;
    }

    .incensario-artwork {
      width: min(100%,570px);
      margin-inline: auto;
    }

    .exhibition-gallery {
      max-width: 720px;
    }

    .artworks-grid {
      grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .process-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }

    .process-grid {
      grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .process-grid > .process-card:last-child {
      grid-column: 1 / -1;
    }

    .closing-monogram {
      min-height: 260px;
    }

  }

  /* ======================================== */
  /*               MÓVILES                 */
  /* ======================================== */

  @media (max-width: 650px) {
    .container {
      width: calc(100% - 36px);
    }

    .reading-progress {
      top: 70px;
    }

    .section-eyebrow {
      font-size: .62rem;
      letter-spacing: .12em;
    }

    .art-hero {
      min-height: auto;
      padding: 55px 0 75px;
    }

    .eyebrow-pill {
      font-size: .59rem;
    }

    .hero-kicker {
      margin-top: 29px;
      font-size: .65rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.7rem,10vw,4.3rem);
    }

    .hero-lead {
      font-size: .98rem;
    }

    .hero-description {
      font-size: .9rem;
    }

    .hero-tags > span {
      font-size: .65rem;
    }

    .hero-actions,
    .closing-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .art-button {
      width: 100%;
    }

    .hero-bottom-label {
      margin-top: 32px;
      font-size: .58rem;
    }

    .hero-visual {
      padding: 20px 7px 35px;
    }

    .hero-art-frame {
      height: 450px;
      transform: none;
    }

    .hero-art-frame:hover {
      transform: none;
    }

    .placeholder-mark {
      font-size: 5rem;
    }

    .floating-note {
      right: -5px;
      bottom: 10px;
      padding: 11px;
    }

    .floating-note strong {
      font-size: .76rem;
    }

    .floating-note small {
      font-size: .62rem;
    }

    .hero-scroll {
      margin-top: 35px;
      font-size: .6rem;
    }

    /* MANIFIESTO */

    .manifesto-section {
      padding: 75px 0 80px;
    }

    .manifesto-quote {
      height: 48px;
      font-size: 5rem;
    }

    .manifesto-inner > p {
      font-size: clamp(1.45rem,5.6vw,2.3rem);
    }

    .manifesto-signature small {
      font-size: .56rem;
    }

    /* SECCIONES */

    .history-section,
    .mentor-section,
    .incensario-section,
    .exhibition-section,
    .gallery-section,
    .process-section,
    .reflection-section,
    .art-closing {
      padding: 80px 0;
    }

    .history-intro h2,
    .mentor-copy h2,
    .exhibition-copy h2,
    .gallery-heading h2,
    .process-heading h2,
    .art-closing h2 {
      font-size: clamp(2.3rem,9.3vw,3.7rem);
    }

    /* HISTORIA */

    .history-layout {
      gap: 35px;
    }

    .history-intro > p {
      font-size: .89rem;
    }

    .timeline::before {
      left: 17px;
    }

    .timeline-item {
      grid-template-columns: 35px minmax(0,1fr);
      gap: 12px;
    }

    .timeline-marker {
      padding-top: 18px;
    }

    .timeline-marker > span {
      width: 35px;
      height: 35px;
      font-size: .7rem;
    }

    .timeline-content {
      padding: 21px;
    }

    .timeline-content h3 {
      font-size: 1.33rem;
    }

    .timeline-content p {
      font-size: .83rem;
    }

    /* ANITA */

    .mentor-photo-frame {
      height: 420px;
    }

    .mentor-copy > p {
      font-size: .88rem;
    }

    .mentor-quote {
      padding: 17px;
    }

    .mentor-quote p {
      font-size: 1rem;
    }

    /* INCENSARIO */

    .incensario-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .incensario-heading h2 {
      font-size: clamp(3.2rem,12vw,5.4rem);
    }

    .incensario-year {
      flex-direction: row;
      align-items: center;
      gap: 15px;
    }

    .incensario-year strong {
      font-size: 2.6rem;
    }

    .incensario-photo {
      height: 500px;
    }

