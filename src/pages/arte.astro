</style>

<script>
  function initArtPage(): void {
    const page =
      document.querySelector<HTMLElement>(
        "#art-page"
      );

    if (
      !page ||
      page.dataset.initialized === "true"
    ) {
      return;
    }

    page.dataset.initialized = "true";

    // ==================================
    //  IMÁGENES CON FONDO DE RESERVA
    // ==================================

    const optionalImages =
      page.querySelectorAll<HTMLImageElement>(
        "[data-optional-image]"
      );

    optionalImages.forEach((image) => {
      const frame = image.closest<HTMLElement>(
        ".photo-frame"
      );

      if (!frame) return;

      const checkImage = () => {
        if (image.naturalWidth > 0) {
          frame.classList.add("has-photo");
        }
      };

      image.addEventListener(
        "load",
        checkImage
      );

      image.addEventListener(
        "error",
        () => {
          frame.classList.remove("has-photo");
        }
      );

      if (image.complete) {
        checkImage();
      }
    });

    // ==================================
    //       ANIMACIONES DE SCROLL
    // ==================================

    const revealElements =
      page.querySelectorAll<HTMLElement>(
        "[data-reveal]"
      );

    const prefersReducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (
      !prefersReducedMotion &&
      "IntersectionObserver" in window
    ) {
      page.classList.add("reveal-enabled");

      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add(
                "is-visible"
              );

              currentObserver.unobserve(
                entry.target
              );
            }
          });
        },
        {
          threshold: 0.03,
          rootMargin: "0px 0px 70px 0px",
        }
      );

      revealElements.forEach((element) => {
        observer.observe(element);
      });
    } else {
      revealElements.forEach((element) => {
        element.classList.add("is-visible");
      });
    }

    // ==================================
    //       BARRA DE PROGRESO
    // ==================================

    const progress =
      page.querySelector<HTMLElement>(
        "#reading-progress"
      );

    const updateProgress = () => {
      if (!progress) return;

      const maxScroll =
        document.documentElement.scrollHeight -
        window.innerHeight;

      const percentage =
        maxScroll > 0
          ? Math.min(
              100,
              Math.max(
                0,
                (window.scrollY / maxScroll) * 100
              )
            )
          : 0;

      progress.style.width = `${percentage}%`;
    };

    window.addEventListener(
      "scroll",
      updateProgress,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      updateProgress
    );

    updateProgress();

    // ==================================
    //        VISOR DE GALERÍA
    // ==================================

    const artworkCards =
      Array.from(
        page.querySelectorAll<HTMLButtonElement>(
          "[data-artwork]"
        )
      );

    const lightbox =
      page.querySelector<HTMLElement>(
        "#art-lightbox"
      );

    const closeButton =
      page.querySelector<HTMLButtonElement>(
        "#lightbox-close"
      );

    const prevButton =
      page.querySelector<HTMLButtonElement>(
        "#lightbox-prev"
      );

    const nextButton =
      page.querySelector<HTMLButtonElement>(
        "#lightbox-next"
      );

    const lightboxImage =
      page.querySelector<HTMLImageElement>(
        "#lightbox-image"
      );

    const lightboxEmpty =
      page.querySelector<HTMLElement>(
        "#lightbox-empty"
      );

    const emptyTitle =
      page.querySelector<HTMLElement>(
        "#lightbox-empty-title"
      );

    const titleElement =
      page.querySelector<HTMLElement>(
        "#lightbox-title"
      );

    const mediumElement =
      page.querySelector<HTMLElement>(
        "#lightbox-medium"
      );

    const yearElement =
      page.querySelector<HTMLElement>(
        "#lightbox-year"
      );

    const descriptionElement =
      page.querySelector<HTMLElement>(
        "#lightbox-description"
      );

    const countElement =
      page.querySelector<HTMLElement>(
        "#lightbox-count"
      );

    let selectedIndex = 0;
    let previousFocus: HTMLElement | null = null;
    let previousOverflow = "";

    function updateLightbox(index: number): void {
      if (!artworkCards.length || !lightboxImage || !lightboxEmpty) return;

      selectedIndex =
        (index + artworkCards.length) % artworkCards.length;

      const artwork = artworkCards[selectedIndex];
      const title = artwork.dataset.title || "Obra";
      const type = artwork.dataset.type || "Pintura";
      const year = artwork.dataset.year || "Sin fecha";
      const description = artwork.dataset.description || "";
      const imageSource = artwork.dataset.image || "";

      if (titleElement) titleElement.textContent = title;
      if (mediumElement) mediumElement.textContent = type;
      if (yearElement) yearElement.textContent = year;
      if (descriptionElement) descriptionElement.textContent = description;
      if (emptyTitle) emptyTitle.textContent = title;

      if (countElement) {
        const current = String(selectedIndex + 1).padStart(2, "0");
        const total = String(artworkCards.length).padStart(2, "0");
        countElement.textContent = `${current} / ${total}`;
      }

      // Cada imagen se carga directamente en el visor, sin depender
      // de si la miniatura lazy-loaded había terminado de cargarse.
      lightboxImage.hidden = true;
      lightboxEmpty.hidden = true;
      lightboxImage.removeAttribute("src");
      lightboxImage.alt = title;

      if (!imageSource) {
        lightboxEmpty.hidden = false;
        return;
      }

      const selectedSource = imageSource;
      lightboxImage.onload = () => {
        if (lightboxImage.getAttribute("src") !== selectedSource) return;
        lightboxImage.hidden = false;
        lightboxEmpty.hidden = true;
      };

      lightboxImage.onerror = () => {
        if (lightboxImage.getAttribute("src") !== selectedSource) return;
        lightboxImage.hidden = true;
        lightboxEmpty.hidden = false;
      };

      lightboxImage.src = selectedSource;
      if (lightboxImage.complete) {
        if (lightboxImage.naturalWidth > 0) {
          lightboxImage.hidden = false;
          lightboxEmpty.hidden = true;
        } else {
          lightboxEmpty.hidden = false;
        }
      }
    }

    function openLightbox(index: number): void {
      if (!lightbox) return;

      previousFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;

      previousOverflow =
        document.body.style.overflow;

      updateLightbox(index);

      lightbox.hidden = false;

      lightbox.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow = "hidden";

      closeButton?.focus();
    }

    function closeLightbox(): void {
      if (!lightbox || lightbox.hidden) {
        return;
      }

      lightbox.hidden = true;

      lightbox.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        previousOverflow;

      previousFocus?.focus();
    }

    // La pintura solo se amplía al hacer clic (o tocar en móvil).
    artworkCards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (lightbox?.hidden) {
          openLightbox(index);
        }
      });
    });

    closeButton?.addEventListener(
      "click",
      closeLightbox
    );

    prevButton?.addEventListener(
      "click",
      () => updateLightbox(selectedIndex - 1)
    );

    nextButton?.addEventListener(
      "click",
      () => updateLightbox(selectedIndex + 1)
    );

    lightbox?.addEventListener(
      "click",
      (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      }
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (!lightbox || lightbox.hidden) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        }

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          updateLightbox(selectedIndex - 1);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          updateLightbox(selectedIndex + 1);
        }

        if (event.key === "Tab") {
          const focusableElements =
            Array.from(
              lightbox.querySelectorAll<HTMLElement>(
                'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
              )
            );

          if (!focusableElements.length) {
            return;
          }

          const first = focusableElements[0];

          const last =
            focusableElements[
              focusableElements.length - 1
            ];

          if (
            event.shiftKey &&
            document.activeElement === first
          ) {
            event.preventDefault();
            last.focus();
          } else if (
            !event.shiftKey &&
            document.activeElement === last
          ) {
            event.preventDefault();
            first.focus();
          }
        }
      }
    );
  }

  document.addEventListener(
    "DOMContentLoaded",
    initArtPage
  );

  document.addEventListener(
    "astro:page-load",
    initArtPage
  );

  initArtPage();

  
</script>
