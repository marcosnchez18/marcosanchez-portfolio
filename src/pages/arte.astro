
---
import MainLayout from "../layouts/MainLayout.astro";
import Chatbot from "../components/Chatbot.astro";

const instagram = "https://www.instagram.com/marcosnchez18/";
const tiktok = "https://www.tiktok.com/@marcosnchez18";
const anitaWeb = "https://anitapalacios.es/";

const whatsapp =
  "https://wa.me/34622541527?text=" +
  encodeURIComponent(
    "Hola Marco, he visto tu galería de pintura y me gustaría hablar contigo sobre tus obras."
  );

const mapExhibition =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(
    "Casa Manolo Peña El Chusco, Chipiona, Cádiz"
  );

/*
  ==============================================
  TUS 15 OBRAS — EDITA AQUÍ TÍTULO Y FOTO
  ==============================================

  CÓMO ACTUALIZAR UNA PINTURA:
  - Guarda la foto en public/images/ (ejemplo: obra-02.png).
  - En la ficha de esa obra cambia:
       title       → título que se verá debajo de la imagen
       type        → técnica (por ejemplo, Óleo sobre lienzo)
       year        → año real de creación
       description → texto que aparece al ampliar la obra
       image       → URL desde /images/...
  - featured es una etiqueta reservada para futuras mejoras.

  Para añadir una obra 16, copia la ficha 15 y cambia
  number: "16" y sus demás campos. Los contadores
  se ajustan automáticamente según artworks.length.
*/

const artworks = [
  // ───────────── OBRA 01 ─────────────
  {
    number: "01",
    title: "El Incensario 2026",
    type: "Cartel artístico",
    year: "2026",
    description:
      "Una obra dedicada al incensario, a su humo y a su presencia en la Semana Santa de Sanlúcar de Barrameda.",
    image: "/images/obra-1.png",
    featured: true,
  },
  // ───────────── OBRA 02 ─────────────
  {
    number: "02",
    title: "Santísimo Cristo De Las Tres Caídas De Triana",
    type: "Pintura al óleo",
    year: "2025",
    description:
      "Obra dedicada al Santísimo Cristo De Las Tres Caídas De Triana (Sevilla).",
    image: "/images/triana.png",
    featured: false,
  },
  // ───────────── OBRA 03 ─────────────
  {
    number: "03",
    title: "Agüita de Cai",
    type: "Pintura al óleo",
    year: "2024",
    description:
      "Obra dedicada al agua de la playa de Santa María del Mar.",
    image: "/images/aguita.jpg",
    featured: false,
  },
  // ───────────── OBRA 04 ─────────────
  {
    number: "04",
    title: "Abuela Virtudes",
    type: "Pintura al óleo",
    year: "2023",
    description:
      "Obra dedicada a mi querida abuela Virtudes.",
    image: "/images/abuela.png",
    featured: false,
  },
  // ───────────── OBRA 05 ─────────────
  {
    number: "05",
    title: "Comunión de Cayetano",
    type: "Pintura al óleo",
    year: "2023",
    description:
      "Obra dedicada a mi hermano pequeño Cayetano el día de su primera comunión.",
    image: "/images/caye.png",
    featured: false,
  },
  // ───────────── OBRA 06 ─────────────
  {
    number: "06",
    title: "",
    type: "Ntra. Sra de la Victoria",
    year: "2022",
    description:
      "Obra dedicada Ntra. Sra de la Victoria (Sanlúcar de Bda).",
    image: "/images/vic.png",
    featured: false,
  },
  // ───────────── OBRA 07 ─────────────
  {
    number: "07",
    title: "Prendimiento",
    type: "Pintura al óleo",
    year: "2022",
    description:
      "Obra dedicada a Nuestro Padre Jesús del Prendimiento (Sanlúcar de Bda).",
    image: "/images/prendi.png",
    featured: false,
  },
  // ───────────── OBRA 08 ─────────────
  {
    number: "08",
    title: "Santísimo Cristo de la Expiración",
    type: "Pintura al óleo",
    year: "2016",
    description:
      "Obra dedicada al Santísimo Cristo de la Expiración (Sanlúcar de Bda).",
    image: "/images/expiracion.png",
    featured: false,
  },
  // ───────────── OBRA 09 ─────────────
  {
    number: "09",
    title: "María Santísima de la Esperanza Coronada",
    type: "Pintura al óleo",
    year: "2016",
    description:
      "Obra dedicada a María Santísima de la Esperanza Coronada (Sanlúcar de Bda).",
    image: "/images/espe.png",
    featured: false,
  },
  
];

const milestones = [
  {
    year: "DESDE LOS 5 AÑOS",
    heading: "Los primeros pinceles.",
    text:
      "Mi historia con la pintura comenzó siendo un niño. Con apenas cinco años asistía a distintas clases de pintura en Sanlúcar de Barrameda. Entonces todavía no sabía hasta dónde podría llevarme aquella afición; simplemente disfrutaba creando y descubriendo lo que podía expresar sobre un papel o un lienzo.",
    marker: "01",
  },
  {
    year: "2013",
    heading: "El encuentro que lo cambió todo.",
    text:
      "En 2013 comencé a asistir en Chipiona a las clases de Anita Palacios. Su manera de enseñar, su exigencia y su confianza me ayudaron a descubrir y desarrollar una capacidad artística que todavía tenía mucho por mostrar. Con ella aprendí a observar de otra manera y a trabajar cada obra con paciencia, sensibilidad y dedicación.",
    marker: "02",
  },
  {
    year: "2025",
    heading: "Compartir mi pintura con los demás.",
    text:
      "Participé en una exposición en el espacio Espacio Vacío, situado en Casa Manolo–Peña El Chusco, en Chipiona. Ver mi trabajo expuesto y compartirlo con otras personas fue una experiencia especialmente importante dentro de mi evolución como pintor.",
    marker: "03",
  },
  {
    year: "2026",
    heading: "El Incensario: un paso más.",
    text:
      "La realización de El Incensario 2026 supuso uno de los momentos más significativos de mi trayectoria artística: la oportunidad de presentar mi primer cartel relacionado con nuestra Semana Santa y de convertir en una obra una tradición que forma parte de mi ciudad.",
    marker: "04",
  },
  {
    year: "HOY",
    heading: "Seguir aprendiendo.",
    text:
      "Actualmente continúo asistiendo a las clases de Anita Palacios y profundizando en la pintura realista al óleo. Cada cuadro plantea un reto diferente. Cuanto más aprendo, más consciente soy de todo lo que todavía me queda por descubrir.",
    marker: "05",
  },
];

const processItems = [
  {
    number: "01",
    label: "DENTRO DEL TALLER",
    title: "Obras en proceso",
    description:
      "Un espacio para mostrar cómo va tomando forma una pintura, desde sus primeras etapas hasta los últimos detalles.",
    image: "/images/proceso.png",
    status: "EN ACTUALIZACIÓN",
  },
  {
    number: "02",
    label: "PRÓXIMOS PROYECTOS",
    title: "Lo que está por llegar",
    description:
      "Aquí compartiré nuevas ideas, próximas obras y proyectos artísticos cuando estén listos para enseñarlos.",
    image: "/images/cap.png",
    status: "PRÓXIMAMENTE",
  },
  {
    number: "03",
    label: "ACTUALIDAD ARTÍSTICA",
    title: "Novedades y exposiciones",
    description:
      "Un pequeño diario donde anunciar futuras exposiciones, presentaciones y otras noticias relacionadas con mi pintura.",
    image: "/images/ex.png",
    status: "SIN FECHAS ANUNCIADAS",
  },
];
---

<MainLayout
  title="Arte y pintura al óleo | Marco Sánchez"
  description="Descubre la faceta artística de Marco Sánchez: pintura realista al óleo, su trayectoria desde la infancia, sus obras, El Incensario 2026 y exposiciones en Chipiona."
>
  <main class="art-page" id="art-page">

    <div
      class="reading-progress"
      id="reading-progress"
      aria-hidden="true"
    ></div>

    <!-- ================================== -->
    <!--              HERO                 -->
    <!-- ================================== -->

    <section class="art-hero" aria-labelledby="art-title">

      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-light" aria-hidden="true"></div>

      <div class="container hero-layout">

        <div class="hero-copy">

          <div class="eyebrow-pill">
            <span class="gold-dot"></span>
            MI OTRA FORMA DE EXPRESARME
          </div>

          <p class="hero-kicker">
            MARCO SÁNCHEZ / ARTISTA AFICIONADO
          </p>

          <h1 id="art-title">
            Hay historias
            <span>que solo sé contar</span>
            <em>con pinceles.</em>
          </h1>

          

          <p class="hero-description">
            Desde pequeño, el arte ha formado parte
            de mi vida. Hoy encuentro en el
            <strong> óleo realista</strong> una forma
            de detenerme, observar y dar vida a
            aquello que me inspira.
          </p>

          <div class="hero-tags">
            <span class="hero-tag-gold">
              <span></span>
              Pintura al óleo
            </span>
            <span>23 años (18/04/2003)</span>
            <span>Realismo</span>
            <span>Aprendizaje continuo</span>
          </div>

          <div class="hero-actions">

            <a href="#galeria" class="art-button primary-button">
              Explorar mis obras
              <span aria-hidden="true">↗</span>
            </a>

            <a href="#historia" class="art-button outline-button">
              Conocer mi historia
              <span aria-hidden="true">↓</span>
            </a>

          </div>

          <div class="hero-bottom-label">
            <span class="small-line"></span>
            <span>EL ARTE COMO PARTE DE QUIÉN SOY</span>
          </div>

        </div>

        <!-- FOTO PRINCIPAL DEL ARTISTA -->

        <div class="hero-visual">

          <div class="hero-art-frame photo-frame">

            <div class="photo-placeholder">
              <span class="placeholder-corner corner-tl"></span>
              <span class="placeholder-corner corner-tr"></span>
              <span class="placeholder-corner corner-bl"></span>
              <span class="placeholder-corner corner-br"></span>

              <div class="placeholder-mark">
                <span>MS</span>
                <i>.</i>
              </div>

              <p>EL ARTISTA Y SU TALLER</p>
              <small>ESPACIO PARA FOTOGRAFÍA</small>
            </div>

            <img
              src="/images/abuela.png"
              alt="Marco Sánchez en su faceta como pintor"
              class="optional-photo"
              data-optional-image
            />

            <div class="hero-photo-shade"></div>

            <div class="photo-heading">
              <span>ART JOURNAL — 001</span>
              <strong>El arte de mirar.</strong>
            </div>

          </div>

          <div class="floating-note">
            <span class="floating-note-icon">✦</span>
            <div>
              <strong>Óleo & Realismo</strong>
              <small>Crear · Observar · Aprender</small>
            </div>
          </div>

          <div class="visual-side-label">
            <span>UNA PASIÓN QUE CRECE CON EL TIEMPO</span>
          </div>

        </div>

      </div>

      <a href="#manifiesto" class="hero-scroll">
        <span>↓</span>
        DESLIZA PARA EXPLORAR
      </a>

    </section>

    <!-- ================================== -->
    <!--           MANIFIESTO               -->
    <!-- ================================== -->

    <section class="manifesto-section" id="manifiesto">

      <div class="container manifesto-inner" data-reveal>

        <span class="manifesto-quote" aria-hidden="true">
          “
        </span>

        <p>
          Pintar no consiste únicamente en reproducir
          lo que vemos.
          <strong>
            Consiste en aprender a mirar aquello
            que antes pasaba desapercibido.
          </strong>
        </p>

        <div class="manifesto-signature">
          <span></span>
          <small>MI MANERA DE ENTENDER LA PINTURA</small>
          <span></span>
        </div>

      </div>

    </section>

    <!-- ================================== -->
    <!--          HISTORIA PERSONAL         -->
    <!-- ================================== -->

    <section
      class="history-section"
      id="historia"
      aria-labelledby="history-title"
    >
      <div class="container">

        <div class="section-eyebrow" data-reveal>
          <span></span>
          01 / MI HISTORIA CON LA PINTURA
        </div>

        <div class="history-layout">

          <div class="history-intro" data-reveal>

            <h2 id="history-title">
              Una pasión
              <span>que empezó</span>
              <em>mucho antes.</em>
            </h2>

            <p>
              Mi relación con el arte no comenzó
              como una profesión ni como un proyecto
              con objetivos definidos.
            </p>

            <p>
              Empezó siendo una afición de niño,
              una ilusión que se mantuvo con los años
              y que, gracias al aprendizaje y a la
              constancia, fue creciendo conmigo.
            </p>

            <div class="history-mini-card">
              <span>MI RECORRIDO</span>
              <strong>De los primeros trazos al realismo.</strong>
              <small>
                UNA HISTORIA QUE SIGUE ESCRIBIÉNDOSE.
              </small>
            </div>

          </div>

          <div class="timeline">

            {milestones.map((milestone) => (
              <article class="timeline-item" data-reveal>

                <div class="timeline-marker">
                  <span>{milestone.marker}</span>
                </div>

                <div class="timeline-content">
                  <span class="timeline-year">
                    {milestone.year}
                  </span>

                  <h3>{milestone.heading}</h3>

                  <p>{milestone.text}</p>
                </div>

              </article>
            ))}

          </div>

        </div>

      </div>
    </section>

    <!-- ================================== -->
    <!--          ANITA PALACIOS            -->
    <!-- ================================== -->

    <section class="mentor-section" aria-labelledby="mentor-title">

      <div class="container mentor-layout">

        <div class="mentor-visual" data-reveal>

          <div class="mentor-photo-frame photo-frame">

            <div class="photo-placeholder">
              <span class="placeholder-symbol">✦</span>
              <p>UNA ETAPA FUNDAMENTAL</p>
              <small>FOTOGRAFÍA DEL TALLER O DE CLASE</small>
            </div>

            <img
              src="/images/pint.png"
              alt="Recuerdo de las clases de pintura en el taller de Anita Palacios"
              class="optional-photo"
              data-optional-image
            />

          </div>

          <div class="mentor-frame-caption">
            <span>DESDE 2013</span>
            <span>CHIPIONA · CÁDIZ</span>
          </div>

        </div>

        <div class="mentor-copy" data-reveal>

          <div class="section-eyebrow">
            <span></span>
            UNA PERSONA FUNDAMENTAL
          </div>

          <h2 id="mentor-title">
            Hay maestros
            <span>que enseñan.</span>
            <em>Y otros que dejan huella.</em>
          </h2>

          <p>
            En 2013 comencé una etapa que cambiaría
            profundamente mi manera de entender la
            pintura: las clases de
            <strong> Anita Palacios, en Chipiona.</strong>
          </p>

          <p>
            Anita no solo me enseñó técnicas.
            Supo reconocer posibilidades en mí
            que yo todavía no había descubierto
            por completo. Con su orientación,
            su paciencia y su exigencia,
            fui ganando confianza, aprendiendo
            a observar y desarrollando mi propia
            sensibilidad artística.
          </p>

          <p>
            Con los años, aquella afición infantil
            fue evolucionando hacia la pintura
            realista al óleo, un camino que sigo
            recorriendo hoy.
          </p>

          <div class="mentor-quote">
            <span>“</span>
            <p>
              A día de hoy sigo aprendiendo de ella,
              porque cuanto más avanzas en el arte,
              más comprendes que nunca dejas
              de ser alumno.
            </p>
          </div>

          <a
            href={anitaWeb}
            target="_blank"
            rel="noopener noreferrer"
            class="art-text-link"
          >
            Conocer el trabajo de Anita Palacios
            <span aria-hidden="true">↗</span>
          </a>

        </div>

      </div>
    </section>

    <!-- ================================== -->
    <!--       EL INCENSARIO 2026           -->
    <!-- ================================== -->

    <section
      class="incensario-section"
      id="incensario"
      aria-labelledby="incensario-title"
    >

      <div class="incensario-background" aria-hidden="true"></div>

      <div class="container">

        <div class="section-eyebrow" data-reveal>
          <span></span>
          02 / UNA OBRA ESPECIAL
        </div>

        <div class="incensario-heading" data-reveal>

          <div>
            <span class="incensario-pretitle">
              CARTEL ARTÍSTICO · SEMANA SANTA
            </span>

            <h2 id="incensario-title">
              El Incensario
              <em>2026.</em>
            </h2>

            <p>
              Una obra que representa uno de los
              momentos más importantes de mi recorrido
              como pintor.
            </p>
          </div>

          <div class="incensario-year">
            <span>OBRA DESTACADA</span>
            <strong>2026</strong>
          </div>

        </div>

        <div class="incensario-layout">

          <!-- CARTEL -->

          <div class="incensario-artwork" data-reveal>

            <div class="incensario-gold-frame">

              <div class="incensario-photo photo-frame">

                <div class="photo-placeholder incensario-placeholder">
                  <span class="placeholder-symbol">✦</span>

                  <strong>
                    EL INCENSARIO
                    <em>2026</em>
                  </strong>

                  <small>
                    AQUÍ APARECERÁ EL CARTEL ORIGINAL
                  </small>
                </div>

                <img
                  src="/images/incensario.png"
                  alt="El Incensario 2026, cartel realizado por Marco Sánchez"
                  class="optional-photo"
                  data-optional-image
                />

              </div>

            </div>

            <div class="artwork-caption">
              <span>OBRA ORIGINAL / MARCO SÁNCHEZ</span>
              <span>2026</span>
            </div>

          </div>

          <!-- HISTORIA DEL CARTEL -->

          <div class="incensario-story" data-reveal>

            <span class="story-number">
              ARTWORK / 001
            </span>

            <h3>
              El aroma de
              <em>una tradición.</em>
            </h3>

            <p>
              Esta obra nace de la intención
              de dar protagonismo a un elemento
              tan característico de nuestra
              Semana Santa como el
              <strong> incensario.</strong>
            </p>

            <p>
              Su humo, su aroma y su movimiento
              forman parte de una atmósfera única.
              Quise llevar esa esencia al lienzo
              y transmitir, a través de la pintura,
              una pequeña parte de lo que representa
              esta tradición para Sanlúcar de Barrameda.
            </p>

            <p>
              Realizar <strong> El Incensario 2026 </strong>
              significó dar un paso que recordaría
              especialmente: presentar mi primer cartel
              para nuestra Semana Grande y compartir
              públicamente una obra muy personal.
            </p>

            <div class="incensario-details">

              <div>
                <span>OBRA</span>
                <strong>El Incensario 2026</strong>
              </div>

              <div>
                <span>TEMÁTICA</span>
                <strong>Semana Santa de Sanlúcar</strong>
              </div>

              
<div>
    <span>DÓNDE VISITAR</span>
  
    <a
      href="https://www.google.com/maps/search/?api=1&query=Taberna%20La%20O%20Sanl%C3%BAcar%20de%20Barrameda"
      target="_blank"
      rel="noopener noreferrer"
      style="display:inline-flex;align-items:center;gap:10px;color:#e1e4e8;text-decoration:none;font-size:.83rem;font-weight:600;"
    >
      Taberna La O · Sanlúcar
  
      <span
        aria-hidden="true"
        style="color:#d7a65c;font-size:1.3rem;"
      >
        ↗
      </span>
    </a>
  </div>
  

            </div>

            <div class="incensario-thanks">
              <span>AGRADECIMIENTOS</span>

              <p>
                Este proyecto también fue posible
                gracias a quienes confiaron en mí:
                <strong> Raúl Rodríguez</strong>,
                por brindarme la oportunidad
                de presentar mi primer cartel;
                <strong> Raúl Machuca</strong>,
                por facilitar la casa de hermandad
                del Prendimiento; y, muy especialmente,
                <strong> Anita Palacios</strong>,
                mi maestra, por acompañarme y enseñarme
                durante todos estos años.
              </p>
            </div>

            <a href="#galeria" class="art-text-link">
              Descubrir el resto de mis obras
              <span aria-hidden="true">↗</span>
            </a>

          </div>

        </div>

      </div>

    </section>

    <!-- ================================== -->
    <!--         EXPOSICIÓN CHIPIONA        -->
    <!-- ================================== -->

    <section
      class="exhibition-section"
      id="exposiciones"
      aria-labelledby="exhibition-title"
    >
      <div class="container">

        <div class="section-eyebrow" data-reveal>
          <span></span>
          03 / EXPOSICIONES Y ENCUENTROS
        </div>

        <div class="exhibition-layout">

          <div class="exhibition-copy" data-reveal>

            <div class="exhibition-year-badge">
              <span>EXPOSICIÓN</span>
              <strong>2025</strong>
            </div>

            <h2 id="exhibition-title">
              Cuando la pintura
              <span>sale del taller.</span>
            </h2>

            <p class="exhibition-lead">
              Compartir una obra con los demás
              es una experiencia muy diferente
              a crearla en la intimidad del estudio.
            </p>

            <p>
              En 2025 participé en una exposición
              colectiva en <strong>Espacio Vacío</strong>,
              en Casa Manolo–Peña El Chusco,
              en Chipiona, junto a obras de otros
              alumnos de Anita Palacios.
            </p>

            <p>
              Fue una oportunidad para mostrar
              mi trabajo, descubrir otras miradas
              y vivir la pintura como algo que
              también conecta a las personas.
            </p>

            <div class="exhibition-info">

              <div class="exhibition-info-item">
                <span>FECHAS</span>
                <strong>
                  27 de junio – 6 de julio de 2025
                </strong>
              </div>

              <div class="exhibition-info-item">
                <span>LUGAR</span>
                <strong>Espacio Vacío</strong>
              </div>

              <div class="exhibition-info-item">
                <span>UBICACIÓN</span>
                <strong>
                  Casa Manolo–Peña El Chusco,
                  Chipiona (Cádiz)
                </strong>
              </div>

            </div>

            <a
              href={mapExhibition}
              target="_blank"
              rel="noopener noreferrer"
              class="art-text-link"
            >
              Ver ubicación en Google Maps
              <span aria-hidden="true">↗</span>
            </a>

          </div>

          <!-- FOTOS EXPOSICIÓN -->

          <div class="exhibition-gallery" data-reveal>

            <div class="exhibition-picture picture-large photo-frame">
              <div class="photo-placeholder">
                <span class="placeholder-symbol">✦</span>
                <p>EXPOSICIÓN DE CHIPIONA</p>
                <small>FOTOGRAFÍA PRINCIPAL · 2025</small>
              </div>

              <img
                src="/images/exposicion.png"
                alt="Fotografía de la exposición de pintura celebrada en Chipiona en 2025"
                class="optional-photo"
                data-optional-image
              />
            </div>

    
            
<div
class="exhibition-picture picture-small photo-frame"
style="height: 380px; width: 100%; aspect-ratio: 3 / 4;"
>
