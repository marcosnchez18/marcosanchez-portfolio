    transition: color .2s ease;
  }

  .art-text-link:hover {
    color: var(--gold-light);
  }

  .art-text-link span {
    font-size: 1.25rem;
  }

  /* ======================================== */
  /*            FOTOGRAFÍAS OPCIONALES       */
  /* ======================================== */

  .photo-frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(215,166,92,.12),
        transparent 58%
      ),
