  .art-page a:focus-visible,
  .art-page button:focus-visible {
    outline: 2px solid var(--gold-light);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .art-page.reveal-enabled [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .art-button,
    .artwork-visual,
    .optional-photo,
