      else if (has(/\b(comercial|ventas|vendedor|atencion al cliente|repsol|teleperformance|negociacion|comunicacion)\b/)) {
        answer = "Marco también tiene experiencia comercial en Teleperformance (proyecto Repsol), que complementa su perfil técnico con habilidades de comunicación, orientación al cliente y trabajo por objetivos.";
      }

      else if (has(/\b(experiencia|trabajado|trabajo|empleo|empresas|rentel|curriculum|curriculo|cv|trayectoria|laboral|fullstack|full stack)\b/)) {
        answer = "Marco ha trabajado como desarrollador web full-stack en Rentel Comunicaciones y como agente comercial en Teleperformance, en el proyecto Repsol. Combina programación, creatividad y atención al cliente.";
      }

      else if (has(/\b(formacion|estudios|estudiado|titulo|estudiaste|daw|academia|bachillerato|instituto|universidad)\b/)) {
        answer = "Marco obtuvo en 2024 el título de Técnico Superior en Desarrollo de Aplicaciones Web (DAW) en el IES Doñana. También cursó el Bachillerato de Ciencias Tecnológicas.";
      }

      else if (has(/\b(ingles|idiomas|espanol|castellano|english)\b/)) {
        answer = "Marco habla castellano de forma nativa. En su currículum indica un nivel B1 de inglés.";
      }

      else if (has(/\b(github|linkedin|instagram|tiktok|redes sociales|redes)\b/)) {
        answer = "GitHub: github.com/marcosnchez18. LinkedIn: linkedin.com/in/marcosanchezES. En Instagram y TikTok su usuario es @marcosnchez18.";
      }

      else if (has(/\b(proyectos|trabajos realizados|que has hecho|que ha hecho|muestrame proyectos)\b/) && !artTopic) {
        answer = "Puedes visitar la sección Proyectos para conocer los trabajos de desarrollo de Marco. Si necesitas una web por encargo, puedes solicitar presupuesto por WhatsApp.";
        pageLink = { href: "/proyectos", label: "Ver proyectos ↗" };
      }

      else if (has(/\b(quien es|quien eres|quien es marco|sobre marco|sobre ti|presentate|conocerte|marco sanchez)\b/)) {
        answer = "Marco Sánchez es desarrollador web, profesional con experiencia comercial y artista especializado en pintura realista al óleo. Acepta encargos de páginas web y pinturas. Para más información y un presupuesto adecuado a cada servicio, lo mejor es hablar con él por WhatsApp.";
        channel = "general";
      }

      else if (artTopic) {
        answer = "Marco pinta obras realistas al óleo y acepta encargos. Para presupuestar pide una fotografía de referencia, medidas y características. Necesita varios meses de antelación; puedes ver obras en Arte o contactarlo por WhatsApp.";
        pageLink = { href: "/arte", label: "Explorar arte ↗" };
        channel = "arte";
      }

      else if (webTopic) {
        answer = "Marco realiza páginas web por encargo para clientes de España y del extranjero. Puedes solicitar webs corporativas, portfolios, tiendas online, landing pages, blogs y aplicaciones a medida. Todos los presupuestos se consultan directamente por WhatsApp.";
        channel = "web";
        pageLink = { href: "/proyectos", label: "Ver proyectos ↗" };
