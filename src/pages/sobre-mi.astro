        linkLabel = "Enviar detalles del cuadro ↗";
      }

      else if (artTopic && samples) {
        answer = "En la sección Arte puedes descubrir las obras de Marco. Trabaja pintura realista al óleo y acepta encargos de distintas temáticas dentro del realismo. Si te interesa uno, contáctalo con varios meses de antelación.";
