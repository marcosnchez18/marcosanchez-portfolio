      // PERFIL PROFESIONAL

      else if (has(/\b(tecnologias|tecnologia|lenguajes|framework|frameworks|stack|astro|typescript|javascript|react|angular|laravel|python|php|java|c#|next|tailwind|postgresql|mysql|base de datos|codigo|git|github|css|html)\b/)) {
