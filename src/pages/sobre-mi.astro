</style>

<script>
  // CHATBOT LOCAL GRATUITO

  type ReplyChannel = "web" | "arte" | "general";

  type Reply = {
    text: string;
    channel?: ReplyChannel;
    link?: {
      url: string;
      label: string;
    };
  };

  const whatsappBase = "https://wa.me/34622541527?text=";

  const whatsappWeb =
    whatsappBase +
    encodeURIComponent(
      "Hola Marco, me gustaría pedir un presupuesto para una página web."
    );

  const whatsappArte =
    whatsappBase +
    encodeURIComponent(
      "Hola Marco, me gustaría consultar un encargo de pintura al óleo."
    );

  const whatsappGeneral =
    whatsappBase +
    encodeURIComponent(
      "Hola Marco, he visitado tu web y me gustaría contactar contigo."
    );

  function normalizeText(value: string): string {
    return value
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[¿?¡!.,;:()]/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function getReply(question: string): Reply {
    const q = normalizeText(question);

    const has = (words: string[]) =>
      words.some((word) => q.includes(word));

    const web = has([
      "web",
      "pagina",
      "sitio",
      "landing",
      "ecommerce",
      "tienda online",
      "aplicacion",
      "software",
    ]);

    const art = has([
      "cuadro",
      "pintura",
      "oleo",
      "retrato",
      "lienzo",
      "pintar",
      "arte",
    ]);

    const price = has([
      "precio",
      "presupuesto",
      "cuanto cuesta",
      "cuanto vale",
      "tarifa",
    ]);

    // ESTUDIOS

    if (has([
      "estudio",
      "estudiaste",
      "estudios",
      "formacion",
      "bachillerato",
      "instituto",
      "daw",
    ])) {
      return {
        text:
          "Marco obtuvo en 2024 el título de Técnico " +
          "Superior en Desarrollo de Aplicaciones Web " +
          "en el IES Doñana. En 2021 finalizó el " +
          "Bachillerato de Ciencias Tecnológicas " +
          "en el IES Francisco Pacheco.",
        link: {
          url: "/sobre-mi#formacion",
          label: "Ver formación ↗",
        },
      };
    }

    // UBICACIÓN

    if (has([
      "donde vive",
      "de donde es",
      "ubicacion",
      "localizacion",
      "sanlucar",
      "cadiz",
      "ciudad",
      "mapa",
    ])) {
      return {
        text:
          "Marco es de Sanlúcar de Barrameda, " +
          "en la provincia de Cádiz, Andalucía. " +
          "En la sección de ubicación puedes ver " +
          "un mapa de la ciudad.",
        link: {
          url: "/sobre-mi#ubicacion",
          label: "Ver mapa y ubicación ↗",
        },
      };
    }

    // TECNOLOGÍAS

    if (has([
      "tecnologia",
      "lenguaje",
      "framework",
      "javascript",
      "typescript",
      "react",
      "angular",
      "laravel",
      "python",
      "php",
      "java",
      "astro",
    ])) {
      return {
        text:
          "Marco tiene conocimientos de JavaScript, " +
          "TypeScript, Java, PHP, Python, React, " +
          "Angular, Laravel, Astro y otras tecnologías " +
          "relacionadas con el desarrollo web.",
        link: {
          url: "/proyectos",
          label: "Ver proyectos ↗",
        },
      };
    }

    // IDIOMAS

    if (has([
      "ingles",
      "idioma",
      "espanol",
      "castellano",
    ])) {
      return {
        text:
          "Marco habla español de forma nativa " +
          "y tiene nivel B1 de inglés.",
      };
    }

    // CARNÉ

    if (has([
      "carnet",
      "carne",
      "conducir",
      "permiso b",
    ])) {
      return {
        text:
          "Marco dispone del permiso de conducir de clase B.",
      };
    }

    // CURRÍCULUM

    if (has([
      "curriculum",
      "curriculo",
      "descargar cv",
      "ver cv",
      "empleo",
      "oferta laboral",
    ])) {
      return {
        text:
          "Puedes descargar el currículum de Marco " +
          "para consultar su formación y experiencia.",
        link: {
          url: "/cv/Marco-Sanchez-CV.pdf",
          label: "Ver currículum ↗",
        },
      };
    }

    // PROYECTOS

    if (has([
      "proyecto",
      "github",
      "repositorio",
      "codigo",
    ])) {
      return {
        text:
          "Puedes conocer los proyectos de Marco " +
          "en la sección de Desarrollo. También " +
          "puedes visitar su GitHub.",
        link: {
          url: "/proyectos",
          label: "Ver proyectos ↗",
        },
      };
    }

    // EXPERIENCIA

    if (has([
      "experiencia",
      "repsol",
      "comercial",
      "rentel",
      "proteccion civil",
    ])) {
      return {
        text:
          "Marco ha adquirido experiencia en " +
          "diferentes ámbitos profesionales. " +
          "Puedes encontrar información más " +
          "detallada en Desarrollo y Otras experiencias.",
        link: {
          url: "/otras-experiencias",
          label: "Ver otras experiencias ↗",
        },
      };
    }

    // PRECIOS WEB

    if (web && price) {
      return {
        text:
          "Los presupuestos de desarrollo web " +
          "son personalizados según el tipo de " +
          "página, las funcionalidades y el proyecto.",
        channel: "web",
      };
    }

    // PRECIOS ARTE

    if (art && price) {
      return {
        text:
          "Los cuadros al óleo se presupuestan " +
          "individualmente. Marco necesita una foto " +
          "de referencia, medidas y detalles de " +
          "la obra. Los encargos requieren varios " +
          "meses de antelación.",
        channel: "arte",
      };
    }

    // ARTE

    if (art) {
      return {
        text:
          "Marco también realiza pinturas realistas " +
          "al óleo. Puedes conocer sus obras en Arte.",
        channel: "arte",
        link: {
          url: "/arte",
          label: "Ver arte ↗",
        },
      };
    }

    // DESARROLLO WEB

    if (web) {
      return {
        text:
          "Marco acepta proyectos de desarrollo web " +
          "como webs corporativas, portfolios, " +
          "tiendas online, blogs y aplicaciones " +
          "web a medida.",
        channel: "web",
        link: {
          url: "/proyectos",
          label: "Ver proyectos ↗",
        },
      };
    }

    // CONTACTO

    if (has([
      "contactar",
      "contacto",
      "whatsapp",
      "telefono",
      "hablar con marco",
      "escribir",
    ])) {
      return {
        text:
          "Puedes contactar con Marco mediante " +
          "WhatsApp, su página de Contacto o LinkedIn.",
        channel: "general",
        link: {
          url: "/contacto",
          label: "Ir a Contacto ↗",
        },
      };
    }

    // SALUDOS

    if (has([
      "hola",
      "buenas",
      "hey",
      "hello",
    ])) {
      return {
        text:
          "¡Hola! 👋 Puedes preguntarme por los " +
          "estudios, ubicación, tecnologías, proyectos " +
          "y contacto de Marco.",
      };
    }

    // DESPEDIDAS

    if (has([
      "gracias",
      "adios",
      "hasta luego",
    ])) {
      return {
        text:
          "¡Gracias por visitar la web de Marco! " +
          "Si necesitas algo más, aquí estaré.",
      };
    }

    // RESPUESTA GENERAL

    return {
      text:
        "No tengo una respuesta preparada para esa " +
        "pregunta. Puedes preguntarme por los estudios, " +
        "ubicación, proyectos o formas de contacto. " +
        "Para una consulta específica, escribe a Marco.",
      channel: "general",
    };
  }

  // INICIALIZAR CHATBOT

  function initMarcoChat(): void {
    const widget =
      document.querySelector<HTMLElement>("#marco-chat");

    if (!widget || widget.dataset.initialized === "true") {
      return;
    }

    const toggle =
      widget.querySelector<HTMLButtonElement>("#chat-toggle");

    const close =
      widget.querySelector<HTMLButtonElement>("#chat-close");

    const panel =
      widget.querySelector<HTMLElement>("#chat-panel");

    const form =
      widget.querySelector<HTMLFormElement>("#chat-form");

    const input =
      widget.querySelector<HTMLInputElement>("#chat-input");

    const messages =
      widget.querySelector<HTMLElement>("#chat-messages");

    const suggestions =
      widget.querySelector<HTMLElement>("#chat-suggestions");

    if (
      !toggle ||
      !close ||
      !panel ||
      !form ||
      !input ||
      !messages ||
      !suggestions
    ) {
      return;
    }

    const ui = {
      toggle,
      close,
      panel,
      form,
      input,
      messages,
      suggestions,
    };

    widget.dataset.initialized = "true";

    function setOpen(open: boolean): void {
      ui.panel.toggleAttribute("hidden", !open);

      ui.panel.setAttribute(
        "aria-hidden",
        String(!open)
      );

      ui.toggle.setAttribute(
        "aria-expanded",
        String(open)
      );

      ui.toggle.setAttribute(
        "aria-label",
        open
          ? "Cerrar asistente virtual"
          : "Abrir asistente virtual"
      );

      if (open) {
        ui.input.focus();
      } else {
        ui.toggle.focus();
      }
    }

    function addMessage(
      value: string,
      sender: "user" | "bot"
    ): void {
      const bubble = document.createElement("div");

      bubble.className =
        sender === "user"
          ? "chat-bubble user-bubble"
          : "chat-bubble bot-bubble";

      bubble.textContent = value;

      ui.messages.appendChild(bubble);

      ui.messages.scrollTop =
        ui.messages.scrollHeight;
    }

    function addLink(
      url: string,
      label: string,
      isWhatsapp = false
    ): void {
      const link = document.createElement("a");

      link.href = url;
      link.textContent = label;

      link.className = isWhatsapp
        ? "chat-whatsapp"
        : "chat-page-link";

      if (url.startsWith("https://")) {
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }

      ui.messages.appendChild(link);
    }

    function sendQuestion(value: string): void {
      const question = value.trim();

      if (!question) {
        return;
      }

      addMessage(question, "user");

      const reply = getReply(question);

      addMessage(reply.text, "bot");

      if (reply.link) {
        addLink(
          reply.link.url,
          reply.link.label
        );
      }

      if (reply.channel) {
        const url =
          reply.channel === "web"
            ? whatsappWeb
            : reply.channel === "arte"
              ? whatsappArte
              : whatsappGeneral;

        addLink(
          url,
          "Hablar con Marco por WhatsApp ↗",
          true
        );
      }

      ui.messages.scrollTop =
        ui.messages.scrollHeight;
    }

    // ABRIR / CERRAR

    ui.toggle.addEventListener("click", () => {
      setOpen(
        ui.panel.hasAttribute("hidden")
      );
    });

    ui.close.addEventListener("click", () => {
      setOpen(false);
    });

    // ENVIAR MENSAJE

    ui.form.addEventListener("submit", (event) => {
      event.preventDefault();

      sendQuestion(ui.input.value);

      ui.input.value = "";
      ui.input.focus();
    });

    // PREGUNTAS RÁPIDAS

    ui.suggestions.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const button =
        target.closest<HTMLButtonElement>(
          "button[data-question]"
        );

      if (button) {
        sendQuestion(
          button.dataset.question ?? ""
        );
      }
    });

    // CERRAR CON ESCAPE

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !ui.panel.hasAttribute("hidden")
      ) {
        setOpen(false);
      }
    });
  }

  document.addEventListener(
    "DOMContentLoaded",
    initMarcoChat
  );

  document.addEventListener(
    "astro:page-load",
    initMarcoChat
  );

  initMarcoChat();
</script>
