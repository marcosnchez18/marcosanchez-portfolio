<script>
  // CHATBOT GRATUITO: MISMO FUNCIONAMIENTO QUE EN INDEX

  function initMarcoChat() {
    const widget = document.querySelector<HTMLElement>("#marco-chat");
    if (!widget || widget.dataset.initialized === "true") return;

    const toggle = widget.querySelector<HTMLButtonElement>("#chat-toggle");
    const close = widget.querySelector<HTMLButtonElement>("#chat-close");
    const panel = widget.querySelector<HTMLElement>("#chat-panel");
    const form = widget.querySelector<HTMLFormElement>("#chat-form");
    const input = widget.querySelector<HTMLInputElement>("#chat-input");
    const messages = widget.querySelector<HTMLElement>("#chat-messages");
    const suggestions = widget.querySelector<HTMLElement>("#chat-suggestions");

    if (!toggle || !close || !panel || !form || !input || !messages || !suggestions) {
      return;
    }

    widget.dataset.initialized = "true";

    const whatsAppBase = "https://wa.me/34622541527?text=";

    const whatsappWeb = whatsAppBase + encodeURIComponent(
      "Hola Marco, he visto tu portfolio y me gustaría pedirte un presupuesto de desarrollo web. Mi proyecto consiste en: "
    );

    const whatsappArte = whatsAppBase + encodeURIComponent(
      "Hola Marco, he visto tu portfolio y me gustaría consultar un presupuesto para un cuadro realista al óleo. Puedo enviarte la foto de referencia, las medidas y los detalles."
    );

    const whatsappGeneral = whatsAppBase + encodeURIComponent(
      "Hola Marco, he visitado tu portfolio y me gustaría hacerte una consulta."
    );

    // Elementos comprobados para evitar errores de TypeScript
    const ui = { toggle, close, panel, form, input, messages, suggestions };

    function setOpen(open: boolean) {
      ui.panel.hidden = !open;
      ui.panel.setAttribute("aria-hidden", String(!open));
      ui.toggle.setAttribute("aria-expanded", String(open));
      ui.toggle.setAttribute(
        "aria-label",
        open ? "Cerrar asistente virtual" : "Abrir asistente virtual"
      );

      if (open) ui.input.focus();
      else ui.toggle.focus();
    }

    function addMessage(message: string, type: "user" | "bot") {
      const bubble = document.createElement("div");
      bubble.className = `chat-bubble ${type === "user" ? "user-bubble" : "bot-bubble"}`;
      bubble.textContent = message;
      ui.messages.appendChild(bubble);
      ui.messages.scrollTop = ui.messages.scrollHeight;
    }

    function normalise(value: string) {
      return value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

    function respond(question: string) {
      const q = normalise(question)
        .replace(/[¿?¡!.,;:()]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

      const has = (pattern: RegExp) => pattern.test(q);

      const webTopic = has(/\b(web|webs|pagina|paginas|sitio|sitios|landing|tienda|ecommerce|e commerce|comercio electronico|blog|blogs|portfolio|portafolio|aplicacion|aplicaciones|app|apps|software|frontend|backend|fullstack|full stack|diseno web|desarrollo web|programacion|programador|desarrollador|seo|dominio|hosting|mantenimiento|responsive|wordpress|negocio online|presencia online|web corporativa|reservas online)\b/);

      const artTopic = has(/\b(cuadro|cuadros|oleo|pintura|pinturas|pintar|pintas|pinta|lienzo|lienzos|retrato|retratos|paisaje|paisajes|obra de arte|obras de arte|arte|artista|realismo|realista|dibuj|ilustracion|pincel)\b/);

      const money = has(/\b(precio|precios|cuanto cuesta|cuanto vale|cuanto cobras|cuanto cobra|coste|costo|presupuesto|presupuestos|tarifa|tarifas|pagar|pago|euros|economico|barato|cotizacion|cotizar)\b/);

      const schedule = has(/\b(plazo|plazos|cuando|tardas|tarda|tiempo|disponibilidad|disponible|urgente|prisa|antelacion|meses|semanas|entrega|fecha|cuanto tard|para manana|para la semana)\b/);

      const contact = has(/\b(whatsapp|telefono|numero|contactar|contacto|hablar|escribir|llamar|contratar|contratacion|mensaje|reunir|reunion|consulta|consultar)\b/);

      const samples = has(/\b(ejemplos|muestras|trabajos|proyectos|galeria|ver cuadros|ver webs|ver ejemplos|portafolio|portfolio)\b/);

      const webService = has(/\b(hace|haces|realiza|realizas|crea|creas|disena|disenas|encargo|encargar|contratar|servicio|servicios|necesito|quiero|busco|montar|crear|hacer|ofreces|ofrece|puedes|puede|desarrollas|desarrolla)\b/);

      const artService = has(/\b(encargo|encargar|personalizado|personalizada|acepta|hace|pinta|puedes|puede|quiero|necesito|regalo|foto|fotografia|retrato|paisaje|copia|medidas|tamano|dimensiones|enviar|mandar)\b/);

      type Channel = "web" | "arte" | "general" | null;

      let channel: Channel = null;
      let answer = "";
      let linkLabel = "Hablar con Marco por WhatsApp ↗";
      let pageLink: { href: string; label: string } | null = null;

      // AMBOS SERVICIOS

      if (webTopic && artTopic && (money || webService || artService || contact)) {
        answer = "¡Sí! Marco realiza páginas web por encargo y pinturas realistas al óleo. En ambos casos prepara presupuestos personalizados después de conocer los detalles, siempre por WhatsApp. Para pintura, solicita el encargo con varios meses de antelación.";
