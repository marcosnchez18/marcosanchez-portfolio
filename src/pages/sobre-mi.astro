      else if (webTopic && has(/\b(tipos|tipo|clases|corporativa|corporativas|empresa|empresas|negocio|negocios|portfolio|portafolio|tienda|tiendas|ecommerce|e commerce|blog|blogs|landing|aplicaciones a medida|aplicacion a medida|a medida|personalizada|personalizadas)\b/)) {
