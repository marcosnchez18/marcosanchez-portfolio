
---
import MainLayout from "../layouts/MainLayout.astro";

const technologies = [
  "JavaScript", "TypeScript", "Astro", "PHP", "Python", "Java", "C#",
  "React", "Angular", "Laravel", "Next.js", "Vue.js", "Django",
  "Node.js", "FastAPI", "Tailwind CSS", "Bootstrap", ".NET",
];

const databases = ["PostgreSQL", "MySQL", "MariaDB", "SQL Server"];

const practicalSkills = [
  "Desarrollo frontend y backend",
  "APIs REST y autenticación",
  "Diseño responsive y UI/UX",
  "Git y control de versiones",
  "Entornos Linux y despliegue",
  "Configuración y administración de redes",
  "Comunicación y atención al cliente",
  "Trabajo por objetivos y en equipo",
];
---

<MainLayout
  title="Sobre mí | Marco Sánchez — Desarrollador web y artista"
  description="Conoce a Marco Sánchez: técnico superior en Desarrollo de Aplicaciones Web, experiencia full-stack y comercial, formación, habilidades y trayectoria en pintura realista al óleo. Descarga su CV."
>

  <!-- PRESENTACIÓN -->

  <section class="about-hero" aria-labelledby="about-title">
    <div class="page-shell hero-grid">

      <div class="hero-copy">
        <p class="eyebrow">
          <span></span>
          CONÓCEME
          <span></span>
        </p>

        <h1 id="about-title">
          Detrás del código,
          <em>la persona.</em>
        </h1>

        <p class="hero-lead">
          Soy <strong>Marco Sánchez</strong>, técnico superior en Desarrollo
          de Aplicaciones Web, profesional con experiencia comercial y
          pintor al óleo. Mi trayectoria une tecnología, trato humano
          y sensibilidad artística.
        </p>

        <p class="hero-detail">
          Me apasiona construir soluciones web funcionales, seguir
          aprendiendo y aportar una visión creativa a los proyectos.
          Actualmente trabajo en el ámbito comercial para el proyecto
          de Repsol y busco nuevas oportunidades profesionales
          en el desarrollo web.
        </p>

        <div class="hero-actions">
          <a
            class="button button-gold"
            href="/cv/Marco-Sanchez-CV.pdf"
            download="Marco-Sanchez-CV.pdf"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3h16v-3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Descargar mi CV
          </a>

          <a class="button button-outline" href="/contacto">
            Contactar conmigo
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-points" aria-label="Datos principales">
          <span>Sanlúcar de Barrameda, Cádiz</span>
          <span>DAW · 2024</span>
          <span>Desarrollo web y arte</span>
        </div>
      </div>

      <!-- FOTOGRAFÍAS PERSONALES -->

      <div class="hero-gallery" aria-label="Fotografías de Marco Sánchez">

        <figure class="photo photo-main">
          <div class="photo-placeholder" aria-hidden="true">
            <span>01</span>
            <small>Tu fotografía principal</small>
          </div>
          <img
            src="/images/marco-retrato-1.jpg"
            alt="Retrato profesional de Marco Sánchez"
            loading="eager"
            onerror="this.style.display='none'"
          />
        </figure>

        <figure class="photo photo-second">
          <div class="photo-placeholder" aria-hidden="true">
            <span>02</span>
            <small>Tu segunda fotografía</small>
          </div>
          <img
            src="/images/marco-retrato-2.jpg"
            alt="Segunda fotografía de Marco Sánchez"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </figure>

        <span class="gallery-accent" aria-hidden="true">
          MS <i>·</i> WEB &amp; ART
        </span>
      </div>

    </div>
  </section>

  <!-- EXPERIENCIA PROFESIONAL -->

  <section
    class="section section-toned"
    id="trayectoria"
    aria-labelledby="career-heading"
  >
    <div class="page-shell">

      <div class="section-heading">
        <p class="eyebrow">MI RECORRIDO</p>
        <h2 id="career-heading">Experiencia <em>profesional.</em></h2>
        <p>
          Una trayectoria que combina desarrollo de software,
          comunicación, responsabilidad y orientación a las personas.
        </p>
      </div>

      <div class="timeline">

        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-meta">
            Actualidad · Aproximadamente 2 años de experiencia
          </div>
          <h3>Agente comercial · Proyecto Repsol Luz y Gas</h3>
          <p class="timeline-company">
            Teleperformance Spain · Jerez de la Frontera
          </p>
          <p>
            Experiencia en atención al cliente, comunicación comercial,
            orientación a resultados, resolución de dudas y trabajo en equipo.
            Este trabajo ha reforzado mi capacidad para comprender
            necesidades y ofrecer soluciones claras.
          </p>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-meta">Octubre – diciembre de 2024</div>
          <h3>Desarrollador web full-stack</h3>
          <p class="timeline-company">
            Rentel Comunicaciones S. L. · Sanlúcar de Barrameda
          </p>
          <p>
            Desarrollo de aplicaciones web, interfaces responsive y
            funcionalidades de backend. Trabajo con PHP y Laravel,
            APIs REST, autenticación, formularios y bases de datos,
            además de interfaces con React y Angular.
          </p>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-meta">Verano de 2024</div>
          <h3>Socorrista acuático en playa</h3>
          <p class="timeline-company">
            Protección Civil · Sanlúcar de Barrameda
          </p>
          <p>
            Labores de prevención, vigilancia y respuesta ante
            situaciones que requieren atención, responsabilidad
            y capacidad de decisión.
          </p>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-meta">Verano de 2023</div>
          <h3>Vigilante de playa en torre</h3>
          <p class="timeline-company">
            Protección Civil · Sanlúcar de Barrameda
          </p>
          <p>
            Vigilancia preventiva y colaboración en tareas de seguridad
            en el entorno de playa.
          </p>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-meta">Junio de 2023 – octubre de 2024</div>
          <h3>Voluntariado en Protección Civil</h3>
          <p class="timeline-company">Sanlúcar de Barrameda</p>
          <p>
            Participación en servicios de apoyo y colaboración,
            desarrollando disciplina, compañerismo y capacidad
            para actuar bajo presión.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- ESTUDIOS Y COMPETENCIAS -->

  <section
    class="section"
    id="formacion"
    aria-labelledby="education-heading"
  >
    <div class="page-shell">

      <div class="section-heading">
        <p class="eyebrow">APRENDIZAJE CONTINUO</p>
        <h2 id="education-heading">
          Formación y <em>competencias.</em>
        </h2>
      </div>

      <div class="education-grid">

        <div class="panel">
          <h3>Formación académica</h3>

          <div class="degree">
            <span class="year">2024</span>
            <div>
              <h4>Técnico Superior en Desarrollo de Aplicaciones Web</h4>
              <p>IES Doñana · Sanlúcar de Barrameda</p>
            </div>
          </div>

          <div class="degree">
            <span class="year">2021</span>
            <div>
              <h4>Bachillerato de Ciencias Tecnológicas</h4>
              <p>IES Francisco Pacheco · Sanlúcar de Barrameda</p>
            </div>
          </div>

          <div class="panel-divider"></div>

          <h3>Idiomas y otros datos</h3>

          <ul class="info-list">
            <li><strong>Español:</strong> nativo</li>
            <li><strong>Inglés:</strong> nivel B1</li>
            <li><strong>Permiso de conducir:</strong> clase B</li>
            <li><strong>Modalidad:</strong> preparado para el trabajo remoto</li>
          </ul>
        </div>

        <div class="panel">
          <h3>Lenguajes y herramientas</h3>
          <p class="panel-intro">
            Tecnologías recogidas en mi formación y experiencia,
            junto con Astro y TypeScript, que utilizo en este portfolio.
          </p>

          <div class="chip-list">
            {technologies.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>

          <h4 class="subheading">Bases de datos</h4>
          <div class="chip-list">
            {databases.map((db) => (
              <span class="chip chip-subtle">{db}</span>
            ))}
          </div>

          <h4 class="subheading">Otras competencias</h4>
          <ul class="skills-list">
            {practicalSkills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- HISTORIA ARTÍSTICA -->

  <section
    class="section art-section"
    id="pintura"
    aria-labelledby="art-heading"
  >
    <div class="page-shell art-grid">

      <figure class="photo photo-art">
        <div class="photo-placeholder" aria-hidden="true">
          <span>03</span>
          <small>Tu fotografía pintando</small>
        </div>
        <img
          src="/images/marco-pintando.jpg"
          alt="Marco Sánchez pintando un cuadro al óleo"
          loading="lazy"
          onerror="this.style.display='none'"
        />
      </figure>

      <div class="art-copy">
        <p class="eyebrow">MI OTRA PASIÓN</p>
        <h2 id="art-heading">La pintura, <em>desde niño.</em></h2>

        <p>
          Comencé a pintar siendo muy pequeño, asistiendo a clases
          de pintura. En <strong>2013</strong> conocí a
          <a
            href="https://anitapalacios.es/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Anita Palacios <span aria-hidden="true">↗</span>
          </a>,
          una artista a la que admiro profundamente y que ha sido
          mi maestra desde entonces hasta hoy.
        </p>

        <p>
          Trabajo principalmente el <strong>realismo en pintura al óleo</strong>.
          Para mí, cada obra es una oportunidad de aprender: observo
          la luz, los volúmenes, los colores y los pequeños detalles,
          buscando acercarme cada día más al <strong>hiperrealismo</strong>.
        </p>

        <p>
          Por mis actuales compromisos laborales, acepto
          <strong> encargos personalizados con varios meses de antelación</strong>.
          Para valorar una obra, solicito una fotografía de referencia,
          las medidas y las características deseadas.
          Los presupuestos se consultan directamente por WhatsApp.
        </p>

        <div class="art-actions">
          <a class="button button-gold" href="/arte">
            Ver mis obras <span aria-hidden="true">↗</span>
          </a>

          <a
            class="text-link"
            href="https://wa.me/34622541527?text=Hola%20Marco%2C%20me%20gustar%C3%ADa%20consultarte%20un%20encargo%20de%20pintura%20al%20%C3%B3leo."
            target="_blank"
            rel="noopener noreferrer"
          >
            Consultar un encargo por WhatsApp ↗
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- OBJETIVO PROFESIONAL -->

  <section class="section closing-section" aria-labelledby="closing-heading">
    <div class="page-shell closing-inner">

      <p class="eyebrow">MI PRÓXIMO RETO</p>
      <h2 id="closing-heading">
        Busco una oportunidad para <em>seguir creciendo.</em>
      </h2>

      <p>
        Quiero formar parte de proyectos de desarrollo web donde
        pueda aportar mi formación técnica, mi experiencia trabajando
        con personas y mi atención al detalle. Estoy abierto a conversar
        sobre oportunidades laborales, colaboraciones y nuevos proyectos.
      </p>

      <div class="hero-actions closing-actions">
        <a
          class="button button-gold"
          href="/cv/Marco-Sanchez-CV.pdf"
          download="Marco-Sanchez-CV.pdf"
        >
          Descargar currículum ↓
        </a>
        <a class="button button-outline" href="/contacto">Hablemos ↗</a>
        <a
          class="button button-outline"
          href="https://www.linkedin.com/in/marcosanchezES"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
        <a
          class="button button-outline"
          href="https://github.com/marcosnchez18"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>

    </div>
  </section>

  <!-- CHATBOT ORIGINAL DE INDEX -->
  <!-- MISMO DISEÑO Y MISMA FUNCIONALIDAD -->

  <div class="chat-widget" id="marco-chat">

    <section
      class="chat-panel"
      id="chat-panel"
      aria-label="Asistente virtual de Marco"
      aria-hidden="true"
      hidden
    >

      <div class="chat-header">
        <div class="chat-avatar" aria-hidden="true">MS</div>

        <div class="chat-heading">
          <strong>Asistente de Marco</strong>
          <span>Respuestas rápidas · Gratuito</span>
        </div>

        <button
          type="button"
          class="chat-close"
          id="chat-close"
          aria-label="Cerrar chat"
        >
          ×
        </button>
      </div>

      <div
        class="chat-messages"
        id="chat-messages"
        role="log"
        aria-live="polite"
        aria-relevant="additions text"
      >
        <div class="chat-bubble bot-bubble">
          ¡Hola! 👋 Soy el asistente virtual de Marco.
          ¿Necesitas una página web, un cuadro realista al óleo
          o quieres conocer el trabajo de Marco?
          Puedo orientarte y ayudarte a pedir un presupuesto por WhatsApp.
        </div>
      </div>

      <div
        class="chat-suggestions"
        id="chat-suggestions"
        aria-label="Preguntas frecuentes"
      >
        <button type="button" data-question="¿Haces páginas web por encargo?">
          Crear mi web
        </button>
        <button type="button" data-question="¿Cuánto cuesta una página web?">
          Presupuesto web
        </button>
        <button type="button" data-question="¿Haces cuadros al óleo por encargo?">
          Pintura al óleo
        </button>
        <button type="button" data-question="¿Qué tipos de páginas web haces?">
          Tipos de webs
        </button>
        <button type="button" data-question="¿Qué incluye una web?">
          Qué incluye
        </button>
        <button type="button" data-question="¿Trabajas con clientes internacionales?">
          Clientes internacionales
        </button>
        <button type="button" data-question="¿Qué tecnologías conoce Marco?">
          Tecnologías
        </button>
      </div>

      <form class="chat-form" id="chat-form">
        <label for="chat-input" class="sr-only">
          Escribe tu pregunta
        </label>

        <input
          id="chat-input"
          name="question"
          type="text"
          placeholder="Escribe tu pregunta..."
          maxlength="280"
          autocomplete="off"
          required
        />

        <button type="submit" aria-label="Enviar mensaje">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </button>
      </form>

      <p class="chat-disclaimer">
        Asistente automático con respuestas preparadas. No es IA generativa.
      </p>

    </section>

    <button
      type="button"
      class="chat-toggle"
      id="chat-toggle"
      aria-label="Abrir asistente virtual"
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3H13a8.48 8.48 0 0 1 8 8v.5Z"/>
      </svg>
      <span>¿Hablamos?</span>
    </button>

  </div>

</MainLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }

  .page-shell { width: min(calc(100% - 80px), 1320px); margin-inline: auto; }
  .about-hero { padding: 100px 0 105px; background: radial-gradient(ellipse at 80% 28%, #33251b 0%, #17110e 38%, #100d0b 75%); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(40px, 6vw, 100px); }
  .eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 24px; color: #d7a65c; font-size: .76rem; font-weight: 600; letter-spacing: .25em; }
  .eyebrow span { display: block; height: 1px; width: 34px; background: #d7a65c; }
  h1, h2 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; letter-spacing: -.042em; color: #ece0d3; }
  h1 { font-size: clamp(3.5rem, 5.5vw, 6.4rem); line-height: 1.09; margin: 0 0 27px; }
  h2 { font-size: clamp(2.5rem, 4.3vw, 4.4rem); line-height: 1.16; margin: 0 0 26px; }
  h1 em, h2 em { color: #e0b173; font-weight: 400; }
  p { color: #bfb0a4; line-height: 1.85; }
  .hero-lead { color: #e0d3c5; font-size: clamp(1.06rem, 1.5vw, 1.2rem); }
  .hero-lead strong, .art-copy strong { color: #f0d9b7; font-weight: 600; }
  .hero-detail { font-size: 1rem; }
  .hero-actions, .art-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 11px; border: 1px solid transparent; border-radius: 9px; padding: 12px 22px; font-size: .95rem; font-weight: 600; text-decoration: none; transition: transform .2s, background .2s, border-color .2s; }
  .button:hover { transform: translateY(-2px); }
  .button:focus-visible, .text-link:focus-visible, .art-copy a:focus-visible { outline: 2px solid #e0b173; outline-offset: 4px; }
  .button svg { height: 19px; width: 19px; }
  .button-gold { background: #dfb173; color: #17110b; }
  .button-gold:hover { background: #f0c58c; }
  .button-outline { border-color: rgba(223,177,115,.44); color: #eedfcd; background: rgba(223,177,115,.035); }
  .button-outline:hover { background: rgba(223,177,115,.13); }
  .hero-points { display: flex; flex-wrap: wrap; gap: 12px 20px; color: #a99889; font-size: .8rem; margin-top: 30px; }
  .hero-points span:not(:last-child)::after { content: "•"; margin-left: 20px; color: #b68d56; }
  .hero-gallery { position: relative; height: min(580px, 46vw); min-height: 430px; }
  .photo { position: relative; margin: 0; overflow: hidden; background: linear-gradient(145deg, #34271d, #19120f 66%, #100d0b); border: 1px solid rgba(215,166,92,.35); box-shadow: 0 24px 70px rgba(0,0,0,.3); }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 2; }
  .photo-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: rgba(224,177,115,.65); text-align: center; padding: 16px; }
  .photo-placeholder span { font-family: Georgia, serif; font-size: clamp(3rem, 7vw, 6rem); font-style: italic; opacity: .45; }
  .photo-placeholder small { font-size: .8rem; letter-spacing: .08em; }
  .photo-main { position: absolute; top: 0; right: 0; width: 76%; height: 83%; border-radius: 170px 170px 10px 10px; }
  .photo-second { position: absolute; bottom: 0; left: 0; width: 49%; height: 54%; border: 7px solid #17110e; border-radius: 130px 130px 9px 9px; z-index: 3; }
  .gallery-accent { position: absolute; bottom: 10px; right: 0; color: #d7a65c; font-family: Georgia, serif; letter-spacing: .2em; font-size: .78rem; }
  .gallery-accent i { font-style: normal; padding-inline: 8px; }
  .section { padding: 110px 0; background: #100d0b; }
  .section-toned { background: #17120f; }
  .section-heading { max-width: 780px; margin-bottom: 55px; }
  .section-heading > p:last-child { max-width: 690px; font-size: 1.06rem; }
  .timeline { position: relative; max-width: 940px; padding-left: 44px; border-left: 1px solid rgba(215,166,92,.3); }
  .timeline-item { position: relative; padding: 0 0 37px; }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-marker { position: absolute; left: -51px; top: 5px; width: 13px; height: 13px; border-radius: 50%; background: #d7a65c; border: 3px solid #17120f; box-shadow: 0 0 0 1px #d7a65c; }
  .timeline-meta { color: #d7a65c; font-size: .79rem; letter-spacing: .07em; margin-bottom: 8px; }
  .timeline h3 { margin: 0; font-family: Georgia, serif; font-size: clamp(1.3rem, 2vw, 1.75rem); font-weight: 400; color: #f0e1d2; }
  .timeline-company { margin: 6px 0 12px; color: #cfb28b; font-size: .92rem; }
  .timeline-item > p:last-child { max-width: 750px; margin: 0; }
  .education-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 22px; }
  .panel { height: 100%; padding: 35px; border: 1px solid rgba(215,166,92,.18); border-radius: 16px; background: #181310; }
  .panel h3 { margin: 0 0 26px; font-family: Georgia,serif; font-weight: 400; color: #ead8c4; font-size: 1.65rem; }
  .degree { display: grid; grid-template-columns: 60px 1fr; gap: 14px; margin: 0 0 28px; }
  .degree .year { color: #d7a65c; font-size: .86rem; padding-top: 3px; }
  .degree h4 { margin: 0; color: #eddfd1; font-size: 1rem; font-weight: 600; line-height: 1.45; }
  .degree p { margin: 5px 0 0; font-size: .9rem; }
  .panel-divider { height: 1px; background: rgba(215,166,92,.19); margin: 34px 0; }
  .info-list, .skills-list { list-style: none; padding: 0; margin: 0; }
  .info-list li { color: #beafa1; padding: 7px 0; line-height: 1.55; }
