
---
import MainLayout from "../layouts/MainLayout.astro";

const studies = [
  {
    number: "01",
    year: "2024",
    category: "GRADO SUPERIOR",
    title: "Desarrollo de Aplicaciones Web",
    institution: "IES Doñana",
    place: "Sanlúcar de Barrameda, Cádiz",
    description:
      "Titulación de Técnico Superior en Desarrollo de Aplicaciones Web, con formación en desarrollo de aplicaciones, programación, interfaces y bases de datos.",
  },
  {
    number: "02",
    year: "2021",
    category: "BACHILLERATO",
    title: "Ciencias Tecnológicas",
    institution: "IES Francisco Pacheco",
    place: "Sanlúcar de Barrameda, Cádiz",
    description:
      "Formación de Bachillerato orientada a las ciencias y la tecnología.",
  },
];

const details = [
  {
    number: "01",
    label: "UBICACIÓN",
    title: "Sanlúcar de Barrameda",
    subtitle: "Cádiz, Andalucía",
    icon: "location",
  },
  {
    number: "02",
    label: "IDIOMAS",
    title: "Español e inglés",
    subtitle: "Español nativo · Inglés B1",
    icon: "language",
  },
  {
    number: "03",
    label: "PERMISO DE CONDUCIR",
    title: "Clase B",
    subtitle: "Permiso de conducción",
    icon: "car",
  },
  {
    number: "04",
    label: "TITULACIÓN",
    title: "Técnico Superior",
    subtitle: "Desarrollo de Aplicaciones Web",
    icon: "education",
  },
];

const githubUrl = "https://github.com/marcosnchez18";
const linkedinUrl = "https://www.linkedin.com/in/marcosanchezES";

const whatsappUrl =
  "https://wa.me/34622541527?text=" +
  encodeURIComponent(
    "Hola Marco, he visitado tu página web y me gustaría contactar contigo."
  );

const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Sanl%C3%BAcar%20de%20Barrameda%2C%20C%C3%A1diz";
---

<MainLayout
  title="Sobre mí | Marco Sánchez"
  description="Conoce a Marco Sánchez, Técnico Superior en Desarrollo de Aplicaciones Web. Formación, estudios, ubicación y contacto."
>
  <!-- PRESENTACIÓN -->

  <section class="about-hero" aria-labelledby="about-title">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-layout">
      <div class="hero-content">
        <div class="hero-pill">
          <span class="status-dot"></span>
          MI ESPACIO PERSONAL
        </div>

        <p class="hero-eyebrow">UN POCO MÁS SOBRE MÍ</p>

        <h1 id="about-title">
          Hola, soy
          <span>Marco Sánchez<span class="gold-dot">.</span></span>
        </h1>

        <p class="hero-lead">
          Soy Técnico Superior en Desarrollo de Aplicaciones Web,
          natural de Sanlúcar de Barrameda, Cádiz.
        </p>

        <p class="hero-description">
          Me considero una persona curiosa, con ganas de aprender,
          superar nuevos retos y seguir evolucionando.
          Me gusta comprender cómo funcionan las cosas,
          buscar soluciones y mejorar a través de la práctica.
        </p>

        <p class="hero-description">
          Esta web es una forma de presentarme más allá
          de un currículum: un espacio para compartir
          quién soy, mi formación y el camino que voy construyendo.
        </p>

        <div class="hero-tags">
          <span class="hero-tag featured">
            <span class="tag-dot"></span>
            Sanlúcar de Barrameda
          </span>

          <span class="hero-tag">DAW · 2024</span>
          <span class="hero-tag">Aprendizaje continuo</span>
        </div>

        <div class="hero-actions">
          <a href="#formacion" class="button button-primary">
            Mi formación
            <span aria-hidden="true">↘</span>
          </a>

          <a
            href="/cv/cv.pdf"
            class="button button-secondary"
            download="Marco-Sanchez-CV.pdf"
          >
            Descargar mi CV
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <!-- FOTOGRAFÍAS -->

      <div class="photos-area">
        <div class="photos-decoration" aria-hidden="true"></div>

        <div class="photos-grid">
          <figure class="photo-card photo-primary">
            <img
              src="/images/foto1.png"
              alt="Fotografía principal de Marco Sánchez"
              loading="eager"
              fetchpriority="high"
            />
          </figure>

          <figure class="photo-card photo-secondary">
            <img
              src="/images/foto2.jpg"
              alt="Segunda fotografía de Marco Sánchez"
              loading="lazy"
            />
          </figure>
        </div>

        <div class="photos-footer">
          <span class="photos-line"></span>
          <span>MS / SOBRE MÍ</span>
        </div>
      </div>
    </div>
  </section>

  <!-- DATOS RÁPIDOS -->

  <section class="quick-info" aria-label="Información general">
    <div class="container quick-grid">
      <div class="quick-item">
        <span>NOMBRE</span>
        <strong>Marco Sánchez</strong>
      </div>

      <div class="quick-item">
        <span>LOCALIZACIÓN</span>
        <strong>Sanlúcar de Barrameda</strong>
      </div>

      <div class="quick-item">
        <span>FORMACIÓN</span>
        <strong>Desarrollo de Aplicaciones Web</strong>
      </div>

      <div class="quick-item">
        <span>IDIOMAS</span>
        <strong>Español · Inglés B1</strong>
      </div>
    </div>
  </section>

  <!-- FORMACIÓN ACADÉMICA -->

  <section
    class="education-section"
    id="formacion"
    aria-labelledby="education-title"
  >
    <div class="container">
      <div class="section-label">
        <span></span>
        FORMACIÓN ACADÉMICA
      </div>

      <div class="section-heading">
        <h2 id="education-title">
          Mi recorrido
          <span>académico.</span>
        </h2>

        <p>
          Mi formación me ha permitido adquirir una base
          de conocimientos tecnológicos y desarrollar
          una forma de aprender basada en la práctica,
          la constancia y la resolución de problemas.
        </p>
      </div>

      <div class="education-list">
        {studies.map((study) => (
          <article class="education-card">
            <div class="education-number">
              {study.number}
            </div>

            <div class="education-content">
              <div class="education-meta">
                <span class="degree-badge">
                  {study.category}
                </span>

                <span class="education-year">
                  {study.year}
                </span>
              </div>

              <h3>{study.title}</h3>

              <p class="education-institution">
                {study.institution}
              </p>

              <p class="education-description">
                {study.description}
              </p>

              <div class="education-location">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>

                {study.place}
              </div>
            </div>

            <span class="education-arrow" aria-hidden="true">
              ↗
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- INFORMACIÓN PERSONAL -->

  <section
    class="details-section"
    id="datos-personales"
    aria-labelledby="details-title"
  >
    <div class="container">
      <div class="section-label">
        <span></span>
        INFORMACIÓN DE INTERÉS
      </div>

      <div class="section-heading">
        <h2 id="details-title">
          Algunos datos
          <span>sobre mí.</span>
        </h2>

        <p>
          Información básica sobre mi formación,
          mi ubicación y otros aspectos que
          pueden resultar útiles para conocerme.
        </p>
      </div>

      <div class="details-grid">
        {details.map((detail) => (
          <article class="detail-card">
            <div class="detail-top">
              <span class="detail-number">
                {detail.number}
              </span>

              <span class="detail-icon" aria-hidden="true">
                {detail.icon === "location" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                )}

                {detail.icon === "language" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
                  </svg>
                )}

                {detail.icon === "car" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m5 11 2-5h10l2 5M5 17v2m14-2v2M4 11h16v6H4z" />
                    <circle cx="7.5" cy="14.5" r="1" />
                    <circle cx="16.5" cy="14.5" r="1" />
                  </svg>
                )}

                {detail.icon === "education" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m2 9 10-5 10 5-10 5-10-5ZM6 11v6c4 3 8 3 12 0v-6M22 9v7" />
                  </svg>
                )}
              </span>
            </div>

            <span class="detail-label">
              {detail.label}
            </span>

            <h3>{detail.title}</h3>

            <p>{detail.subtitle}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- UBICACIÓN CON MAPA REAL -->

  <section
    class="location-section"
    id="ubicacion"
    aria-labelledby="location-title"
  >
    <div class="container location-layout">
      <div class="location-copy">
        <div class="section-label">
          <span></span>
          DÓNDE ENCONTRARME
        </div>

        <h2 id="location-title">
          Desde Sanlúcar,
          <span>conectado al mundo.</span>
        </h2>

        <p>
          Soy de Sanlúcar de Barrameda,
          una ciudad situada en la provincia de Cádiz,
          en Andalucía.
        </p>

        <p>
          La tecnología permite conectar personas e ideas
          sin importar la distancia.
        </p>

        <a
          class="location-link"
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver Sanlúcar de Barrameda
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- TARJETA DEL MAPA -->

      <div class="location-card">
        <!-- MAPA DE GOOGLE MAPS -->

        <div class="location-map-embed" aria-hidden="true">
          <iframe
            src="https://www.google.com/maps?q=Sanl%C3%BAcar%20de%20Barrameda%2C%20C%C3%A1diz&z=12&output=embed"
            title="Mapa de Sanlúcar de Barrameda"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            tabindex="-1"
          ></iframe>
        </div>

        <!-- FILTRO OSCURO -->

        <div
          class="location-map-overlay"
          aria-hidden="true"
        ></div>

        <!-- CABECERA -->

        <div class="location-card-header">
          <span>UBICACIÓN / ES</span>

          <span class="location-status">
            <span></span>
            ANDALUCÍA
          </span>
        </div>

        <!-- MARCADOR DECORATIVO -->

        <div class="location-pin" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
        </div>

        <!-- NOMBRE DE LA CIUDAD -->

        <div class="location-card-copy">
          <span>MI CIUDAD</span>

          <h3>
            Sanlúcar de Barrameda<span>.</span>
          </h3>

          <p>Cádiz · Andalucía · España</p>
        </div>

        <!-- PIE DE LA TARJETA -->

        <div class="location-card-footer">
          <span>MARCO SÁNCHEZ</span>
          <span>ESPAÑA</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->

  <section
    class="contact-section"
    id="contactar"
    aria-labelledby="contact-title"
  >
    <div class="container contact-inner">
      <div class="section-label centered">
        <span></span>
        ¿HABLAMOS?
        <span></span>
      </div>

      <h2 id="contact-title">
        Siempre hay algo
        <span>por descubrir.</span>
      </h2>

      <p>
        Si quieres conocer más sobre mi perfil,
        contactar conmigo o compartir alguna idea,
        puedes hacerlo a través de los siguientes canales.
      </p>

      <div class="contact-actions">
        <a
          href="/contacto"
          class="button button-primary"
        >
          Contactar conmigo
          <span aria-hidden="true">↗</span>
        </a>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="button button-secondary"
        >
          WhatsApp
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="contact-socials">
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Marco Sánchez"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
          </svg>
          LinkedIn
          <span aria-hidden="true">↗</span>
        </a>

        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub de Marco Sánchez"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297a12 12 0 0 0-3.793 23.386c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.082-.729.082-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.52 11.52 0 0 1 6.008 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297" />
          </svg>
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CHATBOT -->

  <div class="chat-widget" id="marco-chat">
    <section
      class="chat-panel"
      id="chat-panel"
      aria-label="Asistente virtual de Marco"
      aria-hidden="true"
      hidden
    >
      <header class="chat-header">
        <div class="chat-avatar" aria-hidden="true">MS</div>

        <div class="chat-heading">
          <strong>Asistente de Marco</strong>
          <span>
            <span class="online-dot"></span>
            Asistente virtual · Disponible
          </span>
        </div>

        <button
          type="button"
          class="chat-close"
          id="chat-close"
          aria-label="Cerrar chat"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </header>

      <div
        class="chat-messages"
        id="chat-messages"
        role="log"
        aria-live="polite"
        aria-relevant="additions"
      >
        <div class="chat-bubble bot-bubble">
          ¡Hola! 👋 Soy el asistente virtual de Marco.
          Puedes preguntarme por sus estudios,
          ubicación, conocimientos, proyectos
          o formas de contacto.
          ¿En qué puedo ayudarte?
        </div>
      </div>

      <div class="chat-quick-label">
        PREGUNTAS FRECUENTES
      </div>

      <div class="chat-suggestions" id="chat-suggestions">
        <button type="button" data-question="¿Dónde estudió Marco?">
          Estudios
        </button>

        <button type="button" data-question="¿Dónde vive Marco?">
          Ubicación
        </button>

        <button type="button" data-question="¿Qué tecnologías conoce Marco?">
          Tecnologías
        </button>

        <button type="button" data-question="¿Dónde puedo ver los proyectos?">
          Proyectos
        </button>

        <button type="button" data-question="¿Cómo puedo contactar con Marco?">
          Contacto
        </button>

        <button type="button" data-question="¿Haces páginas web por encargo?">
          Crear mi web
        </button>
      </div>

      <form class="chat-form" id="chat-form">
        <label for="chat-input" class="sr-only">
          Escribe tu pregunta
        </label>

        <input
          id="chat-input"
          type="text"
          name="question"
          placeholder="Escribe tu pregunta..."
          maxlength="280"
          autocomplete="off"
          required
        />

        <button type="submit" aria-label="Enviar mensaje">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
          </svg>
        </button>
      </form>

      <p class="chat-disclaimer">
        Respuestas automáticas · Sin IA generativa
      </p>
    </section>

    <button
      type="button"
      class="chat-toggle"
      id="chat-toggle"
      aria-label="Abrir asistente virtual"
      aria-controls="chat-panel"
      aria-expanded="false"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3H13a8.48 8.48 0 0 1 8 8v.5Z" />
      </svg>
      <span>¿Hablamos?</span>
    </button>
  </div>
</MainLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #101216;
  }

  .about-hero,
  .about-hero *,
  .quick-info,
  .quick-info *,
  .education-section,
  .education-section *,
  .details-section,
  .details-section *,
  .location-section,
  .location-section *,
  .contact-section,
  .contact-section *,
  .chat-widget,
  .chat-widget * {
    box-sizing: border-box;
  }

  .container {
    width: min(calc(100% - 96px), 1360px);
    margin-inline: auto;
  }

  /* HERO */

  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 110px 0 120px;
    background: #101216;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg,transparent,#000 55%);
    -webkit-mask-image: linear-gradient(90deg,transparent,#000 55%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    right: -170px;
    top: -120px;
    width: 800px;
    height: 800px;
    background: radial-gradient(
      circle,
      rgba(215,166,92,.10),
      transparent 67%
    );
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(0,.95fr);
    gap: clamp(45px,6vw,95px);
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 15px;
    border: 1px solid rgba(215,166,92,.32);
    border-radius: 999px;
    background: rgba(215,166,92,.06);
    color: #d7a65c;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .status-dot,
  .tag-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #d7a65c;
  }

  .hero-eyebrow {
    margin: 39px 0 18px;
    color: #bca889;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .hero-content h1 {
    margin: 0 0 28px;
    color: #f0f1f3;
    font-family: Inter,Arial,Helvetica,sans-serif;
    font-size: clamp(3.3rem,5.4vw,6.2rem);
    font-weight: 780;
    letter-spacing: -.07em;
    line-height: 1.06;
  }

  .hero-content h1 > span {
    display: block;
    color: #d7a65c;
  }

  .gold-dot {
    color: #f0f1f3;
  }

  .hero-lead {
    max-width: 580px;
    margin: 0 0 18px;
    color: #e0e3e8;
    font-size: clamp(1.05rem,1.5vw,1.2rem);
    line-height: 1.8;
    font-weight: 500;
  }

  .hero-description {
    max-width: 580px;
    margin: 0 0 15px;
    color: #acb3bf;
    font-size: 1rem;
    line-height: 1.85;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border: 1px solid #383d46;
    border-radius: 999px;
    background: #1c2027;
    color: #c4c9d2;
    font-size: .76rem;
  }

  .hero-tag.featured {
    border-color: rgba(215,166,92,.4);
    color: #e0b173;
    background: rgba(215,166,92,.08);
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-height: 54px;
    padding: 14px 22px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: .92rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background .2s ease,
      border-color .2s ease,
      transform .2s ease;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    background: #d7a65c;
    border-color: #d7a65c;
    color: #15171b;
  }

  .button-primary:hover {
    background: #edbe79;
  }

  .button-secondary {
    border-color: #454a54;
    background: rgba(255,255,255,.025);
    color: #e6e8ec;
  }

  .button-secondary:hover {
    border-color: #d7a65c;
    background: rgba(215,166,92,.07);
  }

  /* FOTOGRAFÍAS */

  .photos-area {
    position: relative;
    width: 100%;
    padding: 32px 0 15px;
  }

  .photos-decoration {
    position: absolute;
    inset: 4px 14px 40px;
    border: 1px solid rgba(215,166,92,.13);
    border-radius: 22px;
    transform: rotate(3deg);
    pointer-events: none;
  }

  .photos-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0,1.25fr) minmax(0,.85fr);
    align-items: end;
    gap: 14px;
    width: 100%;
  }

  .photo-card {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid #404550;
    border-radius: 17px;
    background: #222630;
    box-shadow: 0 24px 60px rgba(0,0,0,.35);
  }

  .photo-primary {
    height: 495px;
  }

  .photo-secondary {
    height: 345px;
    margin-bottom: 28px;
  }

  .photo-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .5s ease;
  }

  .photo-card:hover img {
    transform: scale(1.035);
  }

  .photos-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 13px;
    margin-top: 15px;
    color: #929ba7;
    font-family: Consolas,monospace;
    font-size: .69rem;
    letter-spacing: .12em;
  }

  .photos-line {
    width: 33px;
    height: 1px;
    background: #b58a53;
  }

  /* DATOS RÁPIDOS */

  .quick-info {
    border-block: 1px solid #2e323b;
    background: #171b21;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    padding-block: 30px;
  }

  .quick-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 5px 24px;
    border-right: 1px solid #353942;
  }

  .quick-item:first-child {
    padding-left: 0;
  }

  .quick-item:last-child {
    border-right: 0;
  }

  .quick-item > span {
    color: #d7a65c;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .quick-item strong {
    color: #e5e8ed;
    font-size: .88rem;
    font-weight: 600;
    line-height: 1.45;
  }

  /* TÍTULOS DE SECCIÓN */

  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    color: #d7a65c;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .section-label > span {
    width: 28px;
    height: 1px;
    background: #d7a65c;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: end;
    gap: 40px;
  }

  .section-heading h2,
  .location-copy h2,
  .contact-section h2 {
    margin: 0;
    color: #f0f1f3;
    font-family: Inter,Arial,Helvetica,sans-serif;
    font-size: clamp(2.7rem,4.4vw,4.8rem);
    font-weight: 750;
    letter-spacing: -.058em;
    line-height: 1.13;
  }

  .section-heading h2 span,
  .location-copy h2 span,
  .contact-section h2 span {
    display: block;
    color: #d7a65c;
  }

  .section-heading > p {
    max-width: 490px;
    margin: 0 0 8px;
    color: #adb4bf;
    font-size: .97rem;
    line-height: 1.85;
  }

  /* FORMACIÓN */

  .education-section {
    padding: 120px 0;
    background: #101216;
    scroll-margin-top: 100px;
  }

  .education-list {
    display: grid;
    gap: 17px;
    margin-top: 55px;
  }

  .education-card {
    display: grid;
    grid-template-columns: 70px minmax(0,1fr) 30px;
    gap: 24px;
    padding: 34px;
    border: 1px solid #343944;
    border-radius: 15px;
    background: #191d24;
    transition:
      border-color .25s ease,
      transform .25s ease;
  }

  .education-card:hover {
    transform: translateY(-4px);
    border-color: rgba(215,166,92,.6);
  }

  .education-number {
    color: #d7a65c;
    font-family: Consolas,monospace;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .education-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .degree-badge {
    padding: 7px 11px;
    border: 1px solid rgba(215,166,92,.3);
    border-radius: 999px;
    background: rgba(215,166,92,.07);
    color: #d7a65c;
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .education-year {
    color: #969ea9;
    font-family: Consolas,monospace;
    font-size: .77rem;
  }

  .education-content h3 {
    margin: 0 0 10px;
    color: #f0f1f3;
    font-size: clamp(1.3rem,2vw,1.8rem);
    font-weight: 650;
    letter-spacing: -.03em;
  }

  .education-institution {
    margin: 0 0 16px;
    color: #e0b173;
    font-size: .95rem;
    font-weight: 650;
  }

  .education-description {
    max-width: 750px;
    margin: 0 0 20px;
    color: #abb2be;
    font-size: .92rem;
    line-height: 1.8;
  }

  .education-location {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #959da9;
    font-size: .78rem;
  }

  .education-location svg {
    width: 16px;
    height: 16px;
    color: #d7a65c;
  }

  .education-arrow {
    color: #d7a65c;
    font-size: 1.5rem;
  }

  /* DATOS PERSONALES */

  .details-section {
    padding: 120px 0;
    border-block: 1px solid #30343b;
    background: #171b21;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 17px;
    margin-top: 55px;
  }

  .detail-card {
    display: flex;
    flex-direction: column;
    min-height: 252px;
    padding: 24px;
    border: 1px solid #343944;
    border-radius: 14px;
    background: #1e222a;
    transition:
      transform .2s ease,
      border-color .2s ease;
  }

  .detail-card:hover {
    transform: translateY(-5px);
    border-color: rgba(215,166,92,.6);
  }

  .detail-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: auto;
  }

  .detail-number {
    color: #828a97;
    font-family: Consolas,monospace;
    font-size: .72rem;
  }

  .detail-icon {
    display: grid;
    place-items: center;
    width: 47px;
    height: 47px;
    border: 1px solid rgba(215,166,92,.3);
    border-radius: 10px;
    background: rgba(215,166,92,.08);
    color: #d7a65c;
  }

  .detail-icon svg {
    width: 23px;
    height: 23px;
  }

  .detail-label {
    display: block;
    margin: 28px 0 10px;
    color: #d7a65c;
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .detail-card h3 {
    margin: 0 0 6px;
    color: #edf0f3;
    font-size: 1.1rem;
    font-weight: 650;
    letter-spacing: -.025em;
  }

  .detail-card p {
    margin: 0;
    color: #a8b0bc;
    font-size: .82rem;
    line-height: 1.6;
  }

  /* UBICACIÓN */

  .location-section {
    padding: 120px 0;
    background: #101216;
    scroll-margin-top: 100px;
  }

  .location-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(40px,7vw,110px);
  }

  .location-copy h2 {
    margin-bottom: 25px;
  }

  .location-copy > p {
    max-width: 520px;
    margin: 0 0 17px;
    color: #abb2be;
    font-size: .98rem;
    line-height: 1.85;
  }

  .location-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    margin-top: 16px;
    padding-bottom: 9px;
    border-bottom: 1px solid #d7a65c;
    color: #e0b173;
    font-size: .92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .location-link:hover {
    gap: 20px;
  }

  /* ========================================= */
  /*      TARJETA CON MAPA DE FONDO            */
  /* ========================================= */

  .location-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 420px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid rgba(215,166,92,.38);
    border-radius: 18px;
    background: #1b1f26;
    box-shadow: 0 22px 60px rgba(0,0,0,.32);
  }

  /* MAPA REAL */

  .location-map-embed {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .location-map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    filter:
      grayscale(1)
      saturate(0)
      contrast(1.08)
      brightness(.72)
      sepia(.1);
    opacity: .8;
    transform: scale(1.035);
  }

  /* OSCURECIMIENTO PARA LEGIBILIDAD */

  .location-map-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(12,15,20,.28) 0%,
        rgba(12,15,20,.42) 35%,
        rgba(12,15,20,.64) 65%,
        rgba(12,15,20,.94) 100%
      ),
      linear-gradient(
        90deg,
        rgba(215,166,92,.04),
        transparent 65%
      );
    pointer-events: none;
  }

  /* ELEMENTOS POR ENCIMA DEL MAPA */

  .location-card-header,
  .location-card-copy,
  .location-card-footer {
    position: relative;
    z-index: 2;
  }

  .location-card-header,
  .location-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .location-card-header > span:first-child,
  .location-card-footer span {
    color: #c1c7d0;
    font-family: Consolas,monospace;
    font-size: .66rem;
    letter-spacing: .1em;
    text-shadow: 0 2px 8px rgba(0,0,0,.6);
  }

  .location-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #e0b173;
    font-size: .65rem;
    font-weight: 700;
  }

  .location-status span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d7a65c;
  }

  /* PIN DECORATIVO */

  .location-pin {
    position: absolute;
    top: 39%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border: 1px solid rgba(215,166,92,.4);
    border-radius: 50%;
    background: rgba(24,28,35,.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transform: translate(-50%,-50%);
  }

  .location-pin::before {
    content: "";
    position: absolute;
    inset: -13px;
    border: 1px solid rgba(215,166,92,.14);
    border-radius: 50%;
    animation: location-pulse 3s ease-in-out infinite;
  }

  @keyframes location-pulse {
    0%, 100% {
      opacity: .4;
      transform: scale(.95);
    }

    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  .location-pin svg {
    width: 42px;
    height: 42px;
    color: #e0b173;
  }

  /* TEXTO SUPERPUESTO */

  .location-card-copy {
    margin-top: auto;
    padding-top: 155px;
    padding-bottom: 20px;
  }

  .location-card-copy > span {
    color: #e0b173;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .location-card-copy h3 {
    margin: 11px 0 8px;
    color: #f0f1f3;
    font-size: clamp(1.5rem,2.4vw,2.2rem);
    line-height: 1.2;
    letter-spacing: -.04em;
    text-shadow: 0 2px 12px rgba(0,0,0,.7);
  }

  .location-card-copy h3 span {
    color: #d7a65c;
  }

  .location-card-copy p {
    margin: 0;
    color: #d3d7dd;
    font-size: .84rem;
    text-shadow: 0 2px 8px rgba(0,0,0,.7);
  }

  .location-card-footer {
    padding-top: 17px;
    border-top: 1px solid rgba(215,166,92,.3);
  }

  /* CONTACTO */

  .contact-section {
    padding: 115px 0 130px;
    border-top: 1px solid #2e323b;
    background: #171b21;
    text-align: center;
  }

  .contact-inner {
    max-width: 840px;
  }

  .section-label.centered {
    justify-content: center;
  }

  .contact-section h2 {
    margin-bottom: 24px;
  }

  .contact-section > .container > p {
    max-width: 620px;
    margin: 0 auto;
    color: #acb4be;
    font-size: .98rem;
    line-height: 1.85;
  }

  .contact-actions {
    justify-content: center;
  }

  .contact-socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 42px;
  }

  .contact-socials a {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 43px;
    padding: 11px 16px;
    border: 1px solid #3d424c;
    border-radius: 10px;
    background: #1d2229;
    color: #d1d5dc;
    font-size: .86rem;
    font-weight: 650;
    text-decoration: none;
  }

  .contact-socials a:hover {
    border-color: #d7a65c;
    color: #e0b173;
  }

  .contact-socials svg {
    width: 19px;
    height: 19px;
  }

  /* CHATBOT */

  .chat-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    font-family: Inter,Arial,Helvetica,sans-serif;
  }

  .chat-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 53px;
    padding: 13px 20px;
    border: 1px solid #e3b976;
    border-radius: 999px;
    background: #d7a65c;
    color: #111318;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    box-shadow: 0 10px 32px rgba(0,0,0,.35);
  }

  .chat-toggle:hover {
    background: #edbe79;
    transform: translateY(-2px);
  }

  .chat-toggle svg {
    width: 21px;
    height: 21px;
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    display: flex;
    flex-direction: column;
    width: min(385px,calc(100vw - 28px));
    height: min(540px,calc(100dvh - 115px));
    overflow: hidden;
    border: 1px solid #3a3f47;
    border-radius: 17px;
    background: #171a20;
    color: #e8eaee;
    box-shadow: 0 25px 75px rgba(0,0,0,.55);
  }

  .chat-panel[hidden] {
    display: none;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 15px;
    border-bottom: 1px solid #353941;
    background: #20242b;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 41px;
    height: 41px;
    flex-shrink: 0;
    border: 1px solid rgba(215,166,92,.6);
    border-radius: 12px;
    background: rgba(215,166,92,.08);
    color: #d7a65c;
    font-size: .9rem;
    font-weight: 800;
  }

  .chat-heading {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
  }

  .chat-heading strong {
    color: #f0f1f3;
    font-size: 13px;
  }

  .chat-heading > span {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #a8aeb8;
    font-size: 10px;
  }

  .online-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8ab99c;
  }

  .chat-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #aeb4be;
    cursor: pointer;
  }

  .chat-close:hover {
    background: #30353d;
  }

  .chat-close svg {
    width: 19px;
    height: 19px;
  }

  .chat-messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    padding: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  :global(#marco-chat .chat-bubble) {
    width: fit-content;
    max-width: 91%;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(#marco-chat .bot-bubble) {
    align-self: flex-start;
    border: 1px solid #383d47;
    border-top-left-radius: 4px;
    background: #292e37;
    color: #e8eaee;
  }

  :global(#marco-chat .user-bubble) {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: #d7a65c;
    color: #13151a;
  }

  :global(#marco-chat .chat-page-link),
  :global(#marco-chat .chat-whatsapp) {
    display: inline-flex;
    align-self: flex-start;
    max-width: 100%;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 11.5px;
    font-weight: 700;
    text-decoration: none;
  }

  :global(#marco-chat .chat-page-link) {
    border: 1px solid rgba(215,166,92,.4);
    background: rgba(215,166,92,.08);
    color: #e0b173;
  }

  :global(#marco-chat .chat-whatsapp) {
    border: 1px solid #d7a65c;
    background: #d7a65c;
    color: #141619;
  }

  .chat-quick-label {
    padding: 10px 15px 7px;
    border-top: 1px solid #30343c;
    background: #1c2027;
    color: #868d99;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 4px 14px 12px;
    background: #1c2027;
  }

  .chat-suggestions button {
    min-height: 30px;
    padding: 7px 10px;
    border: 1px solid #414650;
    border-radius: 999px;
    background: #252a32;
    color: #d8ba8c;
    font-size: 10px;
    cursor: pointer;
  }

  .chat-suggestions button:hover {
    border-color: #d7a65c;
    color: #f0c58c;
