      else if (webTopic && has(/\b(incluye|incluir|incluyes|servicios incluidos|que lleva|que ofreces|caracteristicas|funcionalidades|diseno personalizado|diseno a medida|adaptacion|movil|moviles|formulario|contacto web|seo basico|posicionamiento|dominio|hosting|mantenimiento|actualizacion)\b/)) {
