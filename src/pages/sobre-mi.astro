      else if (has(/\b(internacional|internacionales|extranjero|extranjera|otro pais|otros paises|fuera de espana|desde mexico|desde argentina|desde colombia|desde chile|desde peru|trabajas online|trabajo remoto|a distancia|remoto|desde cualquier pais)\b/)) {
