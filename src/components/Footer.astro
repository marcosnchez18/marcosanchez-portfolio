
---
const year = new Date().getFullYear();

const instagramUrl = "https://www.instagram.com/marcosnchez18/";
const tiktokUrl = "https://www.tiktok.com/@marcosnchez18";
---

<footer class="site-footer">
  <div class="footer-container">

    <!-- LOGO + SEPARADOR + REDES -->
    <div class="footer-main">

      <a
        href="/"
        class="footer-logo"
        aria-label="Marco Sánchez - Inicio"
      >
        <img
          src="/images/logo-header.png"
          alt="Marco Sánchez"
          width="420"
          height="100"
          loading="lazy"
        />
      </a>

      <!-- BARRA VERTICAL DORADA -->
      <span class="footer-separator" aria-hidden="true"></span>

      <!-- REDES SOCIALES -->
      <nav class="footer-socials" aria-label="Redes sociales">

        <!-- INSTAGRAM -->
        <a
          href={instagramUrl}
          class="social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Marco Sánchez"
          title="Instagram"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle
              cx="17.5"
              cy="6.5"
              r="1"
              fill="currentColor"
              stroke="none"
            />
          </svg>
        </a>

        <!-- TIKTOK -->
        <a
          href={tiktokUrl}
          class="social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok de Marco Sánchez"
          title="TikTok"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M16.8 2h-3.1v13.3a3.25 3.25 0 1 1-2.8-3.22V8.93a6.37 6.37 0 1 0 5.9 6.35V8.57a9.08 9.08 0 0 0 5.2 1.65V7.09A5.97 5.97 0 0 1 16.8 2Z"
            />
          </svg>
        </a>

      </nav>
    </div>

    <!-- COPYRIGHT -->
    <div class="footer-bottom">
      <p>
        © {year} · Diseñado y desarrollado por Marco Sánchez.
        Todos los derechos reservados.
      </p>
    </div>

  </div>
</footer>

<style>
  /* FOOTER GENERAL */

  .site-footer {
    background: #100d0b;
    border-top: 1px solid rgba(215, 166, 92, 0.18);
    padding: 30px 24px 20px;
  }

  .footer-container {
    width: min(100%, 1350px);
    margin-inline: auto;
  }

  /* LOGO Y REDES JUNTOS */

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  /* LOGO */

  .footer-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .footer-logo img {
    display: block;
    width: 220px;
    max-width: 100%;
    height: auto;
    transition: opacity 250ms ease;
  }

  .footer-logo:hover img {
    opacity: 0.8;
  }

  /* BARRA VERTICAL */

  .footer-separator {
    width: 1px;
    height: 34px;
    flex-shrink: 0;
    background: rgba(215, 166, 92, 0.55);
  }

  /* REDES SOCIALES */

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    color: #d7a65c;
    background: transparent;

    border: 1px solid rgba(215, 166, 92, 0.25);
    border-radius: 10px;

    text-decoration: none;

    transition:
      color 250ms ease,
      background 250ms ease,
      border-color 250ms ease,
      transform 250ms ease;
  }

  .social-link svg {
    width: 21px;
    height: 21px;
  }

  .social-link:hover {
    color: #f0c58c;
    background: rgba(224, 177, 115, 0.08);
    border-color: #d7a65c;
    transform: translateY(-2px);
  }

  .social-link:focus-visible,
  .footer-logo:focus-visible {
    outline: 2px solid #f0c58c;
    outline-offset: 4px;
  }

  /* COPYRIGHT */

  .footer-bottom {
    margin-top: 20px;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: #a99a8c;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  /* MÓVILES */

  @media (max-width: 600px) {
    .site-footer {
      padding: 26px 14px 20px;
    }

    .footer-main {
      gap: 12px;
    }

    .footer-logo img {
      width: clamp(125px, 38vw, 175px);
    }

    .footer-separator {
      height: 28px;
    }

    .footer-socials {
      gap: 6px;
    }

    .social-link {
      width: 36px;
      height: 36px;
      border-radius: 8px;
    }

    .social-link svg {
      width: 19px;
      height: 19px;
    }

    .footer-bottom {
      margin-top: 18px;
    }

    .footer-bottom p {
      max-width: 320px;
      margin-inline: auto;
      font-size: 0.72rem;
    }
  }

  /* PANTALLAS MUY PEQUEÑAS */

  @media (max-width: 350px) {
    .footer-main {
      gap: 8px;
    }

    .footer-logo img {
      width: 120px;
    }

    .social-link {
      width: 34px;
      height: 34px;
    }
  }

  /* ACCESIBILIDAD */

  @media (prefers-reduced-motion: reduce) {
    .social-link,
    .footer-logo img {
      transition: none;
    }

    .social-link:hover {
      transform: none;
    }
  }
</style>
