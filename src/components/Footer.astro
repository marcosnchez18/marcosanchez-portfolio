
---
const year = new Date().getFullYear();

const socialLinks = [
  {
    name: "GitHub",
    href: "https://github.com/marcosnchez18",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/marcosanchezES",
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/marcosnchez18/",
  },
  {
    name: "TikTok",
    href: "https://www.tiktok.com/@marcosnchez18",
  },
];

const navigation = [
  { name: "Inicio", href: "/" },
  { name: "Sobre mí", href: "/sobre-mi" },
  { name: "Desarrollo", href: "/proyectos" },
  { name: "Otras experiencias", href: "/otras-experiencias" },
  { name: "Arte", href: "/arte" },
  { name: "Contacto", href: "/contacto" },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-identity">
        <a
          href="/"
          class="footer-brand"
          aria-label="Marco Sánchez - Inicio"
        >
          <span class="footer-logo" aria-hidden="true">
            MS<span>.</span>
          </span>

          <span class="footer-brand-text">
            <strong>Marco Sánchez</strong>
            <small>DESARROLLADOR WEB</small>
          </span>
        </a>

        <p>
          Un espacio personal donde comparto mi
          formación, mis proyectos y las experiencias
          que forman parte de mi recorrido.
        </p>

        <div class="footer-location">
          <span class="location-dot"></span>
          Sanlúcar de Barrameda · Cádiz · España
        </div>
      </div>

      <div class="footer-links-column">
        <h2>EXPLORAR</h2>

        <nav aria-label="Navegación del pie de página">
          {navigation.map((item) => (
            <a href={item.href}>
              {item.name}
            </a>
          ))}
        </nav>
      </div>

      <div class="footer-links-column">
        <h2>ENCUÉNTRAME</h2>

        <div class="social-links">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{link.name}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>

      <div class="footer-contact">
        <h2>¿HABLAMOS?</h2>

        <p>
          Si tienes una propuesta, una idea o
          simplemente quieres contactar conmigo,
          estaré encantado de escucharte.
        </p>

        <a href="/contacto" class="footer-contact-button">
          Contactar conmigo
          <span aria-hidden="true">↗</span>
        </a>

        
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <span>© {year} Desarrollado por Marco Sánchez.</span>

      <span class="footer-motto">
        Desarrollando y aprendiendo cada día.
      </span>

      <a href="#top" class="back-to-top">
        Volver arriba
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer,
  .site-footer * {
    box-sizing: border-box;
  }

  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid #303640;
    background: #101216;
    font-family: Inter,Arial,Helvetica,sans-serif;
  }

  .site-footer::before {
    content: "";
    position: absolute;
    top: -240px;
    right: -150px;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(215,166,92,.065),
      transparent 66%
    );
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 96px),1360px);
    margin-inline: auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns:
      minmax(0,1.4fr)
      minmax(0,.7fr)
      minmax(0,.7fr)
      minmax(0,1fr);
    gap: clamp(28px,4vw,65px);
    padding: 82px 0 75px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .footer-logo {
    display: grid;
    place-items: center;
    width: 49px;
    height: 49px;
    border: 1px solid rgba(215,166,92,.5);
    border-radius: 12px;
    background: linear-gradient(
      145deg,
      #252a31,
      #191d23
    );
    color: #f1f3f6;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -.07em;
  }

  .footer-logo span {
    color: #d7a65c;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .footer-brand-text strong {
    color: #f0f1f3;
    font-size: 1rem;
    letter-spacing: -.025em;
  }

  .footer-brand-text small {
    color: #d7a65c;
    font-size: .54rem;
    font-weight: 750;
    letter-spacing: .15em;
  }

  .footer-identity > p {
    max-width: 340px;
    margin: 24px 0 20px;
    color: #aeb6c0;
    font-size: .87rem;
    line-height: 1.9;
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #9ca5b1;
    font-size: .75rem;
  }

  .location-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #d7a65c;
  }

  .footer-links-column h2,
  .footer-contact h2 {
    margin: 8px 0 27px;
    color: #d7a65c;
    font-size: .69rem;
    font-weight: 750;
    letter-spacing: .15em;
  }

  .footer-links-column nav,
  .social-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-links-column nav a {
    color: #b0b8c4;
    font-size: .86rem;
    text-decoration: none;
    transition:
      color .2s ease,
      transform .2s ease;
  }

  .footer-links-column nav a:hover {
    color: #e0b173;
    transform: translateX(3px);
  }

  .social-links {
    align-items: stretch;
    gap: 15px;
  }

  .social-links a {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #b0b8c4;
    font-size: .86rem;
    text-decoration: none;
    transition: color .2s ease;
  }

  .social-links a:hover {
    color: #e0b173;
  }

  .social-links a span:last-child {
    color: #d7a65c;
  }

  .footer-contact p {
    margin: 0 0 22px;
    color: #adb5c0;
    font-size: .85rem;
    line-height: 1.85;
  }

  .footer-contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    min-height: 45px;
    padding: 11px 15px;
    border: 1px solid #d7a65c;
    border-radius: 9px;
    background: #d7a65c;
    color: #15171b;
    font-size: .82rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      background .2s ease,
      transform .2s ease;
  }

  .footer-contact-button:hover {
    background: #edbe79;
    transform: translateY(-2px);
  }

  .footer-cv-link {
    display: flex;
    align-items: center;
    gap: 11px;
    width: fit-content;
    margin-top: 19px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(215,166,92,.6);
    color: #e0b173;
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .footer-divider {
    height: 1px;
    background: #31363e;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 27px 0;
  }

  .footer-bottom > span,
  .back-to-top {
    color: #929ba8;
    font-size: .75rem;
    line-height: 1.6;
  }

  .footer-motto {
    color: #bda27e !important;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .back-to-top:hover {
    color: #e0b173;
  }

  .back-to-top span {
    color: #d7a65c;
    font-size: 1.1rem;
  }

  .site-footer a:focus-visible {
    outline: 2px solid #edbe79;
    outline-offset: 4px;
  }

  @media (max-width: 1150px) {
    .footer-container {
      width: min(calc(100% - 56px),1000px);
    }

    .footer-main {
      grid-template-columns: 1.4fr 1fr;
      gap: 50px 65px;
    }
  }

  @media (max-width: 650px) {
    .footer-container {
      width: calc(100% - 36px);
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 42px 22px;
      padding: 65px 0 50px;
    }

    .footer-identity,
    .footer-contact {
      grid-column: 1 / -1;
    }

    .footer-identity > p {
      max-width: 100%;
    }

    .footer-links-column h2,
    .footer-contact h2 {
      margin-bottom: 22px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 25px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links-column nav a,
    .social-links a,
    .footer-contact-button {
      transition: none;
    }
  }
</style>

<script>
  // Permite que "Volver arriba" funcione
  // aunque no exista un elemento con id="top".

  function initFooter(): void {
    const footer = document.querySelector<HTMLElement>(
      ".site-footer"
    );

    if (!footer || footer.dataset.initialized === "true") {
      return;
    }

    footer.dataset.initialized = "true";

    const topLink = footer.querySelector<HTMLAnchorElement>(
      ".back-to-top"
    );

    topLink?.addEventListener("click", (event) => {
      event.preventDefault();

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? "instant" : "smooth",
      });
    });
  }

  document.addEventListener(
    "astro:page-load",
    initFooter
  );

  document.addEventListener(
    "DOMContentLoaded",
    initFooter
  );

  initFooter();
</script>
