
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marco Sánchez | Desarrollador Web",
  description = "Web personal de Marco Sánchez, desarrollador web y artista."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />

    <title>{title}</title>

    <!-- FAVICON: LOGO MS -->
    <link
      rel="icon"
      type="image/png"
      href="/images/web.png?v=2"
    />

    <link
      rel="shortcut icon"
      type="image/png"
      href="/images/web.png?v=2"
    />

    <link
      rel="apple-touch-icon"
      href="/images/web.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
