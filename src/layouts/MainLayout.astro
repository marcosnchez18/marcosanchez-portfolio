
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marco Sánchez | Desarrollo Web y Arte",
  description = "Portfolio de Marco Sánchez, desarrollador web y artista. Proyectos de programación, diseño y arte."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Color del navegador -->
    <meta name="theme-color" content="#100d0b" />

    <!-- Favicon personalizado MS dorado -->
    <link
      rel="icon"
      type="image/png"
      href="/images/logo.png"
    />
  </head>

  <body class="min-h-screen bg-[#100d0b] text-[#e9ddd1] antialiased">
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
